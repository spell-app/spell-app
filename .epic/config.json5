// Where this repo keeps its epic things (epic `epic-eject` P4):  its folders, branch and windows.
// - Read by spell-epic's `EpicConfig` (spell-epic/src/config/EpicConfig.ts).
// - Folders are relative to the MAIN checkout:
//   every worktree reads the main checkout's copy of this file.
// - A key left out takes its default:  these are the defaults.
// - `epic config [key]` prints what's in force (`--json`:  all of it).
// - The folders moved on 2026-10-18 (epic `epic-eject` P8, the switch to spell-epic):  content folder renamed,
//   new worktrees beside the repo, their session folders linked, their packages installed first.
{
  // The shared content repo:  epics, guides, sagas, pages, brand, the logs (not the templates:  spell-epic's).
  // - Found here, by its own path:  the page server serves it at `/` after the checkout (epic `epic-eject` P12),
  //   and the tools read it from here, with no link at the checkout's root.
  // - Each turn's end commits it.
  // - Renamed from spell-app-dev by `epic shared rename spell-app.epics`, which left a spell-app-dev link behind.
  // - Moved into the top repo `spell` as `spell.epics`, beside this repo (epic `repo-split` P8 / P9).
  "contentFolder": "../spell.epics",

  // The branch worktrees start from and merge into.
  "baseBranch": "main",

  // Where NEW worktrees go:  one folder each, `<worktreesFolder>/<name>`, on branch `<name>`.
  // - spell-app is a child repo of the kit (`~/www/spell`, whose `repos.json5` names it), so the KIT's
  //   `worktreesFolder` wins (`EpicConfig.worktreesFolder`):  an epic's worktree is `~/www/spell.worktrees/<epic>/`,
  //   holding a worktree of every child repo, spell-app's at `<epic>/spell-app` (epic `repo-split` P12).
  // - This one is read only for the worktrees from before the kit:  the same folder, so it names no other place.
  "worktreesFolder": "../../spell.worktrees",

  // What makes a new worktree ready to run, from its root (`/isolate`, `/epic`).
  "installCommand": "yarn install",
  // The worktree hook runs it BEFORE the window opens (I2), within "installTimeout" seconds (600 left out).
  "installOnCreate": true,

  // The VS Code windows (`epic window`).
  "windows": {
    // The window a worktree's window is opened from, when the session's own window isn't a package's:
    // `<windowsFolder>/<default>.code-workspace`, the whole repo's.
    "default": "spell-app",
    // The repo root's folder name in every window.
    "repoName": "spell-app",
    // The content repo's folder name in every window.
    "contentName": "spell.epics"
    // And (P8):  "worktreeOnly": true gives EVERY worktree a window of just two folders,
    // its own and the content folder.
    // - A worktree beside the repo gets that window anyway.
  },

  // Whether the worktree hook links each NEW worktree's saved-session folder to the main checkout's,
  // so every window's Claude panel lists every session.
  "linkSessionFolders": true,

  // The content folder's folders every checkout links in at its root (`epic shared link`):  none (epic `repo-split`
  // P12).
  // - `agents/` (WWOD and the three logs) is the KIT's since P9:  every install links it in at each child repo's root
  //   (the kit's `postinstall`, `tools/repos.ts links`), so a link into the content folder here would be the wrong one.
  // - The rest (epics, guides, pages, brand, ui, goals, sagas) are found in the content folder itself.
  "sharedFolders": [],

  // The epic engine:  the spell-epic checkout, which every checkout links in at its root as `spell-epic`
  // (`epic shared link`, and the worktree hook through it;  only where `.gitignore` ignores `spell-epic`).
  // - Since epic `repo-split` P8 it's beside this repo in the top repo `spell`:  the page server's settings name its
  //   route modules and folders there (`../spell-epic/...`, the root `package.json`'s `"pageServer"`), not through
  //   the link.
  // - `""`:  no link.
  "engineFolder": "../spell-epic",

  // The VS Code window files (`epic window`), each machine's own (epic `epic-eject` P13):
  // package windows here, worktree windows in its `ongoing/`;  git-ignored in the content repo.
  // - Before P13:  `workspaces/` in this repo, tracked and marked `skip-worktree`;
  //   `epic window move` carried them over once, each folder path rewritten for the new place.
  "windowsFolder": "../spell.epics/windows",

  // The app, the editor:  what the docs' top bar's App tab opens on the epic server (spell-epic's `RepoApp`,
  // epic `epic-engine` I49), at `/editor/` as on this repo's page server (spaces' `appRoutes.ts`).
  // - Up:  redirected to, at the URL its record holds:  the page server writes `.spell-server.editor.json` once the
  //   editor answers (spaces' `EditorServer`).
  // - Not up:  the epic server runs "start" from the main checkout, in the background (its output in
  //   `~/.spell-epic/app-spell-app.log`):  the page server, which starts the editor with it;  a "Starting ..." page
  //   goes to the editor once it answers.
  "app": {
    "path": "/editor/",
    "urlFile": ".spell-server.editor.json",
    "start": "node ../bin/spell.mjs server start"
  }
}
