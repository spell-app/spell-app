---
/**
 * Behaviour reference for one component family, generated at BUILD time from its vocabulary module
 * (`src/components/<family>/<family>.vocabulary.en.ts`) -- the same file the element reads, so the docs can't drift.
 * - One block per tag the module exports (`ui-button`, `ui-buttons`, `ui-or` ...), each with the tables that apply:
 *   attributes, JS properties (rich `json` attributes), events, slots, `::part`s, custom states and text keys.
 *   Empty tables are left out.
 * - `tags` narrows/reorders the blocks;  default is every vocabulary in the module, in export order.
 * - Value sets (`hues`, `sizes` ...) are resolved through `ValueSets`, so a theme's extra hues show up.
 * - Sibling of `CssTokens.astro` (custom properties) and `ApiTable.astro` (manifest, when it exists).
 */
import { ValueSets } from "$/ui/vocabulary"
import type { AttributeSpec, ComponentVocabulary } from "$/ui/vocabulary"

import { slug } from "../lib/text"

type Props = {
  /** family folder name, e.g. `button` (the module is `$/ui/components/button/button.vocabulary.en.ts`) */
  family: string
  /** only these tags, in this order, e.g. `["ui-button"]` */
  tags?: string[]
}

const { family, tags } = Astro.props

const MODULES = import.meta.glob<Record<string, unknown>>("$/ui/components/*/*.vocabulary.en.ts", { eager: true })
const module = Object.entries(MODULES).find(([path]) => path.endsWith(`/${family}/${family}.vocabulary.en.ts`))?.[1]
if (!module) throw new Error(`VocabularyTable: no vocabulary module for family "${family}"`)

let vocabularies = Object.values(module).filter(isVocabulary)
if (tags) vocabularies = tags.map((tag) => vocabularies.find((v) => v.tag === tag)!).filter(Boolean)

/** How each `AttributeKind` reads to an author. */
const KIND_LABELS: Record<string, string> = {
  keyOnly: "boolean",
  valueAndKey: "value",
  keyOrValueAndKey: "boolean or value",
  width: "width",
  multiple: "list",
  textAlign: "value",
  verticalAlign: "value",
  size: "size",
  color: "color",
  valueOnly: "value",
  icon: "icon name",
  boolean: "boolean",
  enum: "enum",
  string: "string",
  number: "number",
  json: "property only"
}

/** Kinds of the fixed vocabulary sets that read best as a NAME rather than a list. */
const WIDE_SETS = new Set(["hues", "widths", "devices", "booleans"])

/** Vocabulary objects have a `tag` and an `attributes` array;  filters out `PART_VOCABULARIES` and helpers. */
function isVocabulary(value: unknown): value is ComponentVocabulary {
  return typeof value === "object" && value !== null && "tag" in value && "attributes" in value
}

/** The values of `attribute` as display strings:  short lists spelled out, big shared sets by name. */
function valuesOf(attribute: AttributeSpec): { text: string; title?: string } {
  const kind = attribute.kind
  const values = attribute.values ?? (kind === "color" ? "hues" : kind === "size" ? "sizes" : undefined)
  if (kind === "textAlign" && !attribute.values) return { text: "alignments" }
  if (kind === "verticalAlign" && !attribute.values) return { text: "verticalAlignments" }
  if (values === undefined) return { text: kind === "keyOnly" ? "" : "" }
  if (typeof values === "string") {
    const list = (ValueSets as unknown as Record<string, readonly string[]>)[values] ?? []
    return WIDE_SETS.has(values) || list.length > 10
      ? { text: values, title: list.join(", ") }
      : { text: list.join(" | ") }
  }
  return { text: values.join(" | ") }
}

/** JS property name for an attribute. */
function propertyOf(attribute: AttributeSpec): string {
  return attribute.property ?? attribute.name.replace(/-([a-z])/g, (_, c: string) => c.toUpperCase())
}

/** Default shown for an attribute: its declared default, `false` for booleans, else a dash. */
function defaultOf(attribute: AttributeSpec): string {
  if (attribute.default !== undefined && attribute.default !== null) return String(attribute.default)
  return attribute.kind === "keyOnly" ? "false" : ""
}

/** Render backticked spans of a description as `<code>`. */
function codeify(text: string): string {
  const escaped = text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
  return escaped.replace(/`([^`]+)`/g, "<code>$1</code>")
}
---

<div class="ui-stack ui-gap-xl">
  {
    vocabularies.map((v) => {
      const attributes = v.attributes.filter((a) => a.kind !== "json")
      const properties = v.attributes.filter((a) => a.kind === "json")
      return (
        <div class="ui-stack ui-gap-l">
          <div class="ui-stack ui-gap-2xs">
            <h3 id={slug(v.tag)} class="site-example-title site-anchored">
              <code>{`<${v.tag}>`}</code>
              <a class="site-anchor" href={`#${slug(v.tag)}`} aria-label={`Link to ${v.tag}`}>
                #
              </a>
            </h3>
            {v.description && <p class="ui-muted ui-m-0">{v.description}</p>}
          </div>

          {attributes.length > 0 && (
            <div class="site-table-wrap">
              <table class="site-table">
                <caption class="ui-caption ui-text-start">Attributes</caption>
                <thead>
                  <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Kind</th>
                    <th scope="col">Values</th>
                    <th scope="col">Default</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {attributes.map((a) => {
                    const values = valuesOf(a)
                    return (
                      <tr>
                        <th scope="row">
                          <code>{a.name}</code>
                          {a.aliases?.length ? <div class="ui-caption">alias {a.aliases.join(", ")}</div> : null}
                        </th>
                        <td>{KIND_LABELS[a.kind] ?? a.kind}</td>
                        <td>{values.text && <code title={values.title}>{values.text}</code>}</td>
                        <td>{defaultOf(a) && <code>{defaultOf(a)}</code>}</td>
                        <td set:html={codeify(a.description)} />
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>
          )}

          {properties.length > 0 && (
            <div class="site-table-wrap">
              <table class="site-table">
                <caption class="ui-caption ui-text-start">JS properties (rich data)</caption>
                <thead>
                  <tr>
                    <th scope="col">Property</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {properties.map((a) => (
                    <tr>
                      <th scope="row">
                        <code>{propertyOf(a)}</code>
                      </th>
                      <td set:html={codeify(a.description)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {v.events.length > 0 && (
            <div class="site-table-wrap">
              <table class="site-table">
                <caption class="ui-caption ui-text-start">
                  Events (composed, bubbling <code>CustomEvent</code>s)
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Event</th>
                    <th scope="col">
                      <code>detail</code>
                    </th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {v.events.map((e) => (
                    <tr>
                      <th scope="row">
                        <code>{e.name}</code>
                        {"cancelable" in e && e.cancelable ? <div class="ui-caption">cancelable</div> : null}
                      </th>
                      <td>
                        <code>{e.detail}</code>
                      </td>
                      <td set:html={codeify(e.description)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {v.slots.length > 0 && (
            <div class="site-table-wrap">
              <table class="site-table">
                <caption class="ui-caption ui-text-start">Slots</caption>
                <thead>
                  <tr>
                    <th scope="col">Slot</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {v.slots.map((s) => (
                    <tr>
                      <th scope="row">{s.name ? <code>{s.name}</code> : <em>(default)</em>}</th>
                      <td set:html={codeify(s.description)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {v.parts.length > 0 && (
            <div class="site-table-wrap">
              <table class="site-table">
                <caption class="ui-caption ui-text-start">
                  <code>::part()</code> names
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Part</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {v.parts.map((p) => (
                    <tr>
                      <th scope="row">
                        <code>{p.name}</code>
                      </th>
                      <td set:html={codeify(p.description)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {v.states.length > 0 && (
            <div class="site-table-wrap">
              <table class="site-table">
                <caption class="ui-caption ui-text-start">
                  Custom states (<code>:state()</code>)
                </caption>
                <thead>
                  <tr>
                    <th scope="col">State</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {v.states.map((s) => (
                    <tr>
                      <th scope="row">
                        <code>{`:state(${s.name})`}</code>
                      </th>
                      <td set:html={codeify(s.description)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {v.texts.length > 0 && (
            <div class="site-table-wrap">
              <table class="site-table">
                <caption class="ui-caption ui-text-start">Text keys (translatable through the i18n service)</caption>
                <thead>
                  <tr>
                    <th scope="col">Key</th>
                    <th scope="col">English</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {v.texts.map((t) => (
                    <tr>
                      <th scope="row">
                        <code>{t.key}</code>
                      </th>
                      <td>{t.text}</td>
                      <td set:html={codeify(t.description ?? "")} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      )
    })
  }
</div>
