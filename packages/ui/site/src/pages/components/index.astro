---
/**
 * Component index:  one group per topic (`ComponentIndex.topics()`, in `ValueSets.topics` order), each a grid of TAG
 * cards;  a tag appears under each of its topics.  Same tags and links as the sidebar's component browser.
 * - A card:  name, `<tag>`, the vocabulary's one-line description, and the folder page's status badge when not done.
 * - The header's "Components" link lands here.
 */
import Docs from "../../layouts/Docs.astro"
import { ComponentIndex } from "../../lib/ComponentIndex"
import { url } from "../../lib/nav"
import { slug } from "../../lib/text"

const topics = await ComponentIndex.topics()
---

<Docs title="Components" summary="Fomantic's vocabulary as ui-* custom elements, by topic." wide>
  {
    topics.map((group) => (
      <section class="ui-stack ui-gap-m" aria-labelledby={`topic-${slug(group.topic)}`}>
        <h2 id={`topic-${slug(group.topic)}`}>{group.title}</h2>
        {/* `ui-not-prose`:  the prose column's list indent would beat `ui-list-plain` */}
        <ul class="ui-grid ui-list-plain ui-not-prose site-cards" role="list" style="--min-column-size: 16em">
          {group.rows.map((row) => (
            <li>
              <a class="site-card ui-stack ui-gap-2xs ui-p-m ui-link-plain" href={url(row.path)}>
                <span class="ui-split ui-gap-xs">
                  <span class="ui-bold">{row.name}</span>
                  {row.badge && <span class="site-badge">{row.badge}</span>}
                </span>
                <code>{`<${row.tag}>`}</code>
                {row.description && <span class="ui-muted">{row.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Docs>
