{
  "name": "spell-language",
  "displayName": "Spell",
  "version": "0.8.0",
  "private": true,
  "description": "Spell language support:  errors, hover, completion, go to definition, rename -- from spell's language server.",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-app",
  "publisher": "spell-app",
  "main": "./out/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "check": "cd ../.. && node_modules/.bin/tsc --noEmit -p packages/vscode",
    "package": "vsce package --no-dependencies --skip-license --out spell-language.vsix",
    "install-extension": "code --install-extension spell-language.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "vscode-languageclient": "^10.1.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "spell.showCompiled",
        "title": "Show Compiled JavaScript",
        "category": "Spell",
        "enablement": "editorLangId == spell"
      },
      {
        "command": "spell.showLineTree",
        "title": "Show Tree for This Line",
        "category": "Spell",
        "enablement": "editorLangId == spell"
      },
      {
        "command": "spell.runProject",
        "title": "Run Project",
        "category": "Spell",
        "icon": "$(play)",
        "enablement": "editorLangId == spell"
      },
      {
        "command": "spell.docView.back",
        "title": "Back",
        "category": "Spell",
        "icon": "$(arrow-left)",
        "enablement": "spell.docView.canGoBack"
      },
      {
        "command": "spell.docView.forward",
        "title": "Forward",
        "category": "Spell",
        "icon": "$(arrow-right)",
        "enablement": "spell.docView.canGoForward"
      },
      {
        "command": "spell.docView.reload",
        "title": "Reload Doc",
        "category": "Spell",
        "icon": "$(refresh)"
      },
      {
        "command": "spell.docView.restartServer",
        "title": "Restart Page Server",
        "category": "Spell",
        "icon": "$(server-process)"
      },
      {
        "command": "spell.docView.openExternal",
        "title": "Open Doc in Browser",
        "category": "Spell",
        "icon": "$(link-external)"
      },
      {
        "command": "spell.docView.home",
        "title": "Docs Index",
        "category": "Spell",
        "icon": "$(home)"
      },
      {
        "command": "spell.reviewView.back",
        "title": "Review:  Back",
        "category": "Spell",
        "icon": "$(arrow-left)",
        "enablement": "spell.reviewView.canGoBack"
      },
      {
        "command": "spell.reviewView.forward",
        "title": "Review:  Forward",
        "category": "Spell",
        "icon": "$(arrow-right)",
        "enablement": "spell.reviewView.canGoForward"
      },
      {
        "command": "spell.reviewView.reload",
        "title": "Review:  Reload Doc",
        "category": "Spell",
        "icon": "$(refresh)"
      },
      {
        "command": "spell.reviewView.restartServer",
        "title": "Review:  Restart Page Server",
        "category": "Spell",
        "icon": "$(server-process)"
      },
      {
        "command": "spell.reviewView.openExternal",
        "title": "Review:  Open Doc in Browser",
        "category": "Spell",
        "icon": "$(link-external)"
      },
      {
        "command": "spell.reviewView.openEpic",
        "title": "Review:  Open Epic...",
        "category": "Spell",
        "icon": "$(checklist)"
      },
      {
        "command": "spell.reviewView.home",
        "title": "Review:  Docs Index",
        "category": "Spell",
        "icon": "$(home)"
      },
      {
        "command": "spell.docView.inspect",
        "title": "Inspect:  opens (or closes) Developer Tools;  then Cmd+Shift+C there (the arrow, top left) and click in the page",
        "category": "Spell",
        "icon": "$(inspect)"
      },
      {
        "command": "spell.docView.showConsole",
        "title": "Show Console:  opens (or closes) Developer Tools;  then its Console tab, and the page (127.0.0.1) in the menu at its top left",
        "category": "Spell",
        "icon": "$(debug-console)"
      },
      {
        "command": "spell.docMenu.cut",
        "title": "Cut",
        "category": "Spell Docs"
      },
      {
        "command": "spell.docMenu.copy",
        "title": "Copy",
        "category": "Spell Docs"
      },
      {
        "command": "spell.docMenu.paste",
        "title": "Paste",
        "category": "Spell Docs"
      },
      {
        "command": "spell.docMenu.selectAll",
        "title": "Select All",
        "category": "Spell Docs"
      },
      {
        "command": "spell.docMenu.back",
        "title": "Back",
        "category": "Spell Docs",
        "enablement": "webviewId == spell.docView && spell.docView.canGoBack || webviewId == spell.reviewView && spell.reviewView.canGoBack"
      },
      {
        "command": "spell.docMenu.forward",
        "title": "Forward",
        "category": "Spell Docs",
        "enablement": "webviewId == spell.docView && spell.docView.canGoForward || webviewId == spell.reviewView && spell.reviewView.canGoForward"
      },
      {
        "command": "spell.docMenu.reload",
        "title": "Reload",
        "category": "Spell Docs"
      },
      {
        "command": "spell.docMenu.openExternal",
        "title": "Open in Browser",
        "category": "Spell Docs"
      },
      {
        "command": "spell.docMenu.inspect",
        "title": "Inspect (Developer Tools)",
        "category": "Spell Docs"
      }
    ],
    "configuration": {
      "title": "Spell",
      "properties": {
        "spell.parserRoot": {
          "type": "string",
          "default": "",
          "description": "Folder of the spell monorepo whose language server to run.  Empty:  the one the extension was built in."
        },
        "spell.compileOnSave": {
          "type": "boolean",
          "default": false,
          "description": "On save, compile the project to its .output.js, so a running app picks it up."
        },
        "spell.docPreview.location": {
          "type": "string",
          "enum": [
            "sidebar",
            "beside"
          ],
          "default": "sidebar",
          "enumDescriptions": [
            "The \"Spell Docs\" tab, in the right (secondary) side bar.",
            "Simple Browser, in an editor column beside the editor."
          ],
          "description": "Where docs pages open (`spell dev plan-doc open`, `/spell-docs`, `/goals-open-vs`).  Pages for review always open in the side bar's \"Review\" tab."
        }
      }
    },
    "grammars": [
      {
        "language": "spell",
        "scopeName": "source.spell",
        "path": "./syntaxes/spell.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "spell",
        "aliases": [
          "Spell",
          "spell"
        ],
        "extensions": [
          ".spell"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "spell.showLineTree",
          "when": "editorLangId == spell",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "spell.showCompiled",
          "when": "editorLangId == spell",
          "group": "navigation"
        },
        {
          "command": "spell.runProject",
          "when": "editorLangId == spell",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "spell.docView.back",
          "when": "view == spell.docView",
          "group": "navigation@1"
        },
        {
          "command": "spell.docView.forward",
          "when": "view == spell.docView",
          "group": "navigation@2"
        },
        {
          "command": "spell.docView.reload",
          "when": "view == spell.docView",
          "group": "navigation@3"
        },
        {
          "command": "spell.docView.restartServer",
          "when": "view == spell.docView",
          "group": "navigation@4"
        },
        {
          "command": "spell.docView.openExternal",
          "when": "view == spell.docView",
          "group": "navigation@5"
        },
        {
          "command": "spell.reviewView.back",
          "when": "view == spell.reviewView",
          "group": "navigation@1"
        },
        {
          "command": "spell.reviewView.forward",
          "when": "view == spell.reviewView",
          "group": "navigation@2"
        },
        {
          "command": "spell.reviewView.reload",
          "when": "view == spell.reviewView",
          "group": "navigation@3"
        },
        {
          "command": "spell.reviewView.restartServer",
          "when": "view == spell.reviewView",
          "group": "navigation@4"
        },
        {
          "command": "spell.reviewView.openExternal",
          "when": "view == spell.reviewView",
          "group": "navigation@5"
        },
        {
          "command": "spell.reviewView.openEpic",
          "when": "view == spell.reviewView",
          "group": "navigation@0"
        },
        {
          "command": "spell.docView.inspect",
          "when": "view == spell.docView || view == spell.reviewView",
          "group": "navigation@6"
        },
        {
          "command": "spell.docView.showConsole",
          "when": "view == spell.docView || view == spell.reviewView",
          "group": "navigation@7"
        }
      ],
      "webview/context": [
        {
          "command": "spell.docMenu.cut",
          "when": "(webviewId == spell.docView || webviewId == spell.reviewView) && spellField && spellSelection",
          "group": "1_edit@1"
        },
        {
          "command": "spell.docMenu.copy",
          "when": "(webviewId == spell.docView || webviewId == spell.reviewView) && spellSelection",
          "group": "1_edit@2"
        },
        {
          "command": "spell.docMenu.paste",
          "when": "(webviewId == spell.docView || webviewId == spell.reviewView) && spellField",
          "group": "1_edit@3"
        },
        {
          "command": "spell.docMenu.selectAll",
          "when": "(webviewId == spell.docView || webviewId == spell.reviewView)",
          "group": "1_edit@4"
        },
        {
          "command": "spell.docMenu.back",
          "when": "(webviewId == spell.docView || webviewId == spell.reviewView)",
          "group": "2_page@1"
        },
        {
          "command": "spell.docMenu.forward",
          "when": "(webviewId == spell.docView || webviewId == spell.reviewView)",
          "group": "2_page@2"
        },
        {
          "command": "spell.docMenu.reload",
          "when": "(webviewId == spell.docView || webviewId == spell.reviewView)",
          "group": "2_page@3"
        },
        {
          "command": "spell.docMenu.openExternal",
          "when": "(webviewId == spell.docView || webviewId == spell.reviewView)",
          "group": "3_open@1"
        },
        {
          "command": "spell.docMenu.inspect",
          "when": "(webviewId == spell.docView || webviewId == spell.reviewView)",
          "group": "4_inspect@1"
        }
      ],
      "commandPalette": [
        {
          "command": "spell.docMenu.cut",
          "when": "false"
        },
        {
          "command": "spell.docMenu.copy",
          "when": "false"
        },
        {
          "command": "spell.docMenu.paste",
          "when": "false"
        },
        {
          "command": "spell.docMenu.selectAll",
          "when": "false"
        },
        {
          "command": "spell.docMenu.back",
          "when": "false"
        },
        {
          "command": "spell.docMenu.forward",
          "when": "false"
        },
        {
          "command": "spell.docMenu.reload",
          "when": "false"
        },
        {
          "command": "spell.docMenu.openExternal",
          "when": "false"
        },
        {
          "command": "spell.docMenu.inspect",
          "when": "false"
        }
      ]
    },
    "configurationDefaults": {
      "[spell]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": false
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "comment.heading1:spell": {
            "bold": true
          },
          "comment.heading2:spell": {
            "bold": true
          },
          "comment.heading3:spell": {
            "bold": true
          },
          "comment.heading4:spell": {
            "bold": true
          },
          "comment.bold:spell": {
            "bold": true
          },
          "comment.italic:spell": {
            "italic": true
          },
          "comment.link:spell": {
            "underline": true
          },
          "comment.strikethrough:spell": {
            "strikethrough": true
          }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.number-sign.heading.spell",
            "settings": {
              "fontStyle": "bold"
            }
          }
        ]
      }
    },
    "semanticTokenModifiers": [
      {
        "id": "heading1",
        "description": "A top-level heading comment:  `#` at the start of a line, markdown-style."
      },
      {
        "id": "heading2",
        "description": "A second-level heading comment:  `##` at the start of a line."
      },
      {
        "id": "heading3",
        "description": "A third-level heading comment:  `###` at the start of a line."
      },
      {
        "id": "heading4",
        "description": "A fourth-level or deeper heading comment:  `####` ... at the start of a line."
      },
      {
        "id": "bold",
        "description": "Markdown `**bold**` inside a comment (spell docstrings are markdown)."
      },
      {
        "id": "italic",
        "description": "Markdown `*italic*` inside a comment."
      },
      {
        "id": "link",
        "description": "A markdown link inside a comment."
      },
      {
        "id": "strikethrough",
        "description": "Markdown `~~struck~~` inside a comment."
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "spell-docs",
          "title": "Spell Docs",
          "icon": "media/spell.svg"
        },
        {
          "id": "spell-review",
          "title": "Review",
          "icon": "$(pass)"
        }
      ]
    },
    "views": {
      "spell-docs": [
        {
          "type": "webview",
          "id": "spell.docView",
          "name": "Spell Docs"
        }
      ],
      "spell-review": [
        {
          "type": "webview",
          "id": "spell.reviewView",
          "name": "Review"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "yarn@4.18.0"
}
