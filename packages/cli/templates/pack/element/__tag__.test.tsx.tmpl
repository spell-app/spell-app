import { describe, expect, test } from "vite-plus/test"

import { ElementFixture } from "$/ui/test/ElementFixture"
import { expectAccessible } from "$/ui/test/a11y"

import "$/__pack__/components/__tag__"

describe("<__tag__>", () => {
  test("shows its content through its `base` part, and passes axe", async () => {
    const element = await ElementFixture.render(`<__tag__>Hello</__tag__>`)
    expect(element.shadowRoot!.querySelector(`[part~="base"] slot`)).not.toBeNull()
    expect(element.textContent).toBe("Hello")
    await expectAccessible(element)
  })
})
