{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": { "pattern": "[\\p{L}_][\\p{L}\\p{M}\\d_-]*|-?\\d+(\\.\\d+)?", "flags": "u" },
  "indentationRules": {
    "increaseIndentPattern": ":\\s*$",
    "decreaseIndentPattern": {
      "pattern": "^\\s*(?:otherwise|else|sino|de\\s+lo\\s+contrario|si\\s+no(?=\\s*:|\\s+si\\b))(?![\\p{L}\\p{M}\\d_-])",
      "flags": "u"
    }
  },
  "onEnterRules": [
    {
      "beforeText": ":\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
