---
/**
 * CSS custom properties of one component family, generated at BUILD time from its stylesheets
 * (every `src/components/<family>/*.css`), so the table can't drift.
 * - A sheet never declares its public tokens (`docs/theming.md` "Component tokens").  Two kinds of rows:
 *   - ALIASED tokens, the ones a variation swaps:  `--_ui-button-radius: var(--ui-button-radius, var(--ui-radius))`.
 *     The public name, its default, the `/* comment *\/` right above as the description, unless it's a group
 *     header (`/* ## Owner tokens ... *\/`).
 *   - tokens READ WHERE THEY PAINT, varied by nothing:  `padding: var(--ui-modal-content-padding, 1.5em)`.  The
 *     first read's fallback is the default, the comment right above that property the description.
 * - Defaults show the PUBLIC names of the tokens they derive from (`calc(1em + 2 * var(--ui-button-padding-block))`).
 *   A default built from sheet plumbing (`var(--_modal-width)`, a per-screen value, a private switch) reads badly:
 *   the page passes readable text through `defaults`.
 * - `prefixes` defaults to `--ui-<family>-`;  the trailing dash matters (`--ui-button-` never matches
 *   `--ui-buttons-*`).  Foundation names that share a prefix (`--ui-text-muted` for `text`) are left out.
 * - Renders through `TokenTable` (no swatches:  the defaults resolve inside the shadow root, so the page can't
 *   `var()` them).
 */
import { readdirSync, readFileSync } from "node:fs"
import { resolve } from "node:path"

import { ComponentTokens } from "$/ui/styles/ComponentTokens"

import TokenTable from "./TokenTable.astro"

type Props = {
  /** family folder name, e.g. `button` */
  family: string
  /** token name prefixes to keep, default `["--ui-<family>-"]` */
  prefixes?: string[]
  /** readable default text by token name, in place of the sheet's, e.g. `{ "--ui-modal-width": "by size" }` */
  defaults?: Record<string, string>
  /** table caption */
  caption?: string
}

type Row = { name: string; default: string; description?: string }

const { family, caption } = Astro.props
const prefixes = Astro.props.prefixes ?? [`--ui-${family}-`]
const defaults = Astro.props.defaults ?? {}

// NOTE: `cwd`, not `import.meta.url`:  the latter points into Astro's build chunks, not `src/`
const folder = resolve(process.cwd(), "../src/components", family)
const main = `${family}.css`
const sheets = readdirSync(folder)
  .filter((file) => file.endsWith(".css"))
  .sort((a, b) => Number(b === main) - Number(a === main) || a.localeCompare(b))
  .map((file) => readFileSync(resolve(folder, file), "utf8"))
const stylesFolder = resolve(process.cwd(), "../src/styles")
const foundation = new Set(
  readdirSync(stylesFolder)
    .filter((file) => file.endsWith(".css"))
    .flatMap((file) => ComponentTokens.declarations(readFileSync(resolve(stylesFolder, file), "utf8")))
    .map(({ name }) => name)
)

const rows = new Map<string, Row>()
for (const css of sheets) for (const token of ComponentTokens.aliases(css)) add(token)
const aliased = new Set(sheets.flatMap((css) => ComponentTokens.aliases(css).map(({ name }) => name)))
for (const css of sheets) for (const token of reads(css)) add(token)
const tokens = [...rows.values()].map((row) => ({
  ...row,
  default: defaults[row.name] ?? publicNames(row.default),
  description: row.description?.startsWith("## ") ? undefined : row.description
}))

/** `value` with each ALIAS read by its public name (`--_ui-x` => `--ui-x`);  a private switch keeps its name. */
function publicNames(value: string): string {
  return value.replace(/--_ui-[a-z0-9-]+/g, (name) => (aliased.has(`--${name.slice(3)}`) ? `--${name.slice(3)}` : name))
}

/** Add `token` unless it's unwanted or already listed (first one wins:  aliases, then the main sheet). */
function add(token: Row): void {
  if (rows.has(token.name) || foundation.has(token.name)) return
  if (prefixes.some((prefix) => token.name.startsWith(prefix))) rows.set(token.name, token)
}

/**
 * Public tokens `css` reads with a fallback, `var(--ui-x, <default>)`, first read wins.
 * - Includes the public read inside an alias or a dual read;  `add()` drops those already listed.
 */
function reads(css: string): Row[] {
  const stripped = ComponentTokens.stripComments(css)
  const found: Row[] = []
  for (const match of stripped.matchAll(/var\(\s*(--ui-[a-z0-9-]+)\s*,/g)) {
    const start = match.index + match[0].length
    let depth = 0
    let end = start
    for (; end < stripped.length; end++) {
      if (stripped[end] === "(") depth++
      else if (stripped[end] === ")" && depth-- === 0) break
    }
    found.push({
      name: match[1]!,
      default: stripped.slice(start, end).replace(/\s+/g, " ").trim(),
      description: commentAbove(css, match.index)
    })
  }
  return found
}

/**
 * The `/* comment *\/` right above the declaration holding `index`, whitespace collapsed.
 * - Looks back to the previous `;` / `{` only, so a rule's or another declaration's comment never matches.
 */
function commentAbove(css: string, index: number): string | undefined {
  const stripped = ComponentTokens.stripComments(css)
  const start = Math.max(stripped.lastIndexOf(";", index), stripped.lastIndexOf("{", index)) + 1
  const comment = /\/\*((?:(?!\*\/)[\s\S])*)\*\/\s*[a-z-]+\s*:[^;{}]*$/.exec(css.slice(start, index))?.[1]
  return comment
    ?.replace(/^\s*\*(?!\/)/gm, "")
    .replace(/\s+/g, " ")
    .trim()
}
---

{
  tokens.length > 0 ? (
    <TokenTable tokens={tokens} caption={caption} />
  ) : (
    <p class="site-note">
      <code>{`<ui-${family}>`}</code> exposes no <code>--ui-{family}-*</code> tokens.
    </p>
  )
}
