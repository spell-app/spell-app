{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client"]
  },
  "include": ["src", "test", "tools", "site/_src"],
  // `packages/` are their own projects (own `tsconfig.json`, `yarn fork tsc`);  files the root imports from them
  // are still checked here
  // `site/`:  only `site/_src` (the site bundle's entry);  the rest is pages, data and the committed bundle
  "exclude": ["site/_assets", "packages", "node_modules", "dist", "vendor", "tools/frameworks/solid/dist"]
}
