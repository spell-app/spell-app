{
  // The TypeScript settings every repo shares.
  // - The extension imports its own files, its own packages (`vscode`, `vscode-languageclient`),
  //   and the kit's elements help (`spell-kit/element-tools/jsx-help/...`, read here as the kit's declarations).
  // - Never spell-app's:  it runs a checkout's language server as a process.
  "extends": "spell-kit/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vscode"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
