---
/**
 * API reference for one tag, read at BUILD time from the custom-elements manifest (`../custom-elements.json`,
 * written by `yarn manifest` in the repo root).
 * - No manifest, or no declaration for `tag` => a "coming soon" note, so pages can include this now.
 * - Renders attributes, properties, events, slots, CSS parts and CSS properties, each only if present.
 * - TODO: once components land, check the manifest shape against the analyzer's real output (0.11).
 */
import { existsSync, readFileSync } from "node:fs"
import { resolve } from "node:path"

type Props = {
  /** custom element tag, e.g. `ui-button` */
  tag: string
}

/** One documented member / attribute / event ... as the manifest lists it. */
type ManifestItem = {
  name: string
  description?: string
  type?: { text?: string }
  default?: string
  kind?: string
  static?: boolean
  privacy?: string
}

/** A class declaration in the manifest. */
type ManifestDeclaration = {
  tagName?: string
  attributes?: ManifestItem[]
  members?: ManifestItem[]
  events?: ManifestItem[]
  slots?: ManifestItem[]
  cssParts?: ManifestItem[]
  cssProperties?: ManifestItem[]
}

const { tag } = Astro.props
const declaration = findDeclaration(tag)
const tables: Array<[string, ManifestItem[]]> = declaration
  ? [
      ["Attributes", declaration.attributes ?? []],
      [
        "Properties",
        (declaration.members ?? []).filter((m) => m.kind === "field" && !m.static && m.privacy !== "private")
      ],
      ["Events", declaration.events ?? []],
      ["Slots", declaration.slots ?? []],
      ["CSS parts", declaration.cssParts ?? []],
      ["CSS properties", declaration.cssProperties ?? []]
    ]
  : []

/** The declaration for `tagName` in the repo's `custom-elements.json`, if the file and the tag exist. */
function findDeclaration(tagName: string): ManifestDeclaration | undefined {
  // NOTE: `cwd`, not `import.meta.url`:  the latter points into Astro's build chunks, not `src/`
  const path = resolve(process.cwd(), "../custom-elements.json")
  if (!existsSync(path)) return undefined
  const manifest = JSON.parse(readFileSync(path, "utf8")) as {
    modules?: Array<{ declarations?: ManifestDeclaration[] }>
  }
  for (const module of manifest.modules ?? []) {
    const found = module.declarations?.find((d) => d.tagName === tagName)
    if (found) return found
  }
  return undefined
}
---

{
  declaration ? (
    <div class="ui-stack ui-gap-l">
      {tables
        .filter(([, rows]) => rows.length)
        .map(([title, rows]) => (
          <div class="site-table-wrap">
            <table class="site-table">
              <caption class="ui-caption ui-text-start">{title}</caption>
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">Type</th>
                  <th scope="col">Default</th>
                  <th scope="col">Description</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => (
                  <tr>
                    <th scope="row">
                      <code>{row.name || "(default)"}</code>
                    </th>
                    <td>{row.type?.text && <code>{row.type.text}</code>}</td>
                    <td>{row.default && <code>{row.default}</code>}</td>
                    <td>{row.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
    </div>
  ) : (
    <p class="site-note">
      API tables for <code>{`<${tag}>`}</code> are coming soon:  they are generated from
      <code>custom-elements.json</code> (<code>yarn manifest</code> in the repo root) once the component lands.
    </p>
  )
}
