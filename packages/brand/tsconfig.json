{
  "extends": ["@spell-app/toolchain/tsconfig.base.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "components", "scripts", "test", "vite.config.ts"],
  // Claude Design's files and the committed bundle are not ours to check
  "exclude": ["spell-design-system", "_assets", "node_modules"]
}
