{
  "name": "spell-app",
  "private": true,
  "description": "Spell's editor and its servers:  the app, spaces, the language server, the spell CLI, the page server's Spell layer, and the spell language's VS Code extension",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-app",
  "workspaces": [
    "app",
    "spaces",
    "lsp",
    "cli",
    "page-server"
  ],
  "type": "module",
  "scripts": {
    "ts": "spell-types --below && yarn workspaces foreach -W --exclude spell-app -pv --topological-dev -j 4 run ts",
    "test": "yarn workspaces foreach -W --exclude spell-app -pv -j 4 run test",
    "lint": "yarn workspaces foreach -W --exclude spell-app -pv -j 4 run lint",
    "format": "yarn workspaces foreach -W --exclude spell-app -pv -j 4 run format",
    "review": "yarn workspaces foreach -W --exclude spell-app -v run review",
    "vscode": "node cli/bin/spell.mjs dev vscode",
    "vscode:build": "node cli/bin/spell.mjs dev vscode build",
    "vscode:install": "node cli/bin/spell.mjs dev vscode install",
    "docs:update": "node cli/bin/spell.mjs dev docs update",
    "docs:index": "node cli/bin/spell.mjs dev docs index",
    "docs:new": "node cli/bin/spell.mjs dev docs new",
    "docs:open": "node cli/bin/spell.mjs dev docs open",
    "epic": "epic",
    "ask": "epic ask",
    "plan-doc": "node cli/bin/spell.mjs dev plan-doc",
    "details": "node cli/bin/spell.mjs dev details",
    "docs:link": "node cli/bin/spell.mjs dev docs link",
    "window": "node cli/bin/spell.mjs dev window",
    "server": "node cli/bin/spell.mjs dev server",
    "serve": "node cli/bin/spell.mjs dev server start --all",
    "dev": "SPELL=\"$PWD/cli/bin/spell.mjs\" && cd \"$INIT_CWD\" && node \"$SPELL\" run",
    "dev:ts": "SPELL=\"$PWD/cli/bin/spell.mjs\" && cd \"$INIT_CWD\" && node \"$SPELL\" run --target ts",
    "dev:py": "SPELL=\"$PWD/cli/bin/spell.mjs\" && cd \"$INIT_CWD\" && node \"$SPELL\" run --target py",
    "commands:check": "node cli/bin/spell.mjs dev commands check",
    "test:watch": "vp test"
  },
  "devDependencies": {
    "@spell-app/toolchain": "workspace:*",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "1.63.0",
    "pyright": "1.1.414",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0",
  "pageServer": {
    "routes": [
      "page-server/src/pageServerRoutes.ts",
      "../spell-epic/src/tools/detailsRoutes.ts",
      "../spell-epic/src/tools/choicesRoutes.ts",
      "../spell-epic/src/tools/commentsRoutes.ts",
      "../spell-epic/src/tool/reviewRoutes.ts",
      "../spell-epic/src/tool/epicRoutes.ts",
      "../spell-epic/src/tool/linkRoutes.ts",
      "../spell-epic/src/list/runningRoutes.ts",
      "../spell-epic/src/tools/agentRoutes.ts",
      "../spell-epic/src/tools/showRoutes.ts",
      "../spell-epic/src/tools/airplaneRoutes.ts",
      "spaces/src/server/node/routes/appRoutes.ts"
    ],
    "watch": [
      "../spell-epic/src/tools/_assets",
      "../spell-brand",
      "../spell-epic/src/components/__pack",
      "../spell-brand/components/__pack"
    ],
    "writable": [
      "epics",
      "guides",
      "pages",
      "brand"
    ],
    "bundles": [
      "../spell-ui/site/_assets",
      "../spell-brand/_assets/ui"
    ],
    "pageScripts": [
      {
        "src": "/element/spell-language.js",
        "file": "app/dist-element/spell-language.js",
        "skip": [
          "/components/"
        ]
      }
    ],
    "componentSets": {
      "ui": {
        "name": "Spell UI",
        "dir": "../spell-ui/docs",
        "assets": "../spell-ui/site/_assets"
      },
      "epics": {
        "name": "Epic UI",
        "dir": "../spell-epic/src/docs",
        "assets": "../spell-ui/site/_assets"
      },
      "app": {
        "name": "App UI",
        "dir": "app/docs",
        "assets": "../spell-ui/site/_assets"
      },
      "brand": {
        "name": "Brand",
        "dir": "../spell-brand/docs",
        "assets": "../spell-ui/site/_assets"
      }
    },
    "siteTabs": [
      {
        "name": "Guides",
        "path": "guides/index.html",
        "areas": [
          "guides"
        ]
      },
      {
        "name": "Sagas",
        "path": "sagas/index.html",
        "areas": [
          "sagas",
          "goals"
        ]
      },
      {
        "name": "Epics",
        "path": "epics/index.html",
        "areas": [
          "epics"
        ]
      },
      {
        "name": "Epic/UI",
        "path": "/components/epics/",
        "serverOnly": true,
        "sets": [
          "epics"
        ],
        "paths": [
          "/packages/epics/docs/",
          "/spell-epic/src/docs/"
        ]
      },
      {
        "name": "Spell/UI",
        "path": "/components/ui/",
        "serverOnly": true,
        "sets": [
          "ui"
        ],
        "paths": [
          "/packages/ui/docs/",
          "/packages/ui/site/"
        ]
      },
      {
        "name": "App",
        "path": "/editor/",
        "serverOnly": true,
        "ownTab": true,
        "paths": [
          "^/editor(/|$)"
        ]
      },
      {
        "name": "App/UI",
        "path": "/components/app/",
        "serverOnly": true,
        "sets": [
          "app"
        ],
        "paths": [
          "/packages/app/docs/"
        ]
      },
      {
        "name": "Brand",
        "path": "brand/index.html",
        "areas": [
          "brand"
        ],
        "sets": [
          "brand"
        ],
        "paths": [
          "/packages/brand/docs/"
        ]
      },
      {
        "name": "Templates",
        "path": "templates/index.html",
        "areas": [
          "templates"
        ]
      }
    ],
    "engineRoutes": {
      "/_epic/assets/": "../spell-epic/src/tools/_assets",
      "/_epic/pack/": "../spell-epic/src/components/__pack",
      "/templates/": "../spell-epic/templates",
      "/packages/brand/components/__pack/": "../spell-brand/components/__pack"
    }
  },
  "shared": {
    "links": [
      "agents"
    ]
  }
}
