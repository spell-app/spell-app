{
  "name": "@spell-app/__pack__",
  "version": "0.0.0",
  "private": true,
  "description": "A component pack:  <__prefix__*> elements a page loads on demand through <ui-root> (spell dev pack)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "pack:build": "spell-ui-pack build",
    "pack:check": "spell-ui-pack check",
    "/////// CORRECTNESS": "",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "ts": "echo '>>>>>>>>>>>\n>> RUNNING TSC' && tsc && tsc -p ../../tests/__pack__ && echo '<< TSC PASSED\n'",
    "lint": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT' && vp lint --report-unused-disable-directives --max-warnings 0 src components && cd ../../tests/__pack__ && vp lint --report-unused-disable-directives --max-warnings 0 . && echo '<< OXLINT PASSED\n'",
    "lint:fix": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT --fix' && vp lint --fix src components && cd ../../tests/__pack__ && vp lint --fix . && echo '<< OXLINT PASSED\n'",
    "format": "echo '>>>>>>>>>>>\n>> FORMATTING WITH OXFMT' && vp fmt src components vite.config.ts vitest.config.ts && cd ../../tests/__pack__ && vp fmt . && echo '<< OXFMT PASSED\n'",
    "/////// TESTING": "",
    "test": "echo '>>>>>>>>>>>\n>> RUNNING TESTS' && vp test run && echo '<< TESTS PASSED\n'"
  },
  "devDependencies": {
    "@solidjs/web": "__solid__",
    "@spell-app/toolchain": "workspace:*",
    "@spell-app/ui": "workspace:*",
    "@types/node": "^22.20.4",
    "solid-js": "__solid__",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0",
  "spellPack": {
    "prefix": "__prefix__"
  }
}
