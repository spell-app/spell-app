---
/**
 * One entry of a "Variations" section:  an `h3` heading (with anchor) and ONE live `Example` of its slot.
 * - Separate from `Example`'s own title so a variation reads as a sub-heading of the section, like
 *   Fomantic's "Size", "Colored", "Fluid" -- and so an author can add prose between heading and example.
 * - The slot is forwarded to `Example`, whose source capture sees exactly this markup.
 */
import Example from "./Example.astro"
import { slug } from "../lib/text"

type Props = {
  /** variation name, e.g. `Size` */
  title: string
  /** anchor id;  defaults to `slug(title)` */
  id?: string
  /** a sentence under the heading:  "A button can have different sizes" */
  description?: string
  /** extra classes on the live box */
  class?: string
  /** source to show instead of the captured markup */
  code?: string
}

const { title, id = slug(title), description, class: demoClass, code } = Astro.props
---

<div class="site-variation ui-stack ui-gap-s">
  <h3 id={id} class="site-example-title site-anchored">
    {title}<a class="site-anchor" href={`#${id}`} aria-label={`Link to ${title}`}>#</a>
  </h3>
  <Example description={description} class={demoClass} code={code}><slot /></Example>
</div>
