// ## A playing card -- in the outline style:  its name, then what's true of it
///////////////////////////////////////////////////////////////////////////////
/**
 * The card says what its suits, ranks and colors are:  a deck, a pile or a game only reads them.
 * A drawable thing:  each card is its own element on the page, e.g. \`<cards-card>\`.
 */
/*! SPELL: DECLARES {
  type: "Card", superType: "Drawable",
  defined: "/Card.spell:260-3120",
} */
export class Card extends Drawable {
  static elementTag = core.defineElement(this, "test-project")

  /** card rank */
  /*! SPELL: DECLARES {
    property: "rank", classVariable: "Ranks", of: "Card",
    enumeration: ["ace", 2, 3, 4, 5, 6, 7, 8, 9, 10, "jack", "queen", "king"],
    defined: "/Card.spell:312-365",
  } */
  // - its "rank" is one of ace, 2 ... 10, jack, queen, king
  static Ranks = ["ace", 2, 3, 4, 5, 6, 7, 8, 9, 10, "jack", "queen", "king"]
  static { this.declareProp("rank", { oneOf: Card.Ranks }) }
  get rank() { return this.getProp("rank") }
  set rank(value) { this.setProp("rank", value) }

  /** ace = 1 ... king = 13 */
  /*! SPELL: DECLARES {
    property: "value", of: "Card", datatype: "number",
    defined: "/Card.spell:370-409",
  } */
  get value() {
    return spellPosition(positionOf(Card.Ranks, this.rank))
  }

  /** "card is a king" */
  /*! SPELL: DECLARES {
    syntax: "{operator:is_or_is_not_a} (expression:ace|aces|2|3|4|5|6|7|8|9|10|jack|jacks|queen|queens|king|kings)",
    output: "is_a_$rank", rule: "quoted_property", of: "Card", kind: "method", name: '"is a (rank)"',
    values: { rank: ["ace", 2, 3, 4, 5, 6, 7, 8, 9, 10, "jack", "queen", "king"] },
    defined: "/Card.spell:447-463",
  } */
  isARank(rank) {
    return this.rank === rank
  }

  /** "card is a face card" */
  /*! SPELL: DECLARES {
    syntax: "{operator:is_or_is_not_a} face card", output: "is_a_face_card", rule: "method_postfix",
    of: "Card", kind: "method", name: '"is a face card"', returns: "choice",
    defined: "/Card.spell:497-551",
  } */
  get isAFaceCard() {
    return core.includes(["jack", "queen", "king"], this.rank)
  }

  /** "card is a number card" */
  /*! SPELL: DECLARES {
    syntax: "{operator:is_or_is_not_a} number card", output: "is_a_number_card",
    rule: "method_postfix", of: "Card", kind: "method", name: '"is a number card"', returns: "choice",
    defined: "/Card.spell:580-626",
  } */
  get isANumberCard() {
    return !this.isAFaceCard
  }

  /** card suit */
  /*! SPELL: DECLARES {
    property: "suit", classVariable: "Suits", of: "Card",
    enumeration: ["clubs", "diamonds", "hearts", "spades"],
    defined: "/Card.spell:674-728",
  } */
  // - its "suit" is one of clubs, diamonds, hearts or spades
  static Suits = ["clubs", "diamonds", "hearts", "spades"]
  static { this.declareProp("suit", { oneOf: Card.Suits }) }
  get suit() { return this.getProp("suit") }
  set suit(value) { this.setProp("suit", value) }

  /** "card is a diamond" */
  /*! SPELL: DECLARES {
    syntax: "{operator:is_or_is_not_a} (expression:clubs|club|diamonds|diamond|hearts|heart|spades|spade)",
    output: "is_a_$suit", rule: "quoted_property", of: "Card", kind: "method", name: '"is a (suit)"',
    values: { suit: ["clubs", "diamonds", "hearts", "spades"] },
    defined: "/Card.spell:732-748",
  } */
  isASuit(suit) {
    return this.suit === suit
  }

  /*! SPELL: DECLARES {
    property: "color", of: "Card",
    defined: "/Card.spell:786-870",
  } */
  get color() {
    /*! SPELL: DECLARES {
      constants: ["red"],
      defined: "/Card.spell:815-852",
    } */
    if (core.includes(["diamonds", "hearts"], this.suit)) return "red"
    /*! SPELL: DECLARES {
      constants: ["black"],
      defined: "/Card.spell:855-870",
    } */
    return "black"
  }

  /** specific cards */
  /*! SPELL: DECLARES {
    property: "name", of: "Card", datatype: "text",
    defined: "/Card.spell:894-936",
  } */
  // "queen of spades"
  get name() {
    return \`\${this.rank} of \${this.suit}\`
  }

  /** "card is the queen of spades" */
  /*! SPELL: DECLARES {
    syntax: "{operator:is_or_is_not} {definite_article} (expression:ace|aces|2|3|4|5|6|7|8|9|10|jack|jacks|queen|queens|king|kings) of (expression:clubs|club|diamonds|diamond|hearts|heart|spades|spade)",
    output: "is_the_$rank_of_$suit", rule: "quoted_property", of: "Card", kind: "method",
    name: '"is the (rank) of (suit)"',
    values: { rank: ["ace", 2, 3, 4, 5, 6, 7, 8, 9, 10, "jack", "queen", "king"], suit: ["clubs", "diamonds", "hearts", "spades"] },
    defined: "/Card.spell:964-992",
  } */
  isTheRankOfSuit(rank, suit) {
    return this.rank === rank && this.suit === suit
  }

  /** its direction:  face up or face down */
  /*! SPELL: DECLARES {
    property: "direction", classVariable: "Directions", of: "Card", enumeration: ["up", "down"],
    defined: "/Card.spell:1078-1107",
  } */
  // - its "direction" is up or down
  static Directions = ["up", "down"]
  static { this.declareProp("direction", { oneOf: Card.Directions }) }
  get direction() { return this.getProp("direction") }
  set direction(value) { this.setProp("direction", value) }

  /** card is face up */
  /*! SPELL: DECLARES {
    syntax: "{operator:is_or_is_not} face (expression:up|ups|down|downs)",
    output: "is_face_$direction", rule: "quoted_property", of: "Card", kind: "method",
    name: '"is face (direction)"', values: { direction: ["up", "down"] },
    defined: "/Card.spell:1111-1135",
  } */
  isFaceDirection(direction) {
    return this.direction === direction
  }

  ///////////////////////////
  // ## turning the card over
  ///////////////////////////
  /** each pauses a moment, so \`wait for: turn the card face up\` animates */
  /*! SPELL: DECLARES {
    syntax: "turn {thisArg:expression} face up", output: "turn_face_up", rule: "method_call",
    of: "Card", alias: ["statement", "expression"], kind: "method", name: "turn it face up",
    waits: true,
    defined: "/Card.spell:1265-1330",
  } */
  async turnFaceUp() {
    this.direction = "up"
    await core.pauseFor(50, "msec")
  }

  /*! SPELL: DECLARES {
    syntax: "turn {thisArg:expression} face down", output: "turn_face_down", rule: "method_call",
    of: "Card", alias: ["statement", "expression"], kind: "method", name: "turn it face down",
    waits: true,
    defined: "/Card.spell:1334-1403",
  } */
  async turnFaceDown() {
    this.direction = "down"
    await core.pauseFor(50, "msec")
  }

  /*! SPELL: DECLARES {
    syntax: "turn {thisArg:expression} over", output: "turn_over", rule: "method_call", of: "Card",
    alias: ["statement", "expression"], kind: "method", name: "turn it over", waits: true,
    defined: "/Card.spell:1407-1510",
  } */
  async turnOver() {
    if (this.isFaceDirection("up")) await this.turnFaceDown()
    else await this.turnFaceUp()
  }

  /**
   * Card picture:  drawn with special letters in the unicode character set
   * - SEE:  https://www.compart.com/en/unicode/block/U+1F0A0
   */
  /*! SPELL: DECLARES {
    property: "picture", of: "Card", datatype: "text",
    defined: "/Card.spell:1652-2257",
  } */
  get picture() {
    if (this.isFaceDirection("down")) {
      // "Playing Card Back"
      return "🂠"
    }

    const column = this.value
    if (this.isASuit("clubs")) return core.getItemAt(["🃑", "🃒", "🃓", "🃔", "🃕", "🃖", "🃗", "🃘", "🃙", "🃚", "🃛", "🃝", "🃞"], position(column))
    if (this.isASuit("diamonds")) return core.getItemAt(["🃁", "🃂", "🃃", "🃄", "🃅", "🃆", "🃇", "🃈", "🃉", "🃊", "🃋", "🃍", "🃎"], position(column))
    if (this.isASuit("hearts")) return core.getItemAt(["🂱", "🂲", "🂳", "🂴", "🂵", "🂶", "🂷", "🂸", "🂹", "🂺", "🂻", "🂽", "🂾"], position(column))
    if (this.isASuit("spades")) return core.getItemAt(["🂡", "🂢", "🂣", "🂤", "🂥", "🂦", "🂧", "🂨", "🂩", "🂪", "🂫", "🂭", "🂮"], position(column))
  }

  /** one letter, at the size of the text around it:  its pile scales it to fit -- styles.css */
  /*! SPELL: DECLARES {
    syntax: "draw {thisArg:expression}", output: "draw", rule: "method_call", of: "Card",
    alias: ["statement", "expression"], kind: "method", name: "draw it",
    defined: "/Card.spell:2549-2741",
  } */
  draw() {
    return h("ui-text", {
      part: "picture",
      color: () => this.isFaceDirection("up") ? this.color : "blue",
      onClick: () => trigger("card-click", { card: this }),
      style: "cursor:pointer;user-select:none"
    }, () => this.picture)
  }

  /*! SPELL: DECLARES {
    property: "symbol", of: "Card", datatype: "text",
    defined: "/Card.spell:2746-2871",
  } */
  get symbol() {
    if (this.isASuit("clubs")) return "♣"
    if (this.isASuit("diamonds")) return "♦"
    if (this.isASuit("hearts")) return "♥"
    if (this.isASuit("spades")) return "♠"
    return "?"

  }

  /** card "state", used for debugging */
  /*! SPELL: DECLARES {
    property: "state", of: "Card", datatype: "text",
    defined: "/Card.spell:2916-3120",
  } */
  get state() {
    const rank = this.value === 10 ? 10 : \`\${core.getItemAt(this.rank, 0) ?? ""}\`.toLocaleUpperCase()
    const suit = this.symbol
    const direction = this.isFaceDirection("up") ? "↑" : "↓"
    return rank + suit + direction
  }

  static canBeDragged = true
}

