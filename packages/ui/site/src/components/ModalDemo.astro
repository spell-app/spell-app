---
/**
 * Live demo for the modal page's "Dialog helpers" example:  `UI.modals.confirm()` / `alert()` / `prompt()` are
 * JS calls, so they need a script -- MDX can't bundle one, hence this component.
 * - One button per helper;  the promise's answer is shown beside them.
 * - SIDE EFFECT:  imports the modal family, which registers the helpers' provider with `UI.modals`.
 */
---

<div class="ui-stack ui-gap-s" data-modal-demo>
  <div class="ui-cluster">
    <ui-button data-call="confirm">Confirm</ui-button>
    <ui-button data-call="alert">Alert</ui-button>
    <ui-button data-call="prompt">Prompt</ui-button>
  </div>
  <p class="ui-caption ui-m-0">Answer:  <output data-output>nothing yet</output></p>
</div>

<script>
  import { UI } from "$/ui/runtime"
  import "$/ui/components/modal"

  for (const demo of document.querySelectorAll<HTMLElement>("[data-modal-demo]")) {
    const output = demo.querySelector("[data-output]")!
    demo.addEventListener("click", async (event) => {
      const call = (event.target as Element).closest<HTMLElement>("[data-call]")?.dataset.call
      if (!call) return
      await UI.load()
      const answer =
        call === "confirm"
          ? await UI.modals.confirm({ title: "Delete draft?", message: "The draft will be gone for good." })
          : call === "alert"
            ? await UI.modals.alert({ title: "Saved", message: "Your changes are safe." })
            : await UI.modals.prompt({ title: "Rename", message: "New name", value: "Untitled" })
      output.textContent = JSON.stringify(answer ?? null)
    })
  }
</script>
