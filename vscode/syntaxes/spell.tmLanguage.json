{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Spell",
  "scopeName": "source.spell",
  "comment": "Coarse colouring until the language server's semantic tokens arrive:  comments, strings, numbers, statement words;  a type's <css> block, coloured as CSS, and a <markdown> block, coloured as markdown, for good (the language server leaves their insides alone).",
  "patterns": [
    { "include": "#css" },
    { "include": "#css-close" },
    { "include": "#markdown" },
    { "include": "#markdown-close" },
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" }
  ],
  "repository": {
    "css": {
      "comment": "A <css> line opens a block that lasts while lines aren't </css>:  a `while` rule, so an unclosed `{` in the CSS can't swallow the </css>.",
      "begin": "^\\s*(<)(css)(>)\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.spell" },
        "2": { "name": "entity.name.tag.spell" },
        "3": { "name": "punctuation.definition.tag.end.spell" }
      },
      "while": "^(?!\\s*</css>\\s*$)",
      "contentName": "meta.embedded.block.css",
      "patterns": [{ "include": "source.css" }]
    },
    "css-close": {
      "match": "^\\s*(</)(css)(>)\\s*$",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.spell" },
        "2": { "name": "entity.name.tag.spell" },
        "3": { "name": "punctuation.definition.tag.end.spell" }
      }
    },
    "markdown": {
      "comment": "A <markdown> line opens a block that lasts while lines aren't </markdown>:  each line is coloured past the block's indent and one more, so a # heading or a > quote counts as markdown's.",
      "begin": "^(\\s*)(<)(markdown)(>)\\s*$",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.tag.begin.spell" },
        "3": { "name": "entity.name.tag.spell" },
        "4": { "name": "punctuation.definition.tag.end.spell" }
      },
      "while": "^(?!\\s*</markdown>\\s*$)(?:\\1\\s?)?",
      "contentName": "meta.embedded.block.markdown",
      "patterns": [{ "include": "text.html.markdown" }]
    },
    "markdown-close": {
      "match": "^\\s*(</)(markdown)(>)\\s*$",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.spell" },
        "2": { "name": "entity.name.tag.spell" },
        "3": { "name": "punctuation.definition.tag.end.spell" }
      }
    },
    "comment": {
      "patterns": [
        { "name": "comment.line.double-slash.spell", "match": "//.*$" },
        { "name": "comment.line.double-dash.spell", "match": "--.*$" },
        { "name": "comment.line.number-sign.heading.spell", "match": "^\\s*#+.*$" }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.spell",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.spell", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.spell",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.spell", "match": "\\\\." }]
        }
      ]
    },
    "number": {
      "name": "constant.numeric.spell",
      "match": "(?<![\\w-])-?\\d+(\\.\\d+)?\\b"
    },
    "keyword": {
      "comment": "Generated by scripts/vscode-grammar.ts from the language packs:  English, Spanish.",
      "patterns": [
        {
          "name": "keyword.control.spell",
          "match": "^\\s*(crear\\s+un\\s+tipo\\s+nombrado|crear\\s+un\\s+tipo\\s+llamada|crear\\s+un\\s+tipo\\s+llamado|create\\s+a\\s+type\\s+called|create\\s+a\\s+type\\s+named|finalizar\\s+animacion|finalizar\\s+animación|cancelar\\s+animacion|cancelar\\s+animación|terminar\\s+animacion|terminar\\s+animación|detener\\s+animacion|detener\\s+animación|finalizar\\s+proceso|iniciar\\s+animacion|iniciar\\s+animación|cancel\\s+animation|cancelar\\s+proceso|finalizar\\s+prueba|finish\\s+animation|terminar\\s+proceso|de\\s+lo\\s+contrario|detener\\s+proceso|end\\s+print\\s+group|iniciar\\s+proceso|para\\s+actualizar|parar\\s+animacion|parar\\s+animación|terminar\\s+prueba|cancel\\s+process|empezar\\s+prueba|finish\\s+process|iniciar\\s+prueba|stop\\s+animation|terminar\\s+grupo|end\\s+animation|no\\s+hacer\\s+nada|parar\\s+proceso|otherwise\\s+if|stop\\s+process|aleatorizar|end\\s+process|esperar\\s+que|do\\s+nothing|to\\s+upgrade|animacion|animación|animation|anteponer|confirmar|crear\\s+una|create\\s+an|notificar|otherwise|pause\\s+for|preguntar|randomize|adjuntar|advertir|crear\\s+un|create\\s+a|devolver|disparar|eliminar|end\\s+test|imprimir|invertir|wait\\s+for|agregar|barajar|confirm|dibujar|else\\s+if|esperar|iniciar|limpiar|mezclar|obtener|prepend|repetir|reverse|shuffle|trigger|anadir|añadir|anexar|append|avisar|enviar|expect|lanzar|notify|pausar|prompt|quitar|remove|repeat|return|vaciar|alert|await|clear|empty|fijar|mover|poner|print|salir|si\\s+no|start|draw|echo|else|exit|fire|move|must|para|send|sino|warn|add|eco|for|get|let|por|sea|set|al|if|it|on|si|to)(?![\\p{L}\\p{M}\\d_-])"
        },
        {
          "name": "keyword.operator.word.spell",
          "match": "(?<![\\p{L}\\p{M}\\d_-])(is\\s+greater\\s+than\\s+or\\s+equal\\s+to|es\\s+mayor\\s+que\\s+o\\s+igual\\s+que|es\\s+menor\\s+que\\s+o\\s+igual\\s+que|is\\s+less\\s+than\\s+or\\s+equal\\s+to|es\\s+mayor\\s+que\\s+o\\s+igual\\s+a|es\\s+menor\\s+que\\s+o\\s+igual\\s+a|es\\s+mayor\\s+o\\s+igual\\s+que|es\\s+menor\\s+o\\s+igual\\s+que|does\\s+not\\s+start\\s+with|es\\s+mayor\\s+o\\s+igual\\s+a|es\\s+menor\\s+o\\s+igual\\s+a|does\\s+not\\s+end\\s+with|doesnt\\s+start\\s+with|does\\s+not\\s+contain|does\\s+not\\s+include|no\\s+esta\\s+definida|no\\s+está\\s+definida|no\\s+esta\\s+definido|no\\s+está\\s+definido|como\\s+mayusculas|como\\s+mayúsculas|como\\s+minusculas|como\\s+minúsculas|doesnt\\s+end\\s+with|esta\\s+indefinida|está\\s+indefinida|esta\\s+indefinido|está\\s+indefinido|is\\s+greater\\s+than|no\\s+comienza\\s+con|dividido\\s+entre|does\\s+not\\s+exist|is\\s+not\\s+defined|no\\s+empieza\\s+con|no\\s+termina\\s+con|does\\s+not\\s+have|en\\s+mayusculas|en\\s+mayúsculas|en\\s+minusculas|en\\s+minúsculas|es\\s+indefinida|es\\s+indefinido|esta\\s+definida|está\\s+definida|esta\\s+definido|está\\s+definido|comienza\\s+con|dividido\\s+por|doesnt\\s+exist|es\\s+mayor\\s+que|es\\s+menor\\s+que|is\\s+less\\s+than|is\\s+undefined|isnt\\s+defined|no\\s+acaba\\s+con|doesnt\\s+have|empieza\\s+con|no\\s+contiene|no\\s+son\\s+unas|no\\s+son\\s+unos|starts\\s+with|termina\\s+con|are\\s+not\\s+an|divided\\s+by|is\\s+defined|is\\s+neither|no\\s+esta\\s+ni|no\\s+está\\s+ni|no\\s+incluye|acaba\\s+con|are\\s+not\\s+a|ends\\s+with|is\\s+not\\s+an|no\\s+es\\s+una|no\\s+existe|no\\s+pueden|no\\s+tienen|arent\\s+an|como\\s+una|contains|contiene|includes|is\\s+not\\s+a|no\\s+es\\s+ni|no\\s+es\\s+un|no\\s+puede|no\\s+tiene|son\\s+unas|son\\s+unos|arent\\s+a|can\\s+not|como\\s+un|incluye|isnt\\s+an|no\\s+esta|no\\s+está|are\\s+an|cannot|es\\s+una|existe|exists|has\\s+no|is\\s+not|isnt\\s+a|no\\s+son|pueden|tienen|are\\s+a|as\\s+an|doesn|es\\s+un|is\\s+an|menos|minus|no\\s+es|puede|tiene|times|aren|as\\s+a|cant|como|esta|está|is\\s+a|isnt|plus|unas|unos|and|can|has|isn|las|los|mas|más|por|son|the|una|an|as|el|es|if|is|la|or|si|un|a|e|o|u|y)(?![\\p{L}\\p{M}\\d_-])"
        }
      ]
    }
  }
}
