{
  // - `yarn ts`:  checks the vitest config and parses the scripts (`allowJs`, no `checkJs`).
  // - The experiments are NOT type-checked (they never were):  they're measurement scripts, run through `tsx`, and
  //   `precedence/experiments/typescript-check.ts` is MEANT to report errors.  `tsx` still reads `paths` from here,
  //   so they get the root's `$/name` aliases (e.g. `$/spell/test`).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["scripts", "vitest.config.ts"]
}
