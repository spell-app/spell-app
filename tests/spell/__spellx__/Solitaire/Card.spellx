## A playing card -- in the outline style:  its name, then what's true of it
// The card says what its suits, ranks and colors are:  a deck, a pile or a game only reads them.
// A view:  each card is its own element on the page, e.g. `<cards-card>`.
<spell-view "card">
	# card rank
	<property "rank" one-of="ace, 2 ... 10, jack, queen, king" />
	<property "value">the position of its rank</>	// ace = 1 ... king = 13
	<alias "is a (rank)" />	// "card is a king"
	<alias "is a face card">if its rank is jack, queen or king</>	// "card is a face card"
	<alias "is a number card">if it is not a face card</>	// "card is a number card"

	## card suit
	<property "suit" one-of="clubs, diamonds, hearts or spades" />
	<alias "is a (suit)" />	// "card is a diamond"

	<property "color">
		red if its suit is diamonds or hearts
		black otherwise
	</property>

	## specific cards
	<property "name">its rank + " of " + its suit</>	// "queen of spades"
	<alias "is the (rank) of (suit)" />	// "card is the queen of spades"

	## its direction:  face up or face down
	<property "direction">up or down</>
	<alias "is face (direction)" />	// card is face up

	## turning the card over
	// each pauses a moment, so `wait for: turn the card face up` animates
	<action "turn it face up">
		set its direction to up
		pause for 50 msec
	</action>
	<action "turn it face down">
		set its direction to down
		pause for 50 msec
	</action>
	<action "turn it over">
		if it is face up: 
			await turn it face down
		otherwise: 
			await turn it face up
	</action>


	// Card picture:  drawn with special letters in the unicode character set
	// - SEE:  https://www.compart.com/en/unicode/block/U+1F0A0
	<property "picture">
		if it is face down:
			return "🂠"			// "Playing Card Back"

		column = the value of the card
		if it is a club
			return item column of ["🃑", "🃒", "🃓", "🃔", "🃕", "🃖", "🃗", "🃘", "🃙", "🃚", "🃛", "🃝", "🃞"]
		if it is a diamond
			return item column of ["🃁", "🃂", "🃃", "🃄", "🃅", "🃆", "🃇", "🃈", "🃉", "🃊", "🃋", "🃍", "🃎"]
		if it is a heart
			return item column of ["🂱", "🂲", "🂳", "🂴", "🂵", "🂶", "🂷", "🂸", "🂹", "🂺", "🂻", "🂽", "🂾"]
		if it is a spade
			return item column of ["🂡", "🂢", "🂣", "🂤", "🂥", "🂦", "🂧", "🂨", "🂩", "🂪", "🂫", "🂭","🂮"]
	</property>

	## drawing:  its picture face up, the back every card shares face down
	// on the page, a card can be dragged to another pile:  its pile's rules say which cards it gives up
	<spell>
		- it can be dragged
	</spell>
	<draw description="one letter, at the size of the text around it:  its pile scales it to fit -- styles.css">
		<text
			part="picture"
			color={its color if it is face up otherwise "blue" }
			onClick={fire event card click with card = it}>
			{its picture}
		</text>
	</draw>

	<property "symbol">
		"♣" if it is a club
		"♦" if it is a diamond
		"♥" if it is a heart
		"♠" if it is a spade
		"?" otherwise
			
	</property>
	## card "state", used for debugging
	<property "state">
		rank is 10 if its value is 10 otherwise the first letter of its rank as uppercase
		suit is its symbol
		direction is "↑" if it is face up otherwise "↓"
		return rank + suit + direction
	</property>
</spell-view>


## Tests
<spell>
	to test card setup
		get a new card whose rank is queen, suit is spades and direction is down
		echo "testing the " + its name
		its rank should be queen
		its suit should be spades
		its name should be "queen of spades"
		its color should be black
		its value should be 12
		its state should be "Q♠↓"


		it is face down should be yes
		its picture should be "🂠"
		turn it face up
		it is face up should be yes
		its picture should be "🂭"

		it is a face card should be yes
		it is not a number card should be yes

		it is a spade should be yes
		it is a club should be no

		it is a queen should be yes
		it is an ace should be no
		it is a 2 should be no

		it is the queen of spades should be yes
		it is the queen of clubs should be no
		it is the 2 of clubs should be no
		// it is the red joker should be no

		// a number card:  its rank as it is, and its picture in the row of its suit
		set seven to a new card whose rank is 7, suit is hearts and direction is up
		echo "testing the " + the name of the seven
		seven is a number card should be yes
		the color of the seven should be red
		the picture of the seven should be "🂷"
		the picture of a new card whose rank is ace and suit is clubs should be "🃑"
		the picture of a new card whose rank is king and suit is diamonds should be "🃎"
</spell>


## A joker:  a wild card with no rank or suit -- there's a red one and a black one
<spell-view "joker" template="card">
	<property "color" one-of="red or black" />
	<alias "is the (color) joker" />	// "card is the red joker"

	<spell>
		- its value is:
			53 if it is the red joker
			54 otherwise

		- its "picture" is
			return "🃟"

		- its name is its color + " joker"
	</spell>
	<property "state">
		color is (the first letter of its color) as upper case
		direction is "↑" if it is face up otherwise "↓"
		return "*" + color + direction
	</property>
</spell-view>

<spell>
	to test jokers
		get a new joker whose color is red and direction is up
		echo it
		it is a card should be yes
		it is a joker should be yes
		its color should be red
		its name should be "red joker"
		its state should be "*R↑"
		its picture should be "🃟"
		it is the red joker should be yes
		it is the black joker should be no
		it is not the black joker should be yes

		it is face up should be yes
		turn it over
		it is face down should be yes

		set black joker to a new joker whose color is black
		the picture of black joker should be "🃟"

		set the card to a new card whose rank is queen and suit is spades
		the card is a joker should be no
		the card is not a joker should be yes
		the card is the red joker should be no
</spell>
