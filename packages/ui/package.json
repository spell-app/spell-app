  "scripts": {
    "dev": "vite --open /tools/demo/index.html",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf ./.cache ./build ./dist ./coverage ./test-results ./vendor ./tools/frameworks/solid/dist",
    "/////// CORRECTNESS": "",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "ts": "echo '>>>>>>>>>>>\n>> RUNNING TSC' && tsc && tsc -p tsconfig.node.json && yarn fork tsc && echo '<< TSC PASSED\n'",
    "lint": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT' && oxlint --report-unused-disable-directives --max-warnings 0 src test scripts tools && yarn fork lint && echo '<< OXLINT PASSED\n'",
    "lint:fix": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT --fix' && oxlint --fix src test scripts tools && yarn fork lint && echo '<< OXLINT PASSED\n'",
    "format": "echo '>>>>>>>>>>>\n>> FORMATTING WITH OXFMT' && oxfmt . && echo '<< OXFMT PASSED\n'",
    "format:check": "oxfmt --check .",
    "/////// TESTING": "",
    "test": "echo '>>>>>>>>>>>\n>> RUNNING TESTS' && vitest run --project ssr && vitest run --project browser && yarn test:fork && echo '<< TESTS PASSED\n'",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:all": "vitest run --project ssr && UI_TEST_ALL=1 vitest run --project browser",
    "test:visual": "tsx tools/visual/cli.ts",
    "test:visual:update": "tsx tools/visual/cli.ts --update",
    "test:fork": "yarn fork test",
    "test:hmr": "tsx tools/hmr.e2e.ts",
    "test:browsers": "playwright install chromium firefox webkit",
    "/////// FORK (../solid-element, a workspace)": "",
    "fork": "yarn workspace @spell-app/solid-element",
    "fork:install": "yarn install",
    "fork:build": "yarn workspace @spell-app/solid-element build",
    "/////// PACKAGE TOOLING (tools/)": "",
    "vendor": "tsx tools/cli.ts vendor",
    "measure": "tsx tools/cli.ts measure",
    "smoke": "vite build --logLevel warn && tsx tools/cli.ts declarations && tsx tools/cli.ts smoke",
    "serve": "tsx tools/cli.ts serve",
    "report": "tsx tools/cli.ts report",
    "icons:pack": "tsx tools/cli.ts icons:pack",
    "screenshots": "tsx tools/screenshots.ts",
    "/////// DOCS SITE": "",
    "site:dev": "yarn --cwd site dev",
    "site:build": "yarn --cwd site build",
    "site:preview": "yarn --cwd site preview",
    "site:check": "yarn --cwd site check",
    "/////// GENERATED": "",
    "gen:styles": "tsc -p scripts && tsx scripts/gen-styles.ts",
    "gen:icons": "tsc -p scripts && tsx scripts/gen-icons.ts",
    "gen:emoji": "tsc -p scripts && tsx scripts/gen-emoji.ts",
    "gen:root": "tsc -p scripts && tsx scripts/gen-root-catalog.ts",
    "tokens:alias": "tsx scripts/alias-tokens.ts",
    "/////// MANIFEST": "",
    "manifest": "custom-elements-manifest analyze --globs 'src/**/*.ts' 'src/**/*.tsx' --exclude 'src/**/*.test.ts' --exclude 'src/**/*.test.tsx'"
  },
