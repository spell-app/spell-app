## Klondike Solitaire
-- See [wikipedia](https://en.wikipedia.org/wiki/Klondike_(solitaire)) for its rules, and what each pile is called.
// The cards, the deck and the piles are this project's own:  Card, Deck and Pile.
// This file adds the game, its kinds of piles, what each may take or give up, and how each is laid out.
// What's where, top to bottom:
//   the solitaire:  its piles, its moves, auto play and drawing
//   playing a card:  what a click or a drag does
//   start
//   the piles:  each kind, what it may take or give up, and how it lies
//   tests


## The solitaire:  its piles, its moves, auto play and drawing
<spell-app "solitaire">
	<property "score">a number</>
	// what the move being dragged would add to the score, e.g. " (+10)":  shown beside it, while a card is over a pile
	<property "hint">text</>
	<property "deck">a new deck</>

	<property "stock" description="one of each pile, made with the solitaire">a new stock pile with name = "stock"</>
	<property "discards">a new discard pile with name = "discards"</>
	<property "clubs">a new foundation with name = "clubs", suit = clubs</>
	<property "diamonds">a new foundation with name = "diamonds", suit = diamonds</>
	<property "hearts">a new foundation with name = "hearts", suit = hearts</>
	<property "spades">a new foundation with name = "spades", suit = spades</>
	<property "T1">a new tableau with name = "T1"</>
	<property "T2">a new tableau with name = "T2"</>
	<property "T3">a new tableau with name = "T3"</>
	<property "T4">a new tableau with name = "T4"</>
	<property "T5">a new tableau with name = "T5"</>
	<property "T6">a new tableau with name = "T6"</>
	<property "T7">a new tableau with name = "T7"</>

	// once, as the solitaire is made:  every card of the deck into the stock
	// - its deck and piles are made with it, before this runs
	// - inside the loop `it` is the card:  so the stock is `the stock of solitaire`
	<action "create it">
		for each card in its deck
			add it to the stock of solitaire
	</action>

	// print each pile's cards, e.g. "stock: Q♠↓ 7♥↓"
	<action "debug it">
		for each pile in every pile
			print the state of the pile
	</action>

	<action "reset the stock" description="the discards, turned over, back into the stock">
		set cards to a copy of list (its discards) as a pile
		reverse the cards
		for each card in the cards
			add it to the stock of the solitaire
			turn the card face down
	</action>

	// turn the stock's next card over, onto the discards
	<spell>
		- animation play from the stock:
			if its stock is empty
				wait for: reset the stock

			get the last card of its stock
			turn it face up
			add it to the discards of the solitaire

		// gather every card of its deck into the stock, shuffle it, and deal the tableaus:  one card more in each, left to right
		- animation deal the cards:
			for each card in its deck
				set start pile to the pile of the card
				turn the card face down
				if start pile is not the stock of the solitaire
					add the card to the stock of the solitaire
					pause for 50 msec
			shuffle its stock

			for row from 1 to 7
				turn the last card of its stock face up
				for column from row to 7
					add the last card of its stock to item column of the tableaus
					pause for 50 msec

			wait for: play from the stock
	</spell>

	<action "start a new game">
		clear its score
		clear its hint
		deal the cards
	</action>

	<action "cheat" description="turn up a face-down card from a tableau, at random, onto the discards">
		set remaining piles to piles in the tableaus where it is not empty and its first card is face down
		if remaining piles is empty return
		set the pile to a random pile in remaining piles
		set hidden cards to the cards in the pile where the card is face down
		set the card to a random card in hidden cards
		turn the card face up
		pause for 30 ticks
		add the card to the discards of the solitaire
	</action>

	<action "auto play" description="play every card that can go somewhere, until none can">
		set anything changed to no
		if its discards is not empty
			set test card to the last card of its discards
			if await play test card
				set anything changed to yes
				pause for 500 msec

		// each tableau's last card onto its foundation
		for each pile in the tableaus
			if the pile is empty return
			set test card to the last card of the pile
			set foundation to the first pile in the foundations where its suit is the suit of test card
			if the foundation can take test card
				set anything changed to yes
				await play test card
				pause for 100 msec

		// each tableau's face-up cards, all together, onto another tableau
		for each pile in the tableaus
			set face up cards to the cards in the pile where the card is face up
			if face up cards is empty return
			set test card to the first card of face up cards
			if test card is a king and test card is the first card of the pile return
			if await play test card
				set anything changed to yes
				pause for 500 msec

		if anything changed await auto play
	</action>

	// its menu, then its piles:  seven to a line, each a cell of its own, the third left empty
	// - its buttons are icons, each with a tooltip:  the popup right after its icon shows as the pointer rests on it
	<spell>
		- to draw it:
			return <ui-container>
				<ui-menu>
					<ui-item type="header">Klondike Solitaire</ui-item>
					<ui-item>{"Score: " + its score + its hint}</ui-item>
					<ui-menu position="right">
						<ui-item aria-label="Auto play" onClick={auto play}>
							<ui-icon name="fast forward"/>
							<ui-popup content="Auto play" inverted size="small"/>
						</ui-item>
						<ui-item aria-label="Cheat" onClick={cheat}>
							<ui-icon name="eye"/>
							<ui-popup content="Cheat" inverted size="small"/>
						</ui-item>
						<ui-item aria-label="Restart" onClick={start a new game}>
							<ui-icon name="redo"/>
							<ui-popup content="Restart" inverted size="small"/>
						</ui-item>
					</ui-menu>
				</ui-menu>
				<ui-grid class="Board" columns="7">
					{draw its stock}
					{draw its discards}
					<div/>
					{draw its clubs}
					{draw its diamonds}
					{draw its hearts}
					{draw its spades}
					{draw its T1}
					{draw its T2}
					{draw its T3}
					{draw its T4}
					{draw its T5}
					{draw its T6}
					{draw its T7}
				</ui-grid>
			</ui-container>
	</spell>
</spell-app>


## Playing a card:  what a click or a drag does
// the card, and every card on it, onto the first pile that can take it;  it says whether it moved
// - the stock's card is turned over onto the discards instead
<spell>
	to play a card
		if the pile of the card is the stock of the solitaire
			play from the stock
			return

		set end pile to the first pile in every pile where it can take the card
		if there is not an end pile return no
		return put the card on end pile

	// the card, and every card on it, onto the pile, if the piles' rules let it go and take it;  it says whether it moved
	// - the pile it left turns its new last card up, and the move scores
	to put a card on a pile
		set start pile to the pile of the card
		if start pile cannot give up the card return no
		if the pile cannot take the card return no
		set points to count the points for the card on the pile

		set moving cards to cards in start pile starting with the card
		set the name of moving cards to the name of the start pile
		print "moving (" + the state of moving cards + ") to (" + the state of the pile + ")"

		for each card in moving cards
			move it to the pile

		if the start pile is a tableau and the start pile is not empty
			pause for 200 msec
			get the last card of the start pile
			print "turning over (" + the name of start pile + ": " + its state + ")"
			turn it face up

		set the score of the solitaire to the score of the solitaire + points
		return yes

	// what putting the card on the pile scores:  10 on a foundation, 5 from the discards, else nothing
	to count the points for a card on a pile
		if the pile is a foundation return 10
		if the pile of the card is the discards of the solitaire return 5
		return 0

	// a click plays the card;  a drag puts it where it's dropped
	on card click with a card
		play the card

	a pile:
		// while a card it would take is over it, the score shows what the move would add -- gone as the card leaves
		- while a card is dragged over it:
			set points to count the points for the card on it
			if it can take the card and points > 0: set the hint of the solitaire to " (+" + points + ")"
		- when a card is dropped on it:
			put the card on it


	## Start
	print solitaire
	start a new game
	start solitaire
</spell>


## The piles:  each kind, what it may take or give up, and how it lies
// Each pile is a viewable list:  an element of its own, e.g. `<solitaire-tableau>`, around its cards' elements.
// How its cards lie is its layout:  styles.css draws each one.
// While it's empty, it shows its placeholder, if it has one.

// the stock:  the cards not played yet, face down;  a click turns the next one over
<spell-thing "stock pile" template="pile">
	<spell>
		- its layout is stacked
		// a click turns its card over:  none can be taken from it, so none can be dragged
		- it can never take a card
		- it can never let go of a card
		// empty:  a light grey card, face down -- a click turns the discards back over
		- to draw its placeholder:
			return <div part="placeholder" onClick={play from the stock}>🂠</div>
	</spell>
</spell-thing>

// the discards:  where the stock's cards go as they're turned over
<spell-thing "discard pile" template="pile">
	<spell>
		- its layout is stacked
		- it can never take a card
		- it can give up a card if: the card is its last card
	</spell>
</spell-thing>

// a foundation:  where a suit is built up, ace to king
<spell-thing "foundation" template="pile">
	<spell>
		- its layout is stacked
	</spell>
	<property "suit">a card suit</>
	<spell>
		- it can never let go of a card
		// one card at a time:  the last of its pile
		- it can take a card if:
			if the card is not the last card of the pile of the card return no
			return its suit is the suit of the card and its value + 1 is the value of the card
		// empty:  a light grey ace of its suit, face up
		- to draw its placeholder:
			return <div part="placeholder">{the picture of a new card whose rank is ace, suit is its suit and direction is up}</div>
	</spell>
</spell-thing>

// a tableau:  a column, built down from king to ace, red and black in turn
<spell-thing "tableau" template="pile">
	<spell>
		- its layout is vertical
		- it can give up a card if: the card is face up
		- it can take a card if:
			if it is empty
				return the card is a king
			return its color is not the color of the card and its value is the value of the card + 1
	</spell>
</spell-thing>


## Tests
<spell>
	to test the moves
		set the column to a new tableau with name = "T1"
		set the king to a new card whose rank is king, suit is spades and direction is up
		set the queen to a new card whose rank is queen, suit is hearts and direction is up
		set the jack to a new card whose rank is jack, suit is clubs and direction is up
		// an empty tableau takes only a king, then one lower in the other color
		the column can take the queen should be no
		the column can take the king should be yes
		add the king to the column
		the column can take the jack should be no
		the column can take the queen should be yes
		add the queen to the column
		the state of the column should be "T1: K♠↑ Q♥↑"
		the column can give up the queen should be yes
		turn the queen face down
		the column can give up the queen should be no

		// a foundation takes its suit, ace first, then one higher:  each the last card of its pile
		set the foundation to a new foundation with name = "hearts", suit = hearts
		set the two to a new card whose rank is 2, suit is hearts and direction is up
		set the ace to a new card whose rank is ace, suit is hearts and direction is up
		set the column to a new tableau with name = "T2"
		add the two to the column
		add the ace to the column
		the foundation can take the two should be no
		the foundation can take the ace should be yes
		move the ace to the foundation
		the foundation can take the two should be yes
		add the queen to the column
		the foundation can take the queen should be no
</spell>
