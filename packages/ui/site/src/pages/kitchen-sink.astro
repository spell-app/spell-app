---
/**
 * Kitchen sink:  every component family's MAIN example on one page, live, to judge a theme at a glance.
 * - The main example is the family's `types.html`, else its first `.html` alphabetically
 *   (`src/components/ui-<family>/examples/elements/`), read raw at build time and rendered with `set:html`:  no copies.
 * - Families without an element example (`item`:  `items` shows it) are left out.
 * - Measured when this page was built (2026-10-01):  no duplicate `id`s among the chosen files, no inline
 *   `<script>`s, and none opens an overlay at load (page dimmer, modal, flyout, sidebar are all closed;  the
 *   `active` dimmers are contained in a segment).  If a future example breaks that, the `id`s need a per-family
 *   prefix (`commandfor`, `for` ... refer to them by id) and a pre-opened overlay needs the family's next example.
 * - Component families load through the `<ui-root>` that wraps every `Docs` page.
 */
import Docs from "../layouts/Docs.astro"
import { url } from "../lib/nav"

const EXAMPLES = import.meta.glob("$/ui/components/*/examples/elements/*.html", {
  query: "?raw",
  import: "default",
  eager: true
}) as Record<string, string>

/** Family => its example files (path => markup), in path order. */
const byFamily = new Map<string, [string, string][]>()
for (const [path, html] of Object.entries(EXAMPLES).sort(([a], [b]) => a.localeCompare(b))) {
  const family = /\/components\/([^/]+)\/examples\/elements\//.exec(path)?.[1]
  if (!family) continue
  byFamily.set(family, [...(byFamily.get(family) ?? []), [path, html]])
}

const sections = [...byFamily]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([family, files]) => {
    const [, html] = files.find(([path]) => path.endsWith("/types.html")) ?? files[0]
    return { family, html }
  })
---

<Docs
  title="Kitchen sink"
  summary="Every component family's main example on one page, live:  a quick way to judge a theme."
  wide
>
  <div class="ui-stack ui-gap-l site-kitchen-sink">
    {
      sections.map(({ family, html }) => (
        <section class="ui-stack ui-gap-s" id={family}>
          <h2 class="site-anchored">
            <a href={url(`/components/${family}/`)}>{family}</a>
          </h2>
          <div class="site-example-box">
            <div class="site-example-demo" set:html={html} />
          </div>
        </section>
      ))
    }
  </div>
</Docs>
