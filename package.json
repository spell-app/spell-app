{
  "name": "spell-parser",
  "version": "0.8.0",
  "license": "MIT",
  "repository": "https://github.com/oakjs/parser",
  "type": "module",
  "scripts": {
    "start": "yarn && yarn stop && concurrently \"yarn start:dev\" \"yarn start:server\"",
    "stop": "pkill -f \"$PROJECT_CWD/node_modules/(concurrently/|vite/|tsx/|\\.bin/tsx)\"; echo \"Stopped spell servers\"",
    "start:dev": "vite",
    "start:server": "tsx watch src/server/index.ts",
    "start:server:prod": "tsx src/server/index.ts",
    "start:lsp": "tsx src/lsp/server.ts --stdio",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf ./.cache; rm -rf ./build",
    "/////// CORRECTNESS": "",
    "review": "yarn ts; yarn lint:fix; yarn format; yarn test; echo '== REVIEW PASSED\n===========\n'",
    "ts": "echo '>>>>>>>>>>>\n>> RUNNING TSC'; yarn tsc; echo '<< TSC PASSED\n'",
    "lint": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT'; oxlint --report-unused-disable-directives --max-warnings 0; echo '<< OXLINT PASSED\n'",
    "lint:fix": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT --fix'; oxlint --fix; echo '<< OXLINT PASSED\n'",
    "format": "echo '>>>>>>>>>>>\n>> FORMATTING WITH OXFMT'; oxfmt .; echo '<< OXFMT PASSED\n'",
    "format:check": "oxfmt --check .",
    "/////// TESTING": "",
    "test": "echo '>>>>>>>>>>>\n>> RUNNING TESTS'; vitest run;  echo '<< TESTS PASSED\n'",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "/////// VSCODE EXTENSION": "",
    "vscode": "yarn vscode:build && yarn vscode:install",
    "vscode:build": "cd vscode-extension && yarn install && yarn build && yarn package",
    "vscode:install": "cd vscode-extension && yarn install-extension",
    "/////// DOCKER (out of date)": "",
    "docker": "docker compose up",
    "docker-bg": "docker compose up --detach",
    "docker-build": "docker compose build"
  },
  "dependencies": {
    "@nx-js/observer-util": "^4.2.2",
    "@reach/router": "^1.3.4",
    "@risingstack/react-easy-state": "^6.3.0",
    "@types/pluralize": "^0.0.33",
    "any-base": "^1.1.0",
    "assert": "^2.0.0",
    "body-parser": "^1.19.0",
    "browser-or-node": "^3.0.0",
    "chalk": "^5.6.0",
    "classnames": "^2.2.6",
    "express": "^4.18.2",
    "express-json5": "^0.1.0",
    "fs-extra": "^11.3.0",
    "global": "^4.3.2",
    "history": "^4.7.2",
    "json5": "^2.1.1",
    "languages": "^0.1.3",
    "lodash": "^4.17.21",
    "lodash-inflection": "^1.5.0",
    "monaco-editor": "^0.57.0",
    "node-filter-async": "^3.0.0",
    "node-storage-shim": "^2.0.1",
    "path": "^0.12.7",
    "pluralize": "^8.0.0",
    "prop-types": "^15.8.1",
    "proper-lockfile": "^3.2.0",
    "query-string": "^6.12.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^2.1.3",
    "react-keydown": "^1.7.2",
    "react-router-dom": "^6.22.3",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "3.0.0-beta.2",
    "uuid": "^8.2.0",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22",
    "@types/proper-lockfile": "^4.1.4",
    "@types/reach__router": "^1.3.15",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.5",
    "less": "^4",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "^1.63.0",
    "tsx": "^4.7.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "browserslist": "> 1%, node > 22",
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "yarn@4.18.0"
}
