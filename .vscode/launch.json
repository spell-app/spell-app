{
  "version": "0.2.0",
  "configurations": [
    {
      // F5:  a new VS Code window with the spell extension (`vscode-extension/`), on the Solitaire example.
      "name": "Run Spell Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/src/examples/Solitaire"
      ],
      "outFiles": ["${workspaceFolder}/vscode-extension/out/**/*.js"],
      "preLaunchTask": "Build Spell Extension"
    }
  ]
}
