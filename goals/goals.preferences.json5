// Preferences for the goals tools:  the /goals skills, `yarn goals`, `spell goals`, and their pages on the page server.
// JSON5:  comments and trailing commas are fine.  `yarn goals use <set>` rewrites `activeSet` and keeps the rest.
{
  // the goal set a target without one means:  `motivation/G1` -> `spell/motivation/G1`
  activeSet: "spell",

  // the page server (`yarn server`):  `port` is the one it asks for first;  taken, it takes any free one
  server: {
    port: 4747,
  },

  // where `/goals-open` shows a page, in a NEW window:  "Google Chrome", "Safari", or "default" (the system's)
  browser: "Google Chrome",

  // where a Claude session starts from a page's buttons:  "Terminal" or "iTerm"
  terminal: "Terminal",

  claude: {
    // the Claude Code command
    command: "claude",
    // extra arguments for every session, e.g. ["--permission-mode", "acceptEdits"]
    args: [],
  },

  // labels of the three goal horizons on new topic pages
  horizons: {
    now: "Now → December 2026",
    next: "2027",
    someday: "Someday",
  },
}
