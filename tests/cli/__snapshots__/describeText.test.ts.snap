// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`describeOverview() > a file:  each thing it declares, a type's members grouped 1`] = `
"Card.spell
  type Card  is a Drawable
    The card says what its suits, ranks and colors are:  a deck, a pile or a game only reads them.
    Properties  rank, value, suit, color, name, direction, picture, symbol, state, pile
    Actions     is a (rank), is a face card, is a number card, is a (suit), is the (rank) of (suit),
                is face (direction), turn it face up, turn it face down, turn it over, draw it,
                play a card
    Constants   Ranks (ace, jack, queen, king), Suits (clubs, diamonds, hearts, spades),
                Directions (up, down)
  function test card setup
  type Joker  is a Card
    A joker:  a wild card with no rank or suit -- there's a red one and a black one
    Properties  color, value, picture, name, state
    Actions     is the (color) joker
    Constants   Colors (red, black)
  function test jokers"
`;

exports[`describeThing() > a property, with its compiled javascript 1`] = `
"property color of Card
Card.spell:16

Spell
    - its "color" is:                      
      red if its suit is diamonds or hearts
      black otherwise

Compiled
  Object.defineProperty(Card.prototype, "color", {
    get() {
      if (core.includes(["diamonds", "hearts"], this.suit)) return "red"
      return "black"
    },
    configurable: true
  })"
`;

exports[`describeThing() > a type 1`] = `
"type Card is a Drawable
Card.spell:4

The card says what its suits, ranks and colors are:  a deck, a pile or a game only reads them.
A drawable thing:  each card is its own element on the page, e.g. <cards-card>.

Properties  rank, value, suit, color, name, direction, picture, symbol, state, pile
Actions     is a (rank), is a face card, is a number card, is a (suit), is the (rank) of (suit),
            is face (direction), turn it face up, turn it face down, turn it over, draw it,
            play a card
Constants   Ranks (ace, jack, queen, king), Suits (clubs, diamonds, hearts, spades),
            Directions (up, down)

Spell
  a "card" is a drawable thing where:
    # card rank
    - its "rank" is one of ace, 2 ... 10, jack, queen, king
     - its "value" is the position of its rank              // ace = 1 ... king = 13
    - it "is a (rank)"                      // "card is a king"
    - it "is a face card" if its rank is jack, queen or king  // "card is a face card"
    - it "is a number card" if it is not a face card      // "card is a number card"
  
    ## card suit
    - its "suit" is one of clubs, diamonds, hearts or spades
    - it "is a (suit)"                      // "card is a diamond"
  
    - its "color" is:                      
      red if its suit is diamonds or hearts
      black otherwise
  
    ## specific cards
    - its "name" is its rank + " of " + its suit        // "queen of spades"
    - it "is the (rank) of (suit)"                // "card is the queen of spades"
  
    ## its direction:  face up or face down
    - its "direction" is up or down
    - it "is face (direction)"                  // card is face up
  
    ## turning the card over
    // each pauses a moment, so \`wait for: turn the card face up\` animates
    - to turn it face up:
      set its direction to up
      pause for 50 msec
    - to turn it face down:
      set its direction to down
      pause for 50 msec
    - to turn it over:
      if it is face up: 
        await turn it face down
      otherwise: 
        await turn it face up
  
  
    // Card picture:  drawn with special letters in the unicode character set
    // - SEE:  https://www.compart.com/en/unicode/block/U+1F0A0
    - its "picture" is:
      if it is face down:
        return "🂠"      // "Playing Card Back"
  
      column = the value of the card
      if it is a club
        return item column of ["🃑", "🃒", "🃓", "🃔", "🃕", "🃖", "🃗", "🃘", "🃙", "🃚", "🃛", "🃝", "🃞"]
      if it is a diamond
        return item column of ["🃁", "🃂", "🃃", "🃄", "🃅", "🃆", "🃇", "🃈", "🃉", "🃊", "🃋", "🃍", "🃎"]
      if it is a heart
        return item column of ["🂱", "🂲", "🂳", "🂴", "🂵", "🂶", "🂷", "🂸", "🂹", "🂺", "🂻", "🂽", "🂾"]
      if it is a spade
        return item column of ["🂡", "🂢", "🂣", "🂤", "🂥", "🂦", "🂧", "🂨", "🂩", "🂪", "🂫", "🂭","🂮"]
  
    ## drawing:  its picture face up, the back every card shares face down
    - to draw it:
      return 
        <ui-text 
          class="Card" 
          size="massive" 
          color={its color if it is face up otherwise "blue" }
          onClick={fire event card click with card = it}>
          {its picture}
        </ui-text>
    <css>
      /* a card is a card-sized box:  its size is the board's, --card-width x --card-height in styles.css */
      :host {
        display: block;
        position: relative;
        width: var(--card-width);
        height: var(--card-height);
        overflow: hidden;
        cursor: pointer;
      }
      /* its picture, a character of unicode's Playing Cards:  moved so the card it draws fills the box */
      ui-text::part(text) {
        position: absolute;
        left: -0.049em;
        top: -0.222em;
      }
    </css>
  
    - its "symbol" is:
      "♣" if it is a club
      "♦" if it is a diamond
      "♥" if it is a heart
      "♠" if it is a spade
      "?" otherwise
        
    ## card "state", used for debugging
    - its "state" is: 
      rank is 10 if its value is 10 otherwise the first letter of its rank as uppercase
      suit is its symbol
      direction is "↑" if it is face up otherwise "↓"
      return rank + suit + direction"
`;
