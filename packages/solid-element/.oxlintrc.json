{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import"],

  // `correctness` ~== what `eslint:recommended` + `tseslint:recommended` used to give us.
  "categories": { "correctness": "error" },

  // NOTE: `options.typeAware` is only allowed in the ROOT config (a nested copy breaks the root `oxlint .`).

  // Nested config:  the root `yarn lint` reaches this package too;  this copy lints it against its own files.
  "ignorePatterns": ["dist", ".yarn", ".vitest", "node_modules"],

  // NOTE: only rules that DIFFER from the `correctness` defaults belong here.
  "rules": {
    // `tsc` already reports these via `noUnusedLocals` -- avoid duplicate diagnostics.
    "no-unused-vars": "off",
    "typescript/no-unused-vars": "off",
    // DOM bridges take `any` deliberately;  keep it greppable, not banned.
    "typescript/no-explicit-any": "off",

    "prefer-const": ["error", { "destructuring": "all" }]
  }
}
