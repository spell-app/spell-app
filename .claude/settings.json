{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(perl -pi -e ' *)",
      "Bash(grep -v \"^src/app/store.ts$\")",
      "Bash(git restore *)",
      "Bash(yarn *)",
      "Bash(npx *)",
      "Bash(git *)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree.mjs\" create" }] }
    ],
    "WorktreeRemove": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree.mjs\" remove" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-gate.mjs\"" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff.mjs\"" }] }
    ]
  }
}
