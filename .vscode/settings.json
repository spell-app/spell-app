{
  // Linting is oxlint (see `.oxlintrc.json`); the ESLint extension is no longer used here.
  "oxc.enable": true,
  // Formatting is oxfmt (see `.oxfmtrc.json`); the Prettier extension is no longer used here.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "oxc.lint.run": "onType",
  "javascript.validate.enable": false,
  "[javascript]": {
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.formatOnSave": true
  },

  // requires only if you use vetur plugin
  "vetur.validation.script": false,
  "js/ts.experimental.useTsgo": false
}
