    {
      "tag": "epic-phase",
      "name": "epic-phase",
      "folder": "epic-phase",
      "mainTag": "epic-phase",
      "main": true,
      "page": true,
      "href": "epic-phase.html",
      "topics": [
        "page"
      ],
      "aka": [
        "phase",
        "milestone",
        "step",
        "stage"
      ],
      "description": "One phase of the plan:  its status icon and estimate in its title line;  its fields (Symptom, Changes, Requests, Goal), Owen's kept notes, its plan changes (`<epic-update>` blocks, at the end of its description), then Done, commits, Files, Verify and To review, as children in that order.  While the page is reviewed, it takes review notes as an Overview sub-section does:  Revisit, Make Todo, Do Now.",
      "noun": "phase",
      "attributes": [
        {
          "name": "id",
          "kind": "string",
          "property": "epicId",
          "description": "Stable, made from its name when it's added, and kept through renames and inserts:  `p-epic-migrate` (an older page's `p2`, until `stable-phase-ids`).  Links and comments use it (`#p-epic-migrate`);  the number shown, `P2 · <title>`, is its place among the phases."
        },
        {
          "name": "title",
          "kind": "string",
          "property": "epicTitle",
          "description": "Its short name, 2-4 words, WITHOUT its id (`Saved Replies`, drawn as `P1 · Saved Replies`)."
        },
        {
          "name": "status",
          "kind": "enum",
          "values": [
            "todo",
            "active",
            "done"
          ],
          "description": "`todo`, `active` (one at a time, blue:  under way) or `done` (green)."
        },
        {
          "name": "estimate",
          "kind": "string",
          "description": "Wall-clock time for Claude to do it, agents included, Owen's review not:  `30m`, `2h`, `1h30m`, `1-2h`."
        },
        {
          "name": "source",
          "kind": "string",
          "description": "Its body's part file (`parts/p2.html`), loaded into its children when it opens."
        },
        {
          "name": "part-ids",
          "kind": "string",
          "description": "The ids inside its part file:  a link to one loads the body first, then lands."
        },
        {
          "name": "commits",
          "kind": "boolean",
          "description": "Its body lists commits (the page's git buttons)."
        },
        {
          "name": "changes",
          "kind": "number",
