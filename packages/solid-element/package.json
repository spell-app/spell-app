{
  "name": "@spell-app/solid-element",
  "version": "0.0.0",
  "private": true,
  "description": "Custom elements for Solid 2:  a fork of @solidjs/element + component-register with upgrade, form, lifecycle and error-boundary fixes",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "vp build && vp build -c vite.node.config.ts",
    "test": "vp test run",
    "tsc": "tsc",
    "measure": "node --experimental-strip-types --no-warnings scripts/measure.ts",
    "lint": "vp lint --report-unused-disable-directives --max-warnings 0 src scripts *.ts",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "devDependencies": {
    "@solidjs/element": "2.0.0-rc.13",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@solidjs/web": "2.0.0-rc.13",
    "@types/node": "22.20.4",
    "@vitest/browser-playwright": "catalog:",
    "component-register": "0.8.8",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "solid-js": "2.0.0-rc.13",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.13",
    "solid-js": "2.0.0-rc.13"
  },
  "packageManager": "yarn@4.18.0"
}
