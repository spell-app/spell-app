{
  "$comment": "HAND-KEPT facts of the brand's docs set, read by `yarn site:data` in packages/brand (scripts/site-data.ts), which writes components.json5 and search.json5 beside this.  `families`:  Spell UI's per-family facts (title, summary, status ...;  `SitePagesFile` in packages/ui/src/docs-components/docs-components.types.ts), a new family seeded here once.  `groups`:  the side column's groups, in order;  a tag no group names shows under Other.  `nav`:  the side column's own links (`file` relative to the set's root, `/components/brand/`) and band titles (`SiteNav`).",
  "families": {
    "brand-blob": {
      "title": "Brand blob",
      "summary": "A brand blob tucks one soft lavender shape into a corner of its parent, never behind body text.",
      "status": "done"
    },
    "brand-checklist": {
      "title": "Brand checklist",
      "summary": "A brand checklist shows a build's progress step by step, or a list of things to tick off, each with a round mark.",
      "status": "done"
    },
    "brand-color": {
      "title": "Brand color",
      "summary": "A brand color is a square colour chip:  a label inside, an AA mark, a selected ring, a details tip;  click to copy.",
      "status": "done"
    },
    "brand-color-picker": {
      "title": "Brand color picker",
      "summary": "A brand color picker chooses a colour by lightness and colourfulness for a hue, or by typing its hex or OKLCH.",
      "status": "done"
    },
    "brand-color-range": {
      "title": "Brand color range",
      "summary": "A brand color range is a 17-step ladder of shades made from one base colour, the base colour's step ringed.",
      "status": "done"
    },
    "brand-color-set": {
      "title": "Brand color set",
      "summary": "A brand color set lays out colour chips in a row or a grid;  `selectable` makes it a radio group to pick one.",
      "status": "done"
    },
    "brand-composer": {
      "title": "Brand composer",
      "summary": "A brand composer is the box where you describe an app in plain words and cast it:  a serif text box, tool chips, a keyboard hint and a round Cast button.",
      "status": "done"
    },
    "brand-flourish": {
      "title": "Brand flourish",
      "summary": "A brand flourish draws generated page art (swoops, blobs, curls, sparkles) behind its parent's content.",
      "status": "done"
    },
    "brand-logo": {
      "title": "Brand logo",
      "summary": "The Spell logo:  the hat mark, or the mark with the wordmark (and tagline), outlined, in one colour.",
      "status": "done"
    },
    "brand-phone": {
      "title": "Brand phone",
      "summary": "A brand phone frames live app content as a phone:  a status bar on top, the app below.",
      "status": "done"
    }
  },
