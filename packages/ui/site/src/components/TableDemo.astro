---
/**
 * Live demo for the table page's "Data mode" example:  `rows` and `columnDefs` are JS PROPERTIES, so they have to
 * be set from a script -- MDX can't bundle one, hence this component.
 * - The element renders its own `<table>` into its light DOM from `rows`, sortable by header.
 * - Also shows the last `ui-sort` event's `detail` under the table.
 */
---

<div class="ui-stack ui-gap-s" data-table-demo>
  <ui-table celled striped sortable aria-label="Planets" data-rows></ui-table>
  <p class="ui-caption ui-m-0">Last sort:  <output data-output>none yet</output></p>
</div>

<script>
  import "$/ui/components/table"

  type DataTable = HTMLElement & { rows: unknown[]; columnDefs: unknown[] }

  for (const demo of document.querySelectorAll<HTMLElement>("[data-table-demo]")) {
    const table = demo.querySelector<DataTable>("[data-rows]")!
    const output = demo.querySelector("[data-output]")!
    table.columnDefs = [
      { key: "name", header: "Planet" },
      { key: "moons", header: "Moons", textAlign: "right" },
      { key: "day", header: "Day (hours)", textAlign: "right" }
    ]
    table.rows = [
      { name: "Mercury", moons: 0, day: 4222.6 },
      { name: "Venus", moons: 0, day: 2802 },
      { name: "Earth", moons: 1, day: 24 },
      { name: "Mars", moons: 2, day: 24.7 },
      { name: "Jupiter", moons: 95, day: 9.9 }
    ]
    table.addEventListener("ui-sort", (event) => {
      const { column, key, direction } = (event as CustomEvent).detail
      output.textContent = JSON.stringify({ column, key, direction })
    })
  }
</script>
