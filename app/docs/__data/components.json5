  "foundation": [
    {
      "id": "typography",
      "title": "Typography",
      "description": "Font size, families, weights and line heights.  `--ui-font-size` is the ONE absolute length.",
      "tokens": [
        {
          "name": "--ui-font-size",
          "default": "16px",
          "description": "Base font size, in px:  everything else is `em` of it.",
          "type": "length"
        },
        {
          "name": "--ui-font-family",
          "default": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", \"Noto Sans\", \"Liberation Sans\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
          "description": "Body font stack.",
          "type": "other"
        },
        {
          "name": "--ui-font-family-heading",
          "default": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", \"Noto Sans\", Arial, sans-serif",
          "description": "Font stack for headings.",
          "type": "other"
        },
        {
          "name": "--ui-font-family-mono",
          "default": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
          "description": "Font stack for code.",
          "type": "other"
        },
        {
          "name": "--ui-font-family-emoji",
          "default": "\"Apple Color Emoji\", \"Segoe UI Emoji\", \"Noto Color Emoji\", \"Twemoji Mozilla\", \"Segoe UI Symbol\"",
          "description": "Font stack for emojis.",
          "type": "other"
        },
        {
          "name": "--ui-font-weight-light",
          "default": "300",
          "description": "Font weight `light`.",
          "type": "number"
        },
        {
          "name": "--ui-font-weight-normal",
          "default": "400",
          "description": "Font weight `normal`.",
          "type": "number"
        },
        {
          "name": "--ui-font-weight-semibold",
          "default": "600",
          "description": "Font weight `semibold`.",
          "type": "number"
        },
        {
          "name": "--ui-font-weight-bold",
          "default": "700",
          "description": "Font weight `bold`.",
          "type": "number"
        },
        {
          "name": "--ui-line-height",
          "default": "1.5",
          "description": "Body line height, unitless.",
          "type": "length"
        },
        {
          "name": "--ui-line-height-heading",
          "default": "1.25",
          "description": "Line height `heading`, unitless.",
