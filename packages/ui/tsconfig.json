{
  "extends": ["@spell-app/toolchain/tsconfig.base.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client"]
  },
  "include": ["src", "components", "test", "tools", "site/_src"],
  // `site/`:  only `site/_src` (the site bundle's entry);  the rest is pages, data and the committed bundle
  "exclude": ["site/_assets", "node_modules", "dist", "vendor", "tools/frameworks/solid/dist"]
}
