{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite.editor.config.ts",
    "vite.element.config.ts",
    "vite.runner.config.ts",
    "vitest.config.ts",
    "vite.shared.ts",
    "../../vite.decorators.ts",
    "../../vite.packageVersion.ts",
    "../../types"
  ]
}
