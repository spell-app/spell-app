{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  // The repo root's rules, plus React's.
  "extends": ["../../.oxlintrc.json", "../../.oxlintrc.react.json"],
  // MUST be listed:  without it, oxlint adds its DEFAULT plugins (e.g. `unicorn`) to the extended ones
  "plugins": ["react", "typescript", "oxc", "import"],

  // NOTE: NOT inherited from the root's.  Mirrors `.oxfmtrc.json` -- vendored, generated and scratch trees.
  "ignorePatterns": [
    "build",
    "dist",
    ".cache",
    ".venv",
    ".yarn",
    "graphify-out",
    "thoughts",
    "static",
    "projects",
    "vscode-extension/out",
    // generated by `yarn docs:update`:  minified @spell/ui bundle
    "docs/_assets/spell-ui.js"
  ]
}
