        {
          "name": "center",
          "type": "boolean",
          "description": "Center section -- a `33.3%` min-width, so left / center / right line up."
        },
        {
          "name": "right",
          "type": "boolean",
          "description": "Right-aligned section -- a `33.3%` min-width, so left / center / right line up."
        },
