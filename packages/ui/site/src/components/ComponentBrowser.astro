---
/**
 * The sidebar's Components section:  every component TAG (`ComponentIndex`, from `ComponentDefinitions`), browsable
 * A-Z or by topic, searchable, with per-user favorites.  Behaviour:  `scripts/component-browser.ts`.
 * - Rendered at BUILD time with BOTH views in the HTML;  without JS the A-Z list shows and the toolbar and stars stay
 *   hidden (they need the script).
 * - Topics view:  one native `<details>` per topic, any number open;  a tag appears under each of its topics.
 * - Favorites:  filled by the script from `localStorage`, at the top in both views.
 * - Icons:  the default `fa7-free` pack's SVGs, inlined ONCE as a sprite (`<symbol>`s) and drawn with `<use>`:  the
 *   list has ~500 stars, too many for one `<ui-icon>` element each.  The search box's icon is `<ui-input icon>`'s own.
 * - Also writes the page's component index (`ComponentPageIndex`:  tag => folder, search key) as JSON, read by the
 *   sidebar search (`scripts/component-page-index.ts`) and the browser.
 */
import starOutlineSVG from "$/ui/icons/icon-packs/fa7-free/regular/star.svg?raw"
import azSVG from "$/ui/icons/icon-packs/fa7-free/solid/arrow-down-a-z.svg?raw"
import layerGroupSVG from "$/ui/icons/icon-packs/fa7-free/solid/layer-group.svg?raw"
import starSVG from "$/ui/icons/icon-packs/fa7-free/solid/star.svg?raw"

import { ComponentIndex } from "../lib/ComponentIndex"
import ComponentBrowserRow from "./ComponentBrowserRow.astro"

type Props = {
  /** current page path, with a trailing `/` */
  here: string
}

const { here } = Astro.props
const rows = await ComponentIndex.rows()
const topics = await ComponentIndex.topics()
// `<` escaped so no tag name can close the `<script>` early
const index = JSON.stringify(await ComponentIndex.clientIndex()).replace(/</g, "\\u003c")

/** Sprite symbols:  id => the pack's SVG file. */
const ICONS: Record<string, string> = {
  "site-icon-star": starSVG,
  "site-icon-star-outline": starOutlineSVG,
  "site-icon-az": azSVG,
  "site-icon-topics": layerGroupSVG
}
const symbols = Object.entries(ICONS)
  .map(([id, svg]) => symbol(id, svg))
  .join("")

/** A pack SVG file as a `<symbol id>`:  its `viewBox` and paths, minus the licence comment (kept in the pack). */
function symbol(id: string, svg: string): string {
  const viewBox = /viewBox="([^"]+)"/.exec(svg)?.[1] ?? "0 0 512 512"
  const body = svg
    .replace(/^[\s\S]*?<svg[^>]*>/, "")
    .replace(/<\/svg>\s*$/, "")
    .replace(/<!--[\s\S]*?-->/g, "")
  return `<symbol id="${id}" viewBox="${viewBox}">${body}</symbol>`
}
---

<details class="site-sidebar-section site-browser" open data-browser>
  <summary class="site-browser-summary">
    <h2 class="site-sidebar-title ui-caption ui-text-uppercase">Components</h2>
  </summary>
  {/* inside the section, so `.site-sidebar-section + .site-sidebar-section` still spaces it */}
  <svg class="site-sprite" aria-hidden="true" set:html={symbols} />

  <div class="site-browser-tools" data-browser-tools hidden>
    <ui-input
      class="site-browser-search"
      type="search"
      icon="search"
      icon-position="left"
      size="small"
      fluid
      placeholder="Search"
      aria-label="Search components"
      autocomplete="off"
      data-browser-search></ui-input>
    <div class="site-segmented site-browser-views" role="group" aria-label="List components">
      <button type="button" class="site-segment" aria-pressed="true" title="A-Z" data-view="az">
        <svg class="site-glyph" aria-hidden="true"><use href="#site-icon-az"></use></svg>
        <span class="ui-visually-hidden-force">A-Z</span>
      </button>
      <button type="button" class="site-segment" aria-pressed="false" title="By topic" data-view="topics">
        <svg class="site-glyph" aria-hidden="true"><use href="#site-icon-topics"></use></svg>
        <span class="ui-visually-hidden-force">Topics</span>
      </button>
    </div>
  </div>
  <p class="ui-visually-hidden-force" aria-live="polite" data-browser-status></p>
  <p class="site-browser-empty ui-m-0" data-browser-empty hidden>No components match</p>

  <section class="site-browser-favorites" aria-labelledby="site-favorites-title" data-favorites hidden>
    <h3 id="site-favorites-title" class="site-browser-heading ui-caption">Favorites</h3>
    <ul class="ui-list-plain" role="list" data-favorites-list></ul>
  </section>

  <ul class="ui-list-plain" role="list" aria-label="Components A-Z" data-panel="az">
    {rows.map((row) => <ComponentBrowserRow row={row} here={here} />)}
  </ul>

  <div class="site-browser-topics" data-panel="topics" hidden>
    {
      topics.map((group) => (
        <details class="site-browser-topic" data-topic={group.topic}>
          <summary class="site-browser-topic-title">
            <span>{group.title}</span>
            <span class="site-browser-count">
              <span data-count>{group.rows.length}</span>
              <span class="ui-visually-hidden-force">components</span>
            </span>
          </summary>
          <ul class="ui-list-plain" role="list">
            {group.rows.map((row) => (
              <ComponentBrowserRow row={row} here={here} />
            ))}
          </ul>
        </details>
      ))
    }
  </div>

  <script is:inline type="application/json" id="site-component-index" set:html={index} />
</details>
