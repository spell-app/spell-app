{
  // Linting is oxlint, via Vite+ (the `lint` block of the root's `vite.config.ts`, from `vite.lint.ts`);
  // the ESLint extension is no longer used here.
  "oxc.enable": true,
  // Read ONLY the root's `vite.config.ts`, as `vp check` does (Vite+'s editor setup):  a package's own
  // `lint` / `fmt` block is for `vp lint` / `vp fmt` run in that package, and says the same.
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  // Formatting is oxfmt (the root's `vite.config.ts` `fmt` block), via the Oxc extension.
  // NOTE: MUST keep `defaultFormatter` pointed at the Oxc extension.  If it names an extension
  // that is not installed, VS Code silently falls back to another formatter -- and since
  // `.prettierrc` no longer exists, the Prettier extension would reformat with ITS defaults
  // (semicolons, 80 columns), fighting our `fmt` settings on every save.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "oxc.lint.run": "onType",
  // Match the `lint` script's `--report-unused-disable-directives`, so a stale
  // `// oxlint-disable-*` shows up in the editor rather than only failing in CI.
  "oxc.unusedDisableDirectives": "warn",
  // Pin the formatter per language as well as globally.  A per-language `editor.defaultFormatter`
  // beats any extension that also registers for that language, so a stray Prettier/ESLint install
  // cannot take over a save.  NOTE: markdown is deliberately absent -- our `fmt` settings ignore
  // `**/*.md` because `AGENTS.md` and friends are hand-wrapped prose.
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },
  "[less]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },
  "[yaml]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true },

  // Autocomplete and hover docs for every `<ui-*>` tag, attribute and value in `.html` files:  Spell UI's vocabularies
  // as VS Code HTML custom data, written by `yarn site:data` (packages/ui, `tools/ElementManifests.ts`);  the brand's
  // `<ui-brand-*>` too, by its own `yarn site:data` (packages/brand).  Every package window's FIRST folder is this repo
  // root, so this file reaches them all.
  "html.customData": [
    "./packages/ui/site/_data/html-custom-data.json",
    "./packages/brand/_data/html-custom-data.json"
  ],

  // Quick Open (Cmd+P) and Find in Files skip these;  Explorer still shows them.  Generated files (the root's
  // `.gitattributes` `linguist-generated` list), Spell UI's 2,000+ icon SVGs and visual-test screenshots, graphify's
  // output.  A window's `files.exclude` (scripts/window.mjs `filesExclude()`) keeps each file to ONE folder.
  "search.exclude": {
    "**/__snapshots__/**": true,
    "**/_assets/**": true,
    "**/_data/**": true,
    "**/graphify-out/**": true,
    "packages/ui/src/icons/**": true,
    "packages/ui/test/visual/**": true,
    "packages/ui/src/languages/spell.*": true,
    "packages/ui/src/components/ui-markdown/md.bundle.*": true,
    "packages/ui/src/components/ui-emoji/data/**": true,
    "packages/app/static/semantic-ui-css/**": true,
    "yarn.lock": true
  },

  // requires only if you use vetur plugin
  "vetur.validation.script": false,
  "js/ts.experimental.useTsgo": false
}
