---
/**
 * Live token playground for the Theming page:  inputs bound to `--ui-*` custom properties on `:root`.
 * - Writes INLINE styles on `<html>`, which beat every `@layer`, so the whole page (chrome included) follows --
 *   the point being that tokens inherit everywhere, shadow roots too.  "Reset" removes them again.
 * - A separate `.astro` component because an MDX page can't bundle a `<script>` (see `site/README.md`).
 */

/** One control. */
type Control = {
  /** custom property on `:root` */
  token: string
  /** visible label */
  label: string
  /** `range` (px) or `color` */
  type: "range" | "color"
  /** initial value:  px number for ranges, hex for colours (the input can't read OKLCH) */
  value: string
  min?: number
  max?: number
}

const controls: Control[] = [
  { token: "--ui-font-size", label: "Base font size", type: "range", value: "16", min: 12, max: 22 },
  { token: "--ui-radius", label: "Radius", type: "range", value: "4", min: 0, max: 20 },
  { token: "--ui-blue", label: "Blue (and primary)", type: "color", value: "#2d78c8" }
]
---

<div class="site-playground ui-grid ui-gap-l" style="--min-column-size: 18em" data-playground>
  <form class="ui-stack ui-gap-s" aria-label="Token controls">
    {
      controls.map((control) => (
        <label class="ui-stack ui-gap-3xs">
          <span class="ui-split">
            <code>{control.token}</code>
            <output data-output-for={control.token}>
              {control.type === "range" ? `${control.value}px` : control.value}
            </output>
          </span>
          <input
            type={control.type}
            name={control.token}
            value={control.value}
            min={control.min}
            max={control.max}
            data-token={control.token}
            data-unit={control.type === "range" ? "px" : ""}
            aria-label={control.label}
          />
        </label>
      ))
    }
    <button type="reset">Reset</button>
  </form>

  <div class="site-example-demo ui-stack ui-gap-s ui-rounded-m" aria-label="Sample">
    <p class="ui-heading ui-m-0">Heading</p>
    <p class="ui-body ui-m-0">Body text follows <code>--ui-font-size</code>, and so does everything sized in em.</p>
    <div class="ui-cluster ui-gap-xs">
      <span class="site-swatch" style="background: var(--ui-blue)" title="--ui-blue"></span>
      <span class="site-swatch" style="background: var(--ui-blue-hover)" title="--ui-blue-hover"></span>
      <span class="site-swatch" style="background: var(--ui-blue-down)" title="--ui-blue-down"></span>
      <span class="site-swatch" style="background: var(--ui-primary)" title="--ui-primary"></span>
      <span class="ui-caption">blue, -hover, -down, primary</span>
    </div>
    <p class="ui-bg-blue ui-text-blue ui-p-s ui-rounded-m ui-m-0">
      <code>ui-bg-blue ui-text-blue</code>:  roles derived from <code>--ui-blue</code>.
    </p>
    <div class="ui-blue ui-p-s ui-m-0 site-playground-remap">
      <code>ui-blue</code> remaps <code>--ui-color</code> for everything inside.
    </div>
  </div>
</div>

<script>
  /**
   * Bind every `[data-playground]` form:  `input` writes the token on `:root`, `reset` removes them all.
   * - Several playgrounds share one `:root`, which is fine:  they write the same tokens.
   */
  for (const playground of document.querySelectorAll<HTMLElement>("[data-playground]")) {
    const form = playground.querySelector("form")!
    const inputs = [...form.querySelectorAll<HTMLInputElement>("input[data-token]")]
    form.addEventListener("input", (event) => {
      const input = event.target as HTMLInputElement
      if (input.dataset.token) apply(input)
    })
    form.addEventListener("reset", () => {
      // after the browser has restored the default values
      setTimeout(() => {
        for (const input of inputs) {
          document.documentElement.style.removeProperty(input.dataset.token!)
          show(input)
        }
      })
    })

    /** Write `input`'s value to its token on `:root`, and echo it in the `<output>`. */
    function apply(input: HTMLInputElement) {
      document.documentElement.style.setProperty(input.dataset.token!, input.value + (input.dataset.unit ?? ""))
      show(input)
    }

    /** Echo `input`'s value in its `<output>`. */
    function show(input: HTMLInputElement) {
      const output = playground.querySelector(`[data-output-for="${input.dataset.token}"]`)
      if (output) output.textContent = input.value + (input.dataset.unit ?? "")
    }
  }
</script>
