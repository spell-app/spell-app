---
/**
 * One tag in the component browser (`ComponentBrowser.astro`):  its docs link and a favorite star.
 * - The same row is rendered in the A-Z list and under each of its topics;  `ComponentBrowser` (client) clones A-Z
 *   rows into Favorites, and keeps every star of a tag in step (`data-tag`).
 * - The star is plain until the script runs (hidden by CSS without `[data-ready]`):  favorites need `localStorage`.
 */
import type { ComponentRow } from "../lib/ComponentIndex"
import { url } from "../lib/nav"

type Props = {
  /** the tag */
  row: ComponentRow
  /** current page path, with a trailing `/`, to mark its main tag `aria-current` */
  here: string
}

const { row, here } = Astro.props
const href = url(row.path)
---

<li class="site-browser-row" data-tag={row.tag}>
  <a class="site-sidebar-link site-browser-link" href={href} aria-current={row.main && href === here ? "page" : undefined}>
    <span>{row.name}</span>
    {row.badge && <span class="site-badge">{row.badge}</span>}
  </a>
  <button type="button" class="site-star" aria-pressed="false" aria-label={`Add ${row.name} to favorites`} data-star>
    <svg class="site-glyph" aria-hidden="true"><use href="#site-icon-star-outline"></use></svg>
  </button>
</li>
