---
/**
 * Table of CSS custom properties:  name, default, description, plus a live swatch for colours.
 * - `tokens` is an array or its JSON text, so an MDX page can pass an imported `.json` file or a literal.
 * - The swatch reads the token LIVE (`background: var(<name>)`), so it follows the theme switcher, the
 *   Classic theme and the playground -- the table documents defaults, the swatch shows the current value.
 */

/** One row. */
type TokenRow = {
  /** custom property name, `--ui-button-padding` */
  name: string
  /** default value as written in the CSS */
  default: string
  /** what it controls */
  description?: string
  /** `color` adds a live swatch */
  type?: "color" | "length" | "number" | "other"
}

type Props = {
  /** rows, or their JSON text */
  tokens: TokenRow[] | string
  /** table caption */
  caption?: string
}

const { caption } = Astro.props
const tokens: TokenRow[] = typeof Astro.props.tokens === "string" ? JSON.parse(Astro.props.tokens) : Astro.props.tokens
---

<div class="site-table-wrap">
  <table class="site-table">
    {caption && <caption class="ui-caption ui-text-start">{caption}</caption>}
    <thead>
      <tr><th scope="col">Token</th><th scope="col">Default</th><th scope="col">Description</th></tr>
    </thead>
    <tbody>
      {
        tokens.map((token) => (
          <tr>
            <th scope="row">
              <code>{token.name}</code>
            </th>
            <td>
              <span class="ui-flex ui-align-items-center ui-gap-xs">
                {token.type === "color" && <span class="site-swatch" style={`background: var(${token.name})`} />}
                <code>{token.default}</code>
              </span>
            </td>
            <td>{token.description}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
