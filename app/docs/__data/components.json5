    {
      "id": "scheme",
      "title": "Scheme",
      "description": "Which colour scheme is in force:  `ui-invert` and style queries read it.",
      "tokens": [
        {
          "name": "--ui-scheme",
          "default": "light",
          "description": "`light` or `dark`;  follows the OS unless the page forces one.",
          "type": "other"
        }
      ]
    },
    {
      "id": "shadows",
      "title": "Shadows",
      "description": "Box shadows by role, in layers of the shadow ink.",
      "tokens": [
        {
          "name": "--ui-shadow-ink",
          "default": "light-dark(var(--ui-ink-on-light), oklch(0 0 0))",
          "description": "Colour every shadow is an alpha of.",
          "type": "color"
        },
        {
          "name": "--ui-shadow-subtle",
          "default": "0 1px 2px 0 oklch(from var(--ui-shadow-ink) l c h / 0.15)",
          "description": "Shadow `subtle`.",
          "type": "other"
        },
        {
          "name": "--ui-shadow-bottom",
          "default": "0 2px 1px -1px oklch(from var(--ui-shadow-ink) l c h / 0.15)",
          "description": "Shadow `bottom`.",
          "type": "other"
        },
        {
          "name": "--ui-shadow-raised",
          "default": "0 1px 2px 0 oklch(from var(--ui-shadow-ink) l c h / 0.08), 0 1px 3px 0 oklch(from var(--ui-shadow-ink) l c h / 0.1)",
          "description": "Shadow `raised`.",
          "type": "other"
        },
        {
          "name": "--ui-shadow-floating",
          "default": "0 2px 4px 0 oklch(from var(--ui-shadow-ink) l c h / 0.12), 0 2px 10px 0 oklch(from var(--ui-shadow-ink) l c h / 0.15)",
          "description": "Shadow `floating`.",
          "type": "other"
        },
        {
          "name": "--ui-shadow-floating-hover",
          "default": "0 2px 4px 0 oklch(from var(--ui-shadow-ink) l c h / 0.15), 0 2px 10px 0 oklch(from var(--ui-shadow-ink) l c h / 0.25)",
          "description": "Shadow `floating-hover`.",
          "type": "other"
        },
        {
          "name": "--ui-shadow-overlay",
          "default": "0 4px 8px -2px oklch(from var(--ui-shadow-ink) l c h / 0.12), 0 12px 28px -4px oklch(from var(--ui-shadow-ink) l c h / 0.22)",
          "description": "Shadow `overlay`.",
          "type": "other"
        }
      ]
    },
    {
      "id": "motion",
