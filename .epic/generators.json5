// This repo's GENERATED files, and the command that rebuilds each from the merged source (epic `epic-eject` T4).
// - Read by `epic worktree merge-main` (`MainMerge.generatorsOf()`), from the checkout being merged:
//   a branch that adds a generated file adds its line here, and its merge already knows it.
// - IN ORDER:  a later one may read an earlier one's output.
//   - The docs bundle builds UI first, whose `<ui-code>` loads the spell highlighter, so `gen:spell` comes before it.
// - Each line's keys:
//   - `outputs`:  globs, from the checkout's root
//   - `cwd`:  where `run` runs, from the checkout's root
// - Snapshots aren't here:  the merge makes one update per package, after these.
// - The same paths are `merge=binary` in the root `.gitattributes`:  keep the two in step.
// - NOT here:
//   - `pages.json5` (hand-kept)
//   - emoji data (`gen:emoji` needs a reference clone)
//   - the bundles the page server builds on demand, which aren't committed:
//     Spell UI's site and the brand pages (`spell dev bundles`)
// - A new component pack's line is added by `spell dev pack new`.
{
  "generators": [
    { "name": "yarn.lock", "outputs": ["yarn.lock"], "cwd": ".", "run": ["yarn", "install"] },
    {
      "name": "spell highlighter",
      "outputs": ["packages/ui/src/languages/spell.*"],
      "cwd": "packages/ui",
      "run": ["yarn", "gen:spell"]
    },
    {
      "name": "markdown bundle",
      "outputs": ["packages/ui/components/ui-markdown/md.bundle.*", "packages/ui/components/ui-markdown/MDBundle.ts"],
      "cwd": "packages/ui",
      "run": ["yarn", "gen:markdown"]
    },
    {
      "name": "Spell UI site data",
      "outputs": [
        "packages/ui/docs/__data/{components,icons,search}.json5",
        "packages/ui/docs/__data/{custom-elements,html-custom-data}.json"
      ],
      "cwd": "packages/ui",
      "run": ["yarn", "site:data"]
    },
    {
      "name": "docs bundle",
      "outputs": ["packages/epics/tools/_assets/spell-ui.js", "packages/epics/tools/_assets/{emoji,lazy}/**"],
      "cwd": "packages/epics",
      "run": ["node", "tools/bundle-spell-ui.js"]
    },
    {
      "name": "brand data",
      "outputs": [
        "packages/brand/docs/__data/{components,search}.json5",
        "packages/brand/docs/__data/{custom-elements,html-custom-data}.json"
      ],
      "cwd": "packages/brand",
      "run": ["yarn", "site:data"]
    },
    {
      "name": "epics pack",
      "outputs": ["packages/epics/components/__pack/**"],
      "cwd": "packages/epics",
      "run": ["yarn", "pack:build"]
    },
    {
      "name": "spell libraries",
      "outputs": ["packages/spaces/@spell/library/**/*.lib.ts"],
      "cwd": ".",
      "run": ["node", "packages/cli/bin/spell.mjs", "compile", "@spell/library"]
    },
    {
      "name": "Epic UI data",
      "outputs": ["packages/epics/docs/__data/{components,search}.json5"],
      "cwd": "packages/epics",
      "run": ["yarn", "site:data"]
    },
    {
      "name": "App UI data",
      "outputs": ["packages/app/docs/__data/{components,search}.json5"],
      "cwd": "packages/app",
      "run": ["yarn", "site:data"]
    },
    {
      "name": "spell syntax table",
      "outputs": ["packages/spell/spellSyntax.json"],
      "cwd": "packages/spell",
      "run": ["yarn", "gen:syntax"]
    },
    {
      "name": "brand pack",
      "outputs": ["packages/brand/components/__pack/**"],
      "cwd": "packages/brand",
      "run": ["yarn", "pack:build"]
    }
  ]
}
