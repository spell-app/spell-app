---
/**
 * A top-level page section, Fomantic's "Types" / "Content" / "States" / "Variations":  an `h2` with a
 * self-link, an optional lead paragraph, then the examples.
 * - The layout's "On this page" index is built from these `h2`s.
 */
import { slug } from "../lib/text"

type Props = {
  /** heading text */
  title: string
  /** anchor id;  defaults to `slug(title)` */
  id?: string
  /** lead paragraph under the heading */
  description?: string
}

const { title, id = slug(title), description } = Astro.props
---

<section class="site-section ui-stack ui-gap-l" aria-labelledby={id}>
  <h2 id={id} class="site-anchored">
    {title}<a class="site-anchor" href={`#${id}`} aria-label={`Link to ${title}`}>#</a>
  </h2>
  {description && <p class="ui-muted">{description}</p>}
  <slot />
</section>
