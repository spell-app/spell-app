{
  "name": "spell-app",
  "version": "0.8.0",
  "private": true,
  "description": "Spell's editor and its servers:  the app, spaces, the language server, the spell CLI, the page server's Spell layer, and the spell language's VS Code extension",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-app",
  "type": "module",
  "spell": {
    "commands": "./cli/commands.ts",
    "hooks": "./cli/hooks.ts"
  },
  "spellFolders": [
    {
      "name": "spaces",
      "node": true,
      "python": "src/server/py"
    },
    {
      "name": "lsp",
      "node": true
    },
    {
      "name": "app",
      "lint": [
        "src",
        "components",
        "tools",
        "scripts"
      ],
      "node": true
    },
    {
      "name": "cli",
      "lint": [
        "."
      ]
    },
    {
      "name": "page-server",
      "node": true
    }
  ],
  "exports": {
    "./app": "./app/src/index.tsx",
    "./spaces/models/projectGroups": "./spaces/src/models/projectGroups.ts",
    "./spaces/server/node/environment": "./spaces/src/server/node/environment.ts",
    "./spaces/server/node/projects/disk-fetch": "./spaces/src/server/node/projects/disk-fetch.ts",
    "./lsp": "./lsp/src/index.ts",
    "./cli": "./cli/src/index.ts",
    "./page-server": "./page-server/src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "/////// CHECKS (spell-folders:  each folder in turn, \"spellFolders\")": "",
    "ts": "spell-types --below && spell-folders ts",
    "test": "spell-folders test",
    "lint": "spell-folders lint",
    "lint:fix": "spell-folders lint:fix",
    "format": "spell-folders format",
    "format:check": "spell-folders format:check",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "test:watch": "vp test",
    "/////// THE EDITOR APP (app/)": "",
    "start": "yarn && spell server stop && cd app && spell app serve --headless",
    "stop": "cd app && node scripts/stop.mjs",
    "start:dev": "cd app && vp dev",
    "start:server": "cd app && tsx watch --import spell-kit/toolchain/aliases ../spaces/src/server/node/routes/cli.ts",
    "start:server:prod": "cd app && tsx --import spell-kit/toolchain/aliases ../spaces/src/server/node/routes/cli.ts",
    "build": "cd app && tsc && vp build",
    "build:runner": "cd app && vp build -c vite.solid.config.ts --outDir dist-runner && vp build -c vite.runner.config.ts",
    "build:element": "cd app && vp build -c vite.solid.config.ts && vp build -c vite.element.config.ts && vp build -c vite.editor.config.ts && vp build -c vite.code.config.ts",
    "build:page": "cd app && vp build -c vite.solid.config.ts --outDir dist-page && vp build -c vite.page.config.ts",
    "preview": "cd app && vp preview",
    "site:data": "cd app && tsx --import spell-kit/toolchain/aliases scripts/site-data.ts",
    "site:pictures": "cd app && tsx --import spell-kit/toolchain/aliases scripts/site-pictures.ts",
    "clean": "cd app && rm -rf ./.cache; rm -rf ./build",
    "/////// THE LANGUAGE SERVER (lsp/)": "",
    "lsp:start": "cd lsp && tsx --import spell-kit/toolchain/aliases src/server.ts --stdio",
    "lsp:scopes": "cd lsp && tsx --import spell-kit/toolchain/aliases src/scopes.ts",
    "/////// THE spell COMMAND (the kit's bin;  this repo's own commands:  cli/commands.ts)": "",
    "spell": "spell",
    "/////// REPO TOOLS (the spell command's)": "",
    "vscode": "spell app vscode",
    "vscode:build": "spell app vscode build",
    "vscode:install": "spell app vscode install",
    "epic": "epic",
    "ask": "epic ask",
    "window": "epic window",
    "server": "spell server",
    "serve": "spell server start all",
    "dev": "cd \"$INIT_CWD\" && spell run",
    "dev:ts": "cd \"$INIT_CWD\" && spell run --target ts",
    "dev:py": "cd \"$INIT_CWD\" && spell run --target py",
    "commands:check": "spell commands check"
  },
  "dependencies": {
    "@inkjs/ui": "^2",
    "@solidjs/h": "2.0.0-rc.13",
    "@solidjs/router": "2.0.0-next.35",
    "@solidjs/web": "2.0.0-rc.13",
    "chalk": "^5.6.0",
    "commander": "^14",
    "fs-extra": "^11.3.0",
    "global": "^4.3.2",
    "ink": "^5.2.1",
    "json5": "^2.2.3",
    "linkedom": "^0.18.13",
    "lodash": "^4.17.21",
    "monaco-editor": "^0.57.0",
    "node-filter-async": "^3.0.0",
    "react": "^18.2.0",
    "solid-js": "2.0.0-rc.13",
    "spell-kit": "workspace:*",
    "spell-lang": "workspace:*",
    "spell-ui": "workspace:*",
    "tsx": "4.20.3",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "wrap-ansi": "^9"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.20.4",
    "@types/react": "^18.2.56",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser-playwright": "catalog:",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4",
    "playwright": "1.63.0",
    "pyright": "1.1.414",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0",
  "pageServer": {
    "routes": [
      "page-server/src/pageServerRoutes.ts",
      "../spell-epic/src/tools/detailsRoutes.ts",
      "../spell-epic/src/tools/choicesRoutes.ts",
      "../spell-epic/src/tools/commentsRoutes.ts",
      "../spell-epic/src/tool/reviewRoutes.ts",
      "../spell-epic/src/tool/epicRoutes.ts",
      "../spell-epic/src/tool/linkRoutes.ts",
      "../spell-epic/src/list/runningRoutes.ts",
      "../spell-epic/src/tools/agentRoutes.ts",
      "../spell-epic/src/tools/showRoutes.ts",
      "../spell-epic/src/tools/airplaneRoutes.ts",
      "spaces/src/server/node/routes/appRoutes.ts"
    ],
    "watch": [
      "../spell-epic/src/tools/_assets",
      "../spell-brand",
      "../spell-epic/src/components/__pack",
      "../spell-brand/components/__pack"
    ],
    "writable": [
      "epics",
      "guides",
      "pages",
      "brand"
    ],
    "bundles": [
      "../spell-ui/site/_assets",
      "../spell-brand/_assets/ui"
    ],
    "pageScripts": [
      {
        "src": "/element/spell-language.js",
        "file": "app/dist-element/spell-language.js",
        "skip": [
          "/components/"
        ]
      }
    ],
    "componentSets": {
      "ui": {
        "name": "Spell UI",
        "dir": "../spell-ui/docs",
        "assets": "../spell-ui/site/_assets"
      },
      "epics": {
        "name": "Epic UI",
        "dir": "../spell-epic/src/docs",
        "assets": "../spell-ui/site/_assets"
      },
      "app": {
        "name": "App UI",
        "dir": "app/docs",
        "assets": "../spell-ui/site/_assets"
      },
      "brand": {
        "name": "Brand",
        "dir": "../spell-brand/docs",
        "assets": "../spell-ui/site/_assets"
      }
    },
    "siteTabs": [
      {
        "name": "Guides",
        "path": "guides/index.html",
        "areas": [
          "guides"
        ]
      },
      {
        "name": "Sagas",
        "path": "sagas/index.html",
        "areas": [
          "sagas",
          "goals"
        ]
      },
      {
        "name": "Epics",
        "path": "epics/index.html",
        "areas": [
          "epics"
        ]
      },
      {
        "name": "Epic/UI",
        "path": "/components/epics/",
        "serverOnly": true,
        "sets": [
          "epics"
        ],
        "paths": [
          "/packages/epics/docs/",
          "/spell-epic/src/docs/"
        ]
      },
      {
        "name": "Spell/UI",
        "path": "/components/ui/",
        "serverOnly": true,
        "sets": [
          "ui"
        ],
        "paths": [
          "/packages/ui/docs/",
          "/packages/ui/site/"
        ]
      },
      {
        "name": "App",
        "path": "/editor/",
        "serverOnly": true,
        "ownTab": true,
        "paths": [
          "^/editor(/|$)"
        ]
      },
      {
        "name": "App/UI",
        "path": "/components/app/",
        "serverOnly": true,
        "sets": [
          "app"
        ],
        "paths": [
          "/packages/app/docs/"
        ]
      },
      {
        "name": "Brand",
        "path": "brand/index.html",
        "areas": [
          "brand"
        ],
        "sets": [
          "brand"
        ],
        "paths": [
          "/packages/brand/docs/"
        ]
      },
      {
        "name": "Templates",
        "path": "templates/index.html",
        "areas": [
          "templates"
        ]
      }
    ],
    "engineRoutes": {
      "/_epic/assets/": "../spell-epic/src/tools/_assets",
      "/_epic/pack/": "../spell-epic/src/components/__pack",
      "/templates/": "../spell-epic/templates",
      "/packages/brand/components/__pack/": "../spell-brand/components/__pack",
      "/packages/brand/_assets/": "../spell-brand/_assets",
      "/_brand/assets/": "../spell-brand/assets"
    }
  },
  "shared": {
    "links": [
      "agents"
    ]
  }
}
