import { defineConfig } from "vite-plus"

import { fmtConfig, packageLint } from "@spell-app/toolchain/lint"

/**
 * `__pack__`'s Vite+ config:  only the `lint` / `fmt` blocks (`vp lint`, `vp fmt`), from the toolchain's settings (`@spell-app/toolchain/lint`).
 * - The pack's BUILD is Spell UI's, the same for every pack:  `spell-ui-pack build` (`yarn pack:build`,
 *   `packages/ui/tools/ComponentPack.ts`), on Spell UI's `baseConfig()`.
 * - Tests:  `vitest.config.ts` beside this.
 * - `components/__pack/` is generated:  not ours to lint (`packageLint()` leaves it out).
 */
export default defineConfig({
  fmt: fmtConfig,
  lint: packageLint({ ignorePatterns: ["dist", ".vitest"] })
})
