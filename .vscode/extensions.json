{
  "recommendations": [
    // Linting AND formatting -- replaces the ESLint + Prettier extensions.
    // Reads the `lint` / `fmt` blocks of the root's `vite.config.ts` (Vite+).
    "oxc.oxc-vscode"
  ],
  // NOTE: this project has no ESLint or Prettier config any more.  Leaving those extensions
  // enabled is actively harmful: with `.prettierrc` deleted, the Prettier extension formats
  // using its OWN defaults (semicolons, 80 columns) and fights our `fmt` settings.
  "unwantedRecommendations": ["esbenp.prettier-vscode", "dbaeumer.vscode-eslint"]
}
