## Una tarea:  algo por hacer -- en el estilo de esquema:  su nombre, luego lo que es cierto de ella
// Una vista:  cada tarea es un elemento propio en la página, `<lista-de-tareas-tarea>`.
<encanto-vista "tarea">
	<propiedad "título">texto</>
	<propiedad "nota">texto</>
	<propiedad "prioridad">una de baja, normal o alta</>
	<propiedad "hecha">sí o no</>
	<frase "está hecha">si su hecha es sí</>	// "la tarea está hecha"
	<frase "está pendiente">si su hecha es no</>	// "la tarea está pendiente"
	<propiedad "color de prioridad" descripción="el color de la etiqueta de su prioridad:  rojo cuando es alta">
		rojo si su prioridad es alta
		gris de lo contrario
	</propiedad>

	// en la página, un clic la selecciona;  mayúsculas y comando (ctrl) seleccionan más,
	// así el editor de propiedades junto a la lista las cambia todas a la vez
	<encanto>
		- se puede seleccionar
		// y arrastrar, por su asa, a otro lugar de su lista:  las seleccionadas van con ella
		- se puede arrastrar

		## dibujo:  su asa, una casilla, su título, y su prioridad -- styles.css la muestra solo cuando no es normal
		// un formulario propio, unido a ella:  marcar la casilla, o escribir un título, cambia la tarea
		// - su fila y su título son partes:  styles.css los coloca
		- para dibujarla:
			devolver <es-formulario value={eso}>
				<div part="row">
					<es-icono part="grip" name="grip vertical" aria-label="Arrastrar"/>
					<es-casilla name="hecha" aria-label="Hecha"/>
					<es-entrada part="title" name="título" aria-label="Tarea" apariencia="transparent"/>
					<es-etiqueta part="priority" tamano="diminuto" color={su color de prioridad}>{su prioridad}</es-etiqueta>
				</div>
			</es-formulario>
	</encanto>
</encanto-vista>


## Pruebas
<encanto>
	para probar las tareas
		poner la tarea a una nueva tarea con título = "Escribir las pruebas"
		la tarea está pendiente debería ser sí
		poner la hecha de la tarea a sí
		la tarea está hecha debería ser sí
</encanto>
