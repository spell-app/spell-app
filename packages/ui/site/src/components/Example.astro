---
/**
 * THE building block of the site:  one live example, Fomantic style.
 * - Renders its slot LIVE in a bordered box, and the SAME markup below it, pretty-printed and highlighted,
 *   in a collapsed "Show code" pane with a copy button.
 * - Source capture:  `Astro.slots.render("default")` gives the slot's rendered HTML (MDX has already dropped
 *   the author's whitespace), which `HtmlFormatter` re-indents -- authors write every example ONCE.
 *   - Astro annotations (`data-astro-cid-*` ...) are stripped from the shown code, not the live markup.
 *   - `code` overrides the captured source, for the rare example whose markup is built by a script.
 * - The toggle is a plain `<details>` (its label flips in CSS);  the copy button is `scripts/example.ts`,
 *   bundled once per page by Astro.
 */
import { Code } from "astro:components"

import { HtmlFormatter } from "../lib/HtmlFormatter"
import { SHIKI_THEMES } from "../lib/shiki"
import { slug } from "../lib/text"

type Props = {
  /** example heading, e.g. `Emphasis` */
  title?: string
  /** anchor id;  defaults to `slug(title)` */
  id?: string
  /** a sentence under the title:  "A button can be formatted to show different levels of emphasis" */
  description?: string
  /** heading level for `title`, default `3`;  `Variation` passes `4` when it has its own heading */
  level?: 3 | 4
  /** extra classes on the live box, e.g. `ui-cluster` to lay out several siblings */
  class?: string
  /** source to show instead of the captured slot markup */
  code?: string
  /** open the code pane initially */
  open?: boolean
}

const { title, id = title ? slug(title) : undefined, description, level = 3, class: demoClass, open } = Astro.props
const html = Astro.slots.has("default") ? await Astro.slots.render("default") : ""
const source = Astro.props.code ?? HtmlFormatter.format(html)
const Heading = `h${level}` as "h3" | "h4"
// `code` spans in the description, as in the page's prose:  escaped text, then each backtick pair => `<code>`
const describe = (text: string) =>
  text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/`([^`]+)`/g, "<code>$1</code>")
---

<article class="site-example ui-stack ui-gap-s">
  {
    (title || description) && (
      <header class="ui-stack ui-gap-2xs">
        {title && (
          <Heading id={id} class="site-example-title site-anchored">
            {title}
            <a class="site-anchor" href={`#${id}`} aria-label={`Link to ${title}`}>
              #
            </a>
          </Heading>
        )}
        {description && <p class="site-example-description ui-muted ui-m-0" set:html={describe(description)} />}
      </header>
    )
  }
  <div class="site-example-box">
    <div class:list={["site-example-demo", demoClass]} set:html={html} />
    <details class="site-example-code" open={open}>
      <summary class="ui-flex ui-align-items-center ui-gap-xs">
        <span class="site-when-closed">Show code</span><span class="site-when-open">Hide code</span>
      </summary>
      <div class="site-example-source">
        <button type="button" class="site-copy" data-copy>Copy</button>
        <Code code={source} lang="html" themes={SHIKI_THEMES} defaultColor={false} />
      </div>
    </details>
  </div>
</article>

<script>
  import "../scripts/example"
</script>
