## Deck:   US standard card deck (without jokers currently)

a deck is a list of cards

to set up a deck
	if  the is-set-up of it return
	for each rank in card ranks
		for each suit in card suits
			get a new card with rank = the rank, suit = the suit
			add it to the deck
	set the is-set-up of the deck to yes

to display a deck
	set card-names to a new list
	for each card in the deck
		add the short name of the card to card-names
	echo "deck: " + card-names

to test deck creation
	the deck is a new deck
	set up the deck
	expect the number of cards in the deck to be 52
	set up the deck
	expect the number of cards in the deck to be 52
	set the queens to the cards in the deck where the rank of the card is "queen" 
	expect the number of cards in the queens to be 4
	expect the name of the bottom card of the deck to be "king-of-spades"
	expect the short name of the top card of the deck to be "A♣️"

	echo "the deck before shuffling:"
	display the deck
	expect the first card of the deck is the ace of clubs to be yes
test deck creation

## this project's lists start at 0 (project.json):  numbers count from 0, ordinal words don't change
to test counting from zero
	the deck is a new deck
	set up the deck
	expect the name of card 0 of the deck to be "ace-of-clubs"
	expect the name of card 1 of the deck to be "ace-of-diamonds"
	expect the name of card -1 of the deck to be "king-of-spades"
	expect the name of the first card of the deck to be "ace-of-clubs"
	expect the name of the second card of the deck to be "ace-of-diamonds"
	expect the name of the last card of the deck to be "king-of-spades"
	set the ace to the first card of the deck
	expect the position of the ace in the deck to be 0
	set the aces to cards 0 to 3 of the deck
	expect the number of cards in the aces to be 4
	expect the name of the last card of the aces to be "ace-of-spades"
	set the kings to last two cards of the deck
	expect the number of cards in the kings to be 2
	expect the name of the first card of the kings to be "king-of-hearts"
	set the positions to a new list of numbers
	for each card, position in the aces
		add position to the positions
	echo "positions: " + the positions
	remove card 0 of the deck
	expect the name of the first card of the deck to be "ace-of-diamonds"
test counting from zero