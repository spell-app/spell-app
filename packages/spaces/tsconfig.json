{
  "extends": ["@spell-app/toolchain/tsconfig.base.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2020",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "@spell-app/toolchain/types"]
  },
  "include": ["src"],
  // Python's web server, a uv project:  its `.venv` holds other people's code
  "exclude": ["node_modules", "src/server/py"]
}
