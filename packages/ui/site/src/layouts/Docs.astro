---
/**
 * The one page layout, modelled on fomantic-ui.com:  top menu, left sidebar, masthead, prose column and a
 * sticky "On this page" index on the right.
 * - Works as a plain `.astro` layout (`<Docs title=...>`) and as an MDX `layout:` (reads `frontmatter`).
 * - Styles, in cascade order:
 *   1. `$/ui/styles/ui.css`:  the library's page foundation (layers, tokens, utilities, typography ...),
 *      Lightning CSS-bundled by Vite into a global `<link>`
 *   2. `site.css` as `#ui-app-stylesheet`:  the site chrome, which the runtime ALSO adopts into every
 *      component's shadow root -- see the comment on the `<link>` below
 *   3. the Classic theme, adopted at runtime when the header toggle is on
 * - Behaviour is `scripts/layout.ts`:  theme switcher, Classic toggle, mobile menu, the section index, and the
 *   sidebar's component browser (`components/ComponentBrowser.astro`, `scripts/component-browser.ts`).
 */
import "$/ui/styles/ui.css"
import siteCSSUrl from "../styles/site.css?url"
import pkg from "../../../package.json"

import ComponentBrowser from "../components/ComponentBrowser.astro"
import { HEADER_LINKS, STATUS_BADGES, sidebar, url } from "../lib/nav"

type Props = {
  /** page title, also the masthead heading */
  title?: string
  /** masthead tagline */
  summary?: string
  /** component status;  anything but `done` shows a badge */
  status?: "planned" | "in-progress" | "done"
  /** custom element tag, shown in the masthead */
  tag?: string
  /** drop the prose measure, for full-width pages (icons) */
  wide?: boolean
  /** MDX `layout:` passes the page's frontmatter here */
  frontmatter?: { title?: string; summary?: string; status?: Props["status"]; tag?: string; wide?: boolean }
}

const fm = Astro.props.frontmatter ?? {}
const title = Astro.props.title ?? fm.title ?? "@spell-app/ui"
const summary = Astro.props.summary ?? fm.summary
const status = Astro.props.status ?? fm.status
const tag = Astro.props.tag ?? fm.tag
const wide = Astro.props.wide ?? fm.wide ?? false
const badge = status ? STATUS_BADGES[status] : undefined

const sections = sidebar()
const here = Astro.url.pathname.replace(/\/?$/, "/")
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/")

/** Is `path` the current page (or, for the Components header link, any component page)? */
function isCurrent(path: string, prefix = false): boolean {
  const target = url(path).replace(/\/?$/, "/")
  return prefix && target !== base ? here.startsWith(target) : here === target
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title === "@spell-app/ui" ? title : `${title} | @spell-app/ui`}</title>
    {summary && <meta name="description" content={summary} />}
    <script is:inline>
      // Before first paint:  re-apply the saved scheme so a dark page never flashes light.  See `layout.ts`.
      try {
        const scheme = localStorage.getItem("spell-ui-site:scheme")
        if (scheme === "light" || scheme === "dark") document.documentElement.classList.add("ui-" + scheme)
      } catch {}
    </script>
    <!--
      THE app stylesheet convention:  exactly one sheet with `id="ui-app-stylesheet"`.  It styles this page
      like any stylesheet, AND the `UI` runtime mirrors it into every component's shadow root (adopted last),
      so rules in it can also reach component internals with Fomantic's class grammar, e.g.
      `.ui.primary.button { border-radius: var(--ui-radius-pill) }`.  No per-component wiring.
      Its site rules are all `.site-*` classes, so they never match anything inside a shadow root by accident.
    -->
    <link rel="stylesheet" id="ui-app-stylesheet" href={siteCSSUrl} />
  </head>
  <body class="site ui-body ui-native">
    <a class="ui-visually-hidden site-skip" href="#main">Skip to content</a>

    <header class="site-header ui-dark">
      <div class="site-header-inner ui-cluster ui-gap-l">
        <button
          type="button"
          class="site-menu-button site-button"
          aria-controls="site-sidebar"
          aria-expanded="false"
          aria-label="Menu"
          data-menu-button
        >
          <span aria-hidden="true">&#9776;</span>
        </button>
        <a class="site-logo ui-link-plain ui-bold" href={url("/")}>@spell-app/ui</a>
        <nav class="site-header-nav" aria-label="Main">
          <ul class="ui-cluster ui-gap-2xs ui-list-plain" role="list">
            {
              HEADER_LINKS.map((link) => (
                <li>
                  <a
                    class="site-header-link"
                    href={url(link.path)}
                    aria-current={isCurrent(link.path, true) ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="site-header-tools ui-cluster ui-gap-s">
          <fieldset class="site-segmented" data-scheme>
            <legend class="ui-visually-hidden-force">Colour scheme</legend>
            <label><input type="radio" name="site-scheme" value="light" />Light</label>
            <label><input type="radio" name="site-scheme" value="dark" />Dark</label>
            <label><input type="radio" name="site-scheme" value="system" checked />System</label>
          </fieldset>
          <label class="site-toggle" title="Fomantic's original look (themes/classic.css)">
            <input type="checkbox" data-classic />Classic
          </label>
          <details class="site-version">
            <summary class="site-button">v{pkg.version}</summary>
            <ul class="site-version-menu ui-list-plain" role="list">
              <li><a href={url("/")} aria-current="page">v{pkg.version} (current)</a></li>
            </ul>
          </details>
        </div>
      </div>
    </header>

    <!--
      Every page's examples load on demand:  `<ui-root>` imports the family of each `ui-*` tag inside (the site's own
      dogfood of it).  `immediately`:  the docs' text never waits for a component.
    -->
    <ui-root display="immediately">
    <div class="site-shell" data-shell>
      <nav class="site-sidebar ui-dark" id="site-sidebar" aria-label="Documentation" data-sidebar>
        {
          sections.map((section) => section.browser ? <ComponentBrowser here={here} /> : (
            <section class="site-sidebar-section">
              <h2 class="site-sidebar-title ui-caption ui-text-uppercase">{section.title}</h2>
              <ul class="ui-list-plain" role="list">
                {section.links.map((link) => (
                  <li>
                    <a
                      class="site-sidebar-link ui-split ui-gap-xs"
                      href={url(link.path)}
                      aria-current={isCurrent(link.path) ? "page" : undefined}
                    >
                      <span>{link.label}</span>
                      {link.badge && <span class="site-badge">{link.badge}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </nav>

      <main id="main" class="site-main">
        <header class="site-masthead ui-stack ui-gap-xs">
          <div class="ui-cluster ui-gap-s">
            <h1 class="site-title ui-m-0">{title}</h1>
            {tag && <code class="site-tag">{`<${tag}>`}</code>}
            {badge && <span class="site-badge">{badge}</span>}
          </div>
          {summary && <p class="site-summary ui-m-0">{summary}</p>}
        </header>
        <article class:list={["site-content", "ui-prose", { "site-wide": wide }]} data-content>
          <slot />
        </article>
      </main>

      <aside class="site-toc" aria-labelledby="site-toc-title" data-toc hidden>
        <h2 id="site-toc-title" class="site-sidebar-title ui-caption ui-text-uppercase">On this page</h2>
        <ol class="ui-list-plain" role="list" data-toc-list></ol>
      </aside>
    </div>
    </ui-root>

    <script>
      import "../scripts/layout"
    </script>
  </body>
</html>
