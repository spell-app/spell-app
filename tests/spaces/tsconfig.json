{
  // spaces' tests:  spaces' own settings (packages/spaces/tsconfig.json), over this folder
  "extends": "../../packages/spaces/tsconfig.json",
  // spaces' own ambient types too (json5-writer's)
  "include": [".", "../../packages/spaces/src/server/node/storage/json5-writer.d.ts", "../../types"],
  // Python's web server's tests are pytest's;  the test projects (`@spell/`) are spell's, their snapshots checked by
  // spell's own tests
  "exclude": ["src/server/py", "@spell"]
}
