---
/**
 * Live demo for the dropdown page's "Rich data" section:  `options` is a JS PROPERTY (never an attribute), so
 * it has to be set from a script -- MDX can't bundle one, hence this component.
 * - Also shows the `ui-change` event's `detail.value` next to the dropdown.
 */
---

<div class="ui-stack ui-gap-s" data-dropdown-demo>
  <ui-dropdown selection clearable placeholder="Pick a framework" data-options></ui-dropdown>
  <p class="ui-caption ui-m-0">Chosen:  <output data-output>nothing yet</output></p>
</div>

<script>
  import "$/ui/components/ui-dropdown"

  for (const demo of document.querySelectorAll<HTMLElement>("[data-dropdown-demo]")) {
    const dropdown = demo.querySelector<HTMLElement & { options: unknown[] }>("[data-options]")!
    const output = demo.querySelector("[data-output]")!
    dropdown.options = [
      { value: "react", text: "React" },
      { value: "vue", text: "Vue" },
      { value: "solid", text: "Solid", description: "2.0" },
      { value: "svelte", text: "Svelte", disabled: true }
    ]
    dropdown.addEventListener("ui-change", (event) => {
      const { value } = (event as CustomEvent<{ value: string | string[] }>).detail
      output.textContent = JSON.stringify(value)
    })
  }
</script>
