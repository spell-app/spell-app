{
  "extends": ["@spell-app/toolchain/tsconfig.base.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "types": ["node", "@spell-app/toolchain/types"],
    "allowJs": true,
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src"],
  // hand-written `ts/solid` output:  checked by `typecheck()`, with `@spell/core` and Solid's JSX (`typescript.test.ts`)
  "exclude": ["src/test/*.sample.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
