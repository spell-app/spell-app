---
/**
 * Live demo for the shape page's "Directions" example:  one cube, a button per way it can turn, each calling the
 * host's `flip(direction)` METHOD -- a JS call, so it needs a script, which MDX can't bundle.
 * - SIDE EFFECT:  imports the shape family (defines `<ui-shape>` / `<ui-side>`).
 */
const DIRECTIONS = ["up", "down", "left", "right", "over", "back"] as const
---

<div class="ui-stack ui-gap-s" data-shape-demo>
  <div class="ui-cluster">
    {DIRECTIONS.map((direction) => <ui-button size="small" data-direction={direction}>{`Flip ${direction}`}</ui-button>)}
  </div>
  <!-- a wrapper:  as a flex item of the stack, the shape would stretch to the full width -->
  <div>
    <ui-shape cube data-target>
      <ui-side><span>1</span></ui-side>
      <ui-side><span>2</span></ui-side>
      <ui-side><span>3</span></ui-side>
      <ui-side><span>4</span></ui-side>
    </ui-shape>
  </div>
</div>

<script>
  import "$/ui/components/ui-shape"

  for (const demo of document.querySelectorAll<HTMLElement>("[data-shape-demo]")) {
    const shape = demo.querySelector<HTMLElement & { flip(direction?: string): Promise<boolean> }>("[data-target]")!
    demo.addEventListener("click", (event) => {
      const direction = (event.target as Element).closest<HTMLElement>("[data-direction]")?.dataset.direction
      if (direction) void shape.flip(direction)
    })
  }
</script>
