{
  // spell-solid's tests:  they draw their elements on a page with Spell UI's runtime, so Spell UI's settings
  // (packages/ui/tsconfig.json) over this folder, as `tests/ui` has them
  "extends": "../../packages/ui/tsconfig.json",
  // and Spell UI's own folders, as its tsconfig includes them:  the JSX tags and Vitest types they declare reach the
  // tests;  spell-solid's source is compiled through them
  "include": [
    ".",
    "../../packages/ui/src",
    "../../packages/ui/test",
    "../../packages/ui/tools",
    "../../packages/ui/site/_src"
  ]
}
