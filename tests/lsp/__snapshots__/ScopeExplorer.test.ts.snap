exports[`ScopeExplorer > a node lists the rules its statement made 1`] = `
{
  "is a (suit)": [
    {
      "name": "is_a_$suit",
      "syntax": "{operator:is_or_is_not_a} (expression:clubs|club|diamonds|diamond|hearts|heart|spades|spade)",
    },
  ],
  "play a card": [
    {
      "name": "play",
      "syntax": "play {thisArg:expression}",
    },
  ],
}
`;

