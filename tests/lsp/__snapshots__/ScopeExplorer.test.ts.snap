exports[`ScopeExplorer > root holds the built-in types, then the project:  its files, and what each declares 1`] = `
"root Spell (built in)
  type Thing (base type)
    property id (text)
    method (a thing) belongs to one (list)
    method draw (a thing)
  type List (counts from 1)
    property id (text)
    property name (text)
    property length (number)
    property size (number)
    method (a list) can give up (a thing)
    method (a list) can take (a thing)
    method (a list) has items where
    method (a list) starts with (a thing)
    method a copy of (a list)
    method a random item of (a list)
    method add (a thing) to (a list)
    method draw (a list)
    method empty (a list)
    method for each (item) in (a list)
    method item (n) of (a list)
    method items (start) to (end) of (a list)
    method items in (a list) where
    method merge (lists)
    method move (a thing) to (a list)
    method number of (items) in (a list)
    method position of (a thing) in (a list)
    method remove (a thing) from (a list)
    method reverse (a list)
    method shuffle (a list)
  type App (is a Thing)
    method start (an app)
  type View (is a Thing)
  type Page (is a View)
  type TwoSidedView (is a View)
  type ViewableList (is a List)
    property selection (list)
  type Text
    property length (number)
    property characters (list of characters)
    method character (n) of (a text)
    method number of characters in (a text)
    method a random character of (a text)
    method (a text) as upper case
  type Date
    property year (number)
    property day (number)
  project Solitaire
    file Card.spell
      type Card (is a View)
      function test card setup
      type Joker (is a Card)
      function test jokers
    file Deck.spell
      type Deck (is a List)
      function test deck creation
      function test deck with jokers
    file Pile.spell
      type Pile (is a ViewableList)
      function test piles
    file Solitaire.spell
      type Solitaire (is a App)
      variable solitaire (Solitaire)
      type StockPile (is a Pile)
      type DiscardPile (is a Pile)
      type Foundation (is a Pile)
      type Tableau (is a Pile)
      function test the moves
    constant red
    constant black"
`;

exports[`ScopeExplorer of a project importing another, compiled > the imported project shows, with its own files and types, ahead of ours 1`] = `
"root Spell (built in)
  type Thing (base type)
    property id (text)
    method (a thing) belongs to one (list)
    method draw (a thing)
  type List (counts from 1)
    property id (text)
    property name (text)
    property length (number)
    property size (number)
    method (a list) can give up (a thing)
