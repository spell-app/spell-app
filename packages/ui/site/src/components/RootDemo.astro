---
/**
 * Live demo for the root page's "While loading" example:  replays what a `<ui-root>` shows while its components load
 * -- skeletons, or a loading message.  Components on this page are loaded already, so the demo holds the root for 2s
 * with an element that never gets ready (the root's `timeout` then shows the content, as it would after a slow load).
 * - A script, which MDX can't bundle;  `UIHost` for the held element.
 */
---

<div class="ui-stack ui-gap-s" data-root-demo>
  <div class="ui-cluster">
    <ui-button data-replay="skeleton">Replay:  skeleton</ui-button>
    <ui-button data-replay="loading">Replay:  loading message</ui-button>
  </div>
  <div data-stage>
    <ui-root display="skeleton">
      <ui-card>
        <ui-content>
          <ui-header>Report</ui-header>
          <ui-description>Every component inside was ready before this showed.</ui-description>
        </ui-content>
      </ui-card>
      <ui-button primary>Save</ui-button>
      <ui-button>Cancel</ui-button>
    </ui-root>
  </div>
</div>

<script>
  import { UIHost } from "$/ui/elements"
  import "$/ui/components/ui-root"

  /** A host whose `ready` never resolves:  holds a root in its loading state until its timeout. */
  const WAIT = "site-root-demo-wait"
  if (!customElements.get(WAIT)) customElements.define(WAIT, class extends UIHost {})

  for (const demo of document.querySelectorAll<HTMLElement>("[data-root-demo]")) {
    const stage = demo.querySelector<HTMLElement>("[data-stage]")!
    for (const button of demo.querySelectorAll<HTMLElement>("[data-replay]")) {
      button.addEventListener("click", () => {
        const old = stage.querySelector("ui-root")!
        const root = document.createElement("ui-root")
        root.setAttribute("timeout", "2s")
        if (button.dataset.replay === "loading") {
          root.setAttribute("display", "when-ready")
          root.setAttribute("loading", "Loading the report")
        }
        // the held element is expected:  no console warning for it
        root.addEventListener("ui-error", (event) => event.preventDefault())
        root.innerHTML = `<${WAIT}></${WAIT}>${old.innerHTML}`
        old.replaceWith(root)
      })
    }
  }
</script>
