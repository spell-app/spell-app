---
/**
 * Live demo for the form page's "Validation" example:  `rules` is a JS PROPERTY, so it has to be set from a
 * script -- MDX can't bundle one, hence this component.
 * - `ui-success` is cancelled so the demo never navigates;  the submitted values (or the errors) show below.
 */
---

<div class="ui-stack ui-gap-s" data-form-demo>
  <ui-form on="blur">
    <form>
      <ui-fields widths="2">
        <ui-field required>
          <label for="form-demo-name">Name</label>
          <ui-input id="form-demo-name" name="name" placeholder="Name"></ui-input>
        </ui-field>
        <ui-field required>
          <label for="form-demo-email">E-mail</label>
          <ui-input id="form-demo-email" name="email" type="email" placeholder="joe@schmoe.com"></ui-input>
        </ui-field>
      </ui-fields>
      <ui-field required>
        <label for="form-demo-password">Password</label>
        <ui-input id="form-demo-password" name="password" type="password"></ui-input>
      </ui-field>
      <ui-field>
        <ui-checkbox name="terms">I agree to the terms</ui-checkbox>
      </ui-field>
      <ui-button type="submit" primary>Sign up</ui-button>
    </form>
  </ui-form>
  <p class="ui-caption ui-m-0">Result:  <output data-output>not submitted yet</output></p>
</div>

<script>
  import "$/ui/components/form"

  for (const demo of document.querySelectorAll<HTMLElement>("[data-form-demo]")) {
    const form = demo.querySelector<HTMLElement & { rules: unknown }>("ui-form")!
    const output = demo.querySelector("[data-output]")!
    form.rules = {
      name: "notEmpty",
      email: ["notEmpty", "email"],
      password: ["notEmpty", "minLength[6]"],
      terms: "checked"
    }
    form.addEventListener("ui-success", (event) => {
      event.preventDefault()
      output.textContent = JSON.stringify((event as CustomEvent).detail.values)
    })
    form.addEventListener("ui-failure", (event) => {
      output.textContent = `${Object.keys((event as CustomEvent).detail.errors).length} field(s) need fixing`
    })
  }
</script>
