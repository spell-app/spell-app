---
/**
 * Live demo for the transition page's "Every animation" example:  picks any of Fomantic's animations and runs it
 * through the host's `transition(name)` METHOD -- a JS call, so it needs a script, which MDX can't bundle.
 * - Animation names come from the vocabulary module, so the list can't drift from what the element takes.
 * - SIDE EFFECT:  imports the transition family (defines `<ui-transition>`).
 */
import {
  TRANSITION_ATTENTION_ANIMATIONS,
  TRANSITION_VISIBILITY_ANIMATIONS
} from "$/ui/components/ui-transition/ui-transition.vocabulary.en"
---

<div class="ui-stack ui-gap-s" data-transition-demo>
  <div class="ui-cluster">
    <ui-select aria-label="Animation" value="fade up" data-animation>
      <ui-item type="header">Show / hide</ui-item>
      {TRANSITION_VISIBILITY_ANIMATIONS.map((name) => <ui-item value={name}>{name}</ui-item>)}
      <ui-item type="header">Attention</ui-item>
      {TRANSITION_ATTENTION_ANIMATIONS.map((name) => <ui-item value={name}>{name}</ui-item>)}
    </ui-select>
    <ui-button primary data-run>Run</ui-button>
  </div>
  <ui-transition inline visible duration="600" data-target>
    <ui-segment>Animate me</ui-segment>
  </ui-transition>
  <p class="ui-caption ui-m-0">A show / hide animation toggles the box;  run it again to bring it back.</p>
</div>

<script>
  import "$/ui/components/ui-transition"

  for (const demo of document.querySelectorAll<HTMLElement>("[data-transition-demo]")) {
    const select = demo.querySelector<HTMLElement & { value: string }>("[data-animation]")!
    const target = demo.querySelector<HTMLElement & { transition(name?: string): Promise<boolean> }>("[data-target]")!
    demo.querySelector("[data-run]")!.addEventListener("click", () => void target.transition(select.value))
  }
</script>
