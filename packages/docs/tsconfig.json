{
  // Only for the experiments' `.ts` files (`yarn tsx <topic>/experiments/<file>`):  the base gives them the `#`
  // aliases, e.g. `#spell/test`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["*/experiments", "../../types"],
  "exclude": ["precedence/experiments/typescript-check.ts"]
}
