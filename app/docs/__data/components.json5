        "shell"
      ],
      "aka": [],
      "description": "Left / center / right section of a menu, with optional `<Spring>` spacers between sections.",
      "noun": "Submenu",
      "attributes": [],
      "slots": [],
      "events": [],
      "parts": [],
      "states": [],
      "texts": [],
      "props": [
        {
          "name": "...UIMenuJSXAttributes",
          "type": "UIMenuJSXAttributes",
          "description": "Every prop of this type too."
        },
        {
          "name": "left",
          "type": "boolean",
          "description": "Left-aligned section -- a `33.3%` min-width, so left / center / right line up."
