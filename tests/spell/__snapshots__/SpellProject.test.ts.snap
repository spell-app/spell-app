    "compiled": "core.heading("Klondike Solitaire")
////////////////////////
// ## Klondike Solitaire
////////////////////////
//-- See [wikipedia](https://en.wikipedia.org/wiki/Klondike_(solitaire)) for its rules, and what each pile is called.
// The cards, the deck and the piles are this project's own:  Card, Deck and Pile.
// This file adds the game, its kinds of piles, what each may take or give up, and how each is laid out.
// What's where, top to bottom:
//   the solitaire:  its piles, its moves, auto play and drawing
//   playing a card:  what a click or a drag does
//   start
//   the piles:  each kind, what it may take or give up, and how it lies
//   tests

core.heading("The solitaire:  its piles, its moves, auto play and drawing")
/** the stock:  the cards not played yet, face down;  a click turns the next one over */
/*! SPELL: DECLARES {
  type: "StockPile", superType: "Pile",
  defined: "/Solitaire.spell:8690-9072",
} */
export class StockPile extends Pile {
  static elementTag = core.defineElement(this, "test-project")

  /*! SPELL: DECLARES {
    property: "layout", of: "StockPile",
    defined: "/Solitaire.spell:8725-8746",
  } */
  get layout() {
    return "stacked"
  }

  /** a click turns its card over:  none can be taken from it, so none can be dragged */
  canTake(card) {
    return false
  }

  canGiveUp(card) {
    return false
  }

  // empty:  a light grey card, face down -- a click turns the discards back over
  drawItsPlaceholder() {
    return h("div", {
      part: "placeholder",
      onClick: () => solitaire.playFromTheStock(),
      style: "cursor:pointer;user-select:none"
    }, "🂠")
  }
}

/** the discards:  where the stock's cards go as they're turned over */
/*! SPELL: DECLARES {
  type: "DiscardPile", superType: "Pile",
  defined: "/Solitaire.spell:9142-9283",
} */
export class DiscardPile extends Pile {
  static elementTag = core.defineElement(this, "test-project")

  /*! SPELL: DECLARES {
    property: "layout", of: "DiscardPile",
    defined: "/Solitaire.spell:9179-9200",
  } */
  get layout() {
    return "stacked"
  }

  canTake(card) {
    return false
  }

  canGiveUp(card) {
    return card === this.lastItem
  }
}

/** a foundation:  where a suit is built up, ace to king */
/*! SPELL: DECLARES {
  type: "Foundation", superType: "Pile",
  defined: "/Solitaire.spell:9341-9886",
} */
export class Foundation extends Pile {
  static elementTag = core.defineElement(this, "test-project")

  /*! SPELL: DECLARES {
    property: "layout", of: "Foundation",
    defined: "/Solitaire.spell:9376-9397",
  } */
  get layout() {
    return "stacked"
  }

  /*! SPELL: DECLARES {
    property: "suit", of: "Foundation", datatype: "CardSuit",
    defined: "/Solitaire.spell:9401-9426",
  } */
  // - its "suit" is a card suit
  static { this.declareProp("suit", { oneOf: () => Card.Suits }) }
  get suit() { return this.getProp("suit") }
  set suit(value) { this.setProp("suit", value) }

  canGiveUp(card) {
    return false
  }

  /** one card at a time:  the last of its pile */
  canTake(card) {
    if (card !== card.pile.lastItem) return false
    return this.suit === card.suit && this.value + 1 === card.value
  }

  // empty:  a light grey ace of its suit, face up
  drawItsPlaceholder() {
    return h("div", { part: "placeholder" },
      () => (new Card({
        rank: "ace",
        suit: this.suit,
        direction: "up"
      })).picture
    )
  }
}

/** a tableau:  a column, built down from king to ace, red and black in turn */
/*! SPELL: DECLARES {
  type: "Tableau", superType: "Pile",
  defined: "/Solitaire.spell:9964-10230",
} */
export class Tableau extends Pile {
  static elementTag = core.defineElement(this, "test-project")

  /*! SPELL: DECLARES {
    property: "layout", of: "Tableau",
    defined: "/Solitaire.spell:9996-10018",
  } */
  get layout() {
    return "vertical"
  }

  canGiveUp(card) {
    return card.isFaceDirection("up")
  }

  canTake(card) {
    if (this.isEmpty) return card.isARank("king")
    return this.color !== card.color && this.value === card.value + 1
  }
}

/** The solitaire:  its piles, its moves, auto play and drawing */
/*! SPELL: DECLARES {
  type: "Solitaire", superType: "App",
  defined: "/Solitaire.spell:633-6082",
} */
export class Solitaire extends App {
  /*! SPELL: DECLARES {
    property: "score", of: "Solitaire", datatype: "number",
    defined: "/Solitaire.spell:663-686",
  } */
  // - its "score" is a number
  static { this.declareProp("score", { type: "number" }) }
  get score() { return this.getProp("score") }
  set score(value) { this.setProp("score", value) }

  /** what the move being dragged would add to the score, e.g. " (+10)":  shown beside it, while a card is over a pile */
  /*! SPELL: DECLARES {
    property: "hint", of: "Solitaire", datatype: "text",
    defined: "/Solitaire.spell:807-825",
  } */
  // - its "hint" is text
  static { this.declareProp("hint", { type: "text" }) }
  get hint() { return this.getProp("hint") }
  set hint(value) { this.setProp("hint", value) }

  /*! SPELL: DECLARES {
    property: "deck", of: "Solitaire", datatype: "Deck",
    defined: "/Solitaire.spell:829-853",
  } */
  // - its "deck" is a new deck
  static { this.declareProp("deck", { init: () => new Deck(), early: true }) }
  get deck() { return this.getProp("deck") }
  set deck(value) { this.setProp("deck", value) }

  /** one of each pile, made with the solitaire */
  /*! SPELL: DECLARES {
    property: "stock", of: "Solitaire", datatype: "StockPile",
    defined: "/Solitaire.spell:904-955",
  } */
  // - its "stock" is a new stock pile with name = "stock"
  static { this.declareProp("stock", { init: () => new StockPile({ name: "stock" }), early: true }) }
  get stock() { return this.getProp("stock") }
  set stock(value) { this.setProp("stock", value) }

  /*! SPELL: DECLARES {
    property: "discards", of: "Solitaire", datatype: "DiscardPile",
