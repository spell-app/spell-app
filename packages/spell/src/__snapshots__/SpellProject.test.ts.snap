    property: "state", of: "Pile", datatype: "text", getter: true,
    defined: "/Pile.spell:584-748",
  } */
  get state() {
    let state = \`\${this.name || "pile"}:\`
    this.forEach((card) => {
      state = \`\${state} \${card.state}\`
    })
