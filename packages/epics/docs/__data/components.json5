    {
      "tag": "epic-page",
      "name": "epic-page",
      "folder": "epic-page",
      "mainTag": "epic-page",
      "main": true,
      "page": true,
      "href": "epic-page.html",
      "topics": [
        "page"
      ],
      "aka": [
        "epic page",
        "plan doc",
        "epic",
        "plan",
        "project plan"
      ],
      "description": "An epic page:  one epic's page -- its crumbs, header and meta lines, the Overview, then its sections in a fixed order.  Runs edge to edge:  it breaks out of the docs' `<main>` padding (`--spell-doc-pad-inline`).  With `kind=\"saga\"`, a saga page:  the saga's crumbs and header, its Overview, Epics, Questions, Todos and Log.",
      "noun": "page",
      "attributes": [
        {
          "name": "epic",
          "kind": "string",
          "description": "The epic's name:  its folder in `epics/`, and its branch's (`epic-components`).  On every epic page;  absent on a saga page (`kind=\"saga\"`), which `saga` names instead."
        },
        {
          "name": "kind",
          "kind": "string",
          "description": "What kind of page:  absent, an epic page;  `saga`, a SAGA page (epic `epic-workflow` P15), `sagas/<id>/<id>.saga.html`:  `saga` names it, its crumbs say `Docs / Sagas`, its review command is `/epic review SAGA:/<id>`, and it has no phases, branch, worktree or step label."
        },
        {
          "name": "title",
          "kind": "string",
          "property": "epicTitle",
          "description": "The epic's title (`Windows and Review`):  the page's `<title>` and the Epics list's;  not drawn on the page, whose h1 is the epic's name."
        },
        {
          "name": "branch",
          "kind": "string",
          "description": "Its git branch;  absent for a future epic."
        },
        {
          "name": "worktree",
          "kind": "string",
          "description": "Its worktree's folder, absolute;  absent for a future epic, or once the worktree is gone."
        },
        {
          "name": "started",
          "kind": "string",
          "description": "The day the epic page was made."
        },
        {
          "name": "updated",
          "kind": "string",
          "description": "The day a command last changed it."
        },
        {
          "name": "future",
          "kind": "boolean",
          "description": "A FUTURE epic (`/epic future`):  an idea written down, not planned yet;  its open questions are on `details/analysis.html`."
        },
        {
          "name": "standing",
          "kind": "boolean",
          "description": "A STANDING epic (epic `epic-workflow`):  open for good, a home that requests from other sessions keep adding phases to;  each phase merges into `main` on its own, and every phase done is NOT done."
        },
        {
          "name": "saga",
          "kind": "string",
          "description": "The saga this epic serves, by id (`drawable-spell`;  epic `epic-workflow` P15):  one of `sagas/sagas.json5`'s, set by `epic saga set`.  Drawn in the meta lines, a link to its saga page;  absent:  no saga."
        },
        {
          "name": "bedtime",
          "kind": "string",
          "description": "A `/bedtime` run is on, and what it runs (`P3-P6`):  items it changes are `recent`."
        },
        {
          "name": "recent-since",
          "kind": "string",
          "description": "Items decided, reviewed or closed since then are `recent` (green):  the commit time of `HEAD~2` in the doc's checkout.  Absent without git history."
        },
        {
          "name": "repo",
          "kind": "string",
          "description": "The repo's web address (`https://github.com/spell-app/spell-app`):  `<epic-commit>` links are made from it.  Absent:  commits show without links."
        },
        {
          "name": "reviewing",
          "kind": "boolean",
          "description": "PAGE state, never in a doc:  the page is being reviewed -- served by the page server with a token, its review inbox answering -- so items and Overview parts show their review controls, and the header Send and Review Now.  Set by them (P9, `ReviewState`);  the old runtime's `body.plan-reviewing`."
        }
      ],
      "slots": [
        {
          "name": "",
          "description": "The Overview, then the sections."
        },
        {
          "name": "durable",
          "description": "A link to the guide, once Doc Review wrote one:  `<a slot=\"durable\" href=\"../../guides/x.html\">X</a>`."
        },
        {
          "name": "toolbar",
          "description": "The sticky bar's last row:  the section toolbar the docs runtime adds to an epic page (`<nav slot=\"toolbar\" class=\"spell-toolbar\">`, `spell-doc-runtime.js` `buildToolbar()`);  never in a doc."
        }
      ],
      "events": [],
      "parts": [
        {
          "name": "base",
          "description": "The page."
        },
        {
          "name": "crumbs",
          "description": "In the h1, before the epic's name:  `Docs / Epics /`, the docs' eyebrow.  None narrow, nor while the doc still holds its old `ui-breadcrumb.spell-crumbs` before the page."
        },
        {
          "name": "header",
