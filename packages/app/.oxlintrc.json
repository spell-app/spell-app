{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  // The repo root's rules, plus React's (as when this was part of `spell`).
  "extends": ["../../.oxlintrc.json", "../../.oxlintrc.react.json"],
  // MUST be listed:  without it, oxlint adds its DEFAULT plugins (e.g. `unicorn`) to the extended ones
  "plugins": ["react", "typescript", "oxc", "import"],

  // NOTE: NOT inherited from the root's.
  "ignorePatterns": ["build", "dist", ".cache", "dist-runner", "dist-element", "static"]
}
