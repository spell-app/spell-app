          "description": "What it guards."
        },
        {
          "name": "fallback",
          "type": "(error: Error, reset: () => void) => JSX.Element",
          "description": "Error view instead of `<ErrorDisplay>`;  `reset()` re-renders the children."
        },
        {
          "name": "onError",
