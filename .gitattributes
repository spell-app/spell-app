# Generated files:  each is a function of BOTH branches' source, so a line merge of two versions is never right.
# - `linguist-generated`:  collapsed in GitHub's PR diffs ("Load diff")
# - `merge=binary`:  changed on both sides => git keeps ours, marks it conflicted, and never interleaves the two;
#   `epic worktree merge-main` then regenerates it from the merged source (its table:
#   `packages/epics/src/command/MainMerge.ts`, `GENERATORS`)
# - `-diff`:  minified;  `git diff` says "Binary files differ" instead of printing megabytes of one line
# NOT `merge=ours`:  it silently drops the other side's changes, flips meaning in a rebase, and GitHub ignores it.

# Vitest snapshots:  regenerated with `vp test run --update`, then checked against both sides
**/__snapshots__/*.snap                                       linguist-generated merge=binary

# ui:  pre-compiled spell highlighter and markdown (`yarn gen:spell`, `yarn gen:markdown`)
packages/ui/src/languages/spell.*                             linguist-generated merge=binary
packages/ui/src/languages/spell.*.bundle.js                   -diff
packages/ui/components/ui-markdown/md.bundle.*                linguist-generated merge=binary
packages/ui/components/ui-markdown/md.bundle.js               -diff
packages/ui/components/ui-markdown/MDBundle.ts                linguist-generated merge=binary

# ui:  Spell UI site data (`yarn site:data`;  `.json5` since epic `epic-workflow` P20);  `pages.json5` is hand-kept.
# Its bundle, `_assets/`, isn't committed:  the page server builds it (root `.gitignore`)
packages/ui/docs/__data/components.json5                      linguist-generated merge=binary
packages/ui/docs/__data/icons.json5                           linguist-generated merge=binary -diff
packages/ui/docs/__data/search.json5                          linguist-generated merge=binary
packages/ui/docs/__data/custom-elements.json                  linguist-generated merge=binary
packages/ui/docs/__data/html-custom-data.json                 linguist-generated merge=binary

# the component sets' data (`yarn site:data` in packages/epics and packages/app);  `pages.json5` is hand-kept
packages/epics/docs/__data/components.json5                   linguist-generated merge=binary
packages/epics/docs/__data/search.json5                       linguist-generated merge=binary
packages/app/docs/__data/components.json5                     linguist-generated merge=binary
packages/app/docs/__data/search.json5                         linguist-generated merge=binary

