    alias: ["statement", "expression"], kind: "method", name: "turn (a card) over",
    defined: "/Card.spell:2062-2174",
  } */
  async turnOver() {
    if (this.direction == 'up') { this.turnFaceDown() }
    else { this.turnFaceUp() }
