{
  "name": "spell-app",
  "private": true,
  "description": "Spell:  the parser, the spell language and its tools, and @spell-app/ui",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-app",
  "workspaces": [
    "packages/assembler",
    "packages/brand",
    "packages/cli",
    "packages/lsp",
    "packages/markdown",
    "packages/parser",
    "packages/spell",
    "packages/app",
    "packages/core",
    "packages/py",
    "packages/server",
    "packages/spaces",
    "packages/spell-solid",
    "packages/ui",
    "packages/util",
    "packages/epics"
  ],
  "type": "module",
  "scripts": {
    "ts": "vp run --fail-if-no-match -F '@spell-app/*' ts",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:packages": "vp run --fail-if-no-match -F '@spell-app/*' test",
    "review": "vp run --fail-if-no-match --concurrency-limit 1 -F '@spell-app/*' review",
    "vscode": "node packages/cli/bin/spell.mjs dev vscode",
    "vscode:build": "node packages/cli/bin/spell.mjs dev vscode build",
    "vscode:install": "node packages/cli/bin/spell.mjs dev vscode install",
    "docs:update": "node packages/cli/bin/spell.mjs dev docs update",
    "docs:index": "node packages/cli/bin/spell.mjs dev docs index",
    "docs:new": "node packages/cli/bin/spell.mjs dev docs new",
    "docs:open": "node packages/cli/bin/spell.mjs dev docs open",
    "epic": "node packages/cli/bin/epic.mjs",
    "ask": "node packages/cli/bin/epic.mjs ask",
    "plan-doc": "node packages/cli/bin/spell.mjs dev plan-doc",
    "details": "node packages/cli/bin/spell.mjs dev details",
    "docs:link": "node packages/cli/bin/spell.mjs dev docs link",
    "window": "node packages/cli/bin/spell.mjs dev window",
    "server": "node packages/cli/bin/spell.mjs dev server",
    "serve": "node packages/cli/bin/spell.mjs dev server start --all",
    "dev": "cd \"$INIT_CWD\" && node \"$PROJECT_CWD/packages/cli/bin/spell.mjs\" run",
    "dev:ts": "cd \"$INIT_CWD\" && node \"$PROJECT_CWD/packages/cli/bin/spell.mjs\" run --target ts",
    "dev:py": "cd \"$INIT_CWD\" && node \"$PROJECT_CWD/packages/cli/bin/spell.mjs\" run --target py",
    "commands:check": "node packages/cli/bin/spell.mjs dev commands check"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "playwright": "1.63.0",
    "pyright": "1.1.414",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "resolutions": {
    "@solidjs/h": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "solid-js": "2.0.0-rc.13",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "yarn@4.18.0",
  "pageServer": {
    "routes": [
      "packages/epics/tools/detailsRoutes.ts",
      "packages/epics/tools/choicesRoutes.ts",
      "packages/epics/tools/commentsRoutes.ts",
      "packages/epics/src/tool/reviewRoutes.ts",
      "packages/epics/src/tool/epicRoutes.ts",
      "packages/epics/src/tool/linkRoutes.ts",
      "packages/epics/src/list/runningRoutes.ts",
      "packages/epics/tools/agentRoutes.ts",
      "packages/epics/tools/showRoutes.ts",
      "packages/spaces/src/server/node/routes/appRoutes.ts"
    ],
    "watch": [
      "epics",
      "guides",
      "pages",
      "templates",
      "brand",
      "packages/epics/tools/_assets",
      "packages/brand",
      "packages/epics/components/__pack",
      "packages/brand/components/__pack"
    ],
    "writable": [
      "epics",
      "guides",
      "pages",
      "templates",
      "brand"
    ],
    "bundles": [
      "packages/ui/site/_assets",
      "packages/brand/_assets/ui"
    ]
  },
  "shared": {
    "dir": "../spell-app-dev",
    "links": [
      "epics",
      "guides",
      "pages",
      "templates",
      "brand",
      "ui",
      "goals",
      "sagas",
      "agents"
    ]
  }
}
