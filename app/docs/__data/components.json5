      "tag": "TypeExplorer",
      "name": "TypeExplorer",
      "folder": "TypeExplorer",
      "mainTag": "TypeExplorer",
      "main": true,
      "page": true,
      "topics": [
        "panes"
      ],
      "aka": [],
      "description": "Live scope tree a project parses in:  \"Scopes\" as a tree, and \"Details\" of the selected node beside it.",
      "noun": "TypeExplorer",
      "attributes": [],
      "slots": [],
      "events": [],
      "parts": [],
      "states": [],
      "texts": [],
      "props": [
        {
          "name": "tree",
          "type": "ScopeNode",
          "description": "Scope tree to show, if we've had one."
        },
        {
          "name": "onOpen",
          "type": "(href: string) => void",
          "required": true,
          "description": "Link clicked, e.g. `file:///…/Card.spell#L12` -- open it in the editor."
        },
        {
          "name": "onSaveDescription",
          "type": "(at: DescriptionAt, text: string) => void",
          "description": "Save `text` as the docstring at `at` -- descriptions are read-only without it."
        },
        {
          "name": "readonly",
          "type": "boolean",
          "description": "Nothing can be edited, e.g. descriptions -- ignores `onSaveDescription`."
        },
        {
          "name": "loadDetails",
          "type": "(path: string) => Promise<ScopeDetails | null>",
          "required": true,
          "description": "Details of node or member `path` of `tree` -- `null` if there are none. - e.g. the language server's `spell/scopeDetails`, or the app's in-process `LSP.ScopeExplorer.details()`."
        },
        {
          "name": "onRefresh",
          "type": "() => void",
          "description": "Ask for a fresh `tree` -- shows a Refresh button when given.  A new tree's details are fetched afresh too."
        },
        {
          "name": "state",
          "type": "TypeExplorerState",
          "description": "What to start with, as last remembered -- read once, as it mounts.  Default:  the editor's preference."
        },
        {
          "name": "onStateChange",
          "type": "(state: TypeExplorerState) => void",
          "description": "Something changed:  remember `state` -- instead of in the editor's preference."
        }
      ],
      "usedIn": [
