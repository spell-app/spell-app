{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client", "node"]
  },
  // `../../types`:  the repo's ambient globals (`Prettify` ...), used bare (WWOD §9)
  "include": ["../../types", "src", "components", "vite.config.ts", "vitest.config.ts"],
  // `pack/` is generated (`spell dev pack build epics`):  not ours to check
  "exclude": ["pack", "node_modules"]
}
