{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Spell css templates",
  "scopeName": "inline.spell.css-template",
  "comment": "Colours the inside of a css`...` template as CSS, in javascript and TypeScript files:  a drawable type's style sheet in compiled spell, `static css = css`...`` (epic drawable-thing, P10).  Injected into VS Code's own javascript and TypeScript grammars, ahead of their template rule (`L:`), outside comments and strings.",
  "injectionSelector": "L:source.js -comment -string, L:source.js.jsx -comment -string, L:source.ts -comment -string, L:source.tsx -comment -string",
  "patterns": [{ "include": "#css-template" }],
  "repository": {
    "css-template": {
      "begin": "\\b(css)\\s*(`)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.tagged-template.js" },
        "2": { "name": "string.template.js punctuation.definition.string.template.begin.js" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "string.template.js punctuation.definition.string.template.end.js" }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [{ "include": "source.css" }]
    }
  }
}
