{
  "name": "@spell-app/app",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "yarn && yarn stop && node ../cli/bin/spell.mjs serve --headless",
    "stop": "node scripts/stop.mjs",
    "start:dev": "vite",
    "start:server": "tsx watch src/server/index.ts",
    "start:server:prod": "tsx src/server/index.ts",
    "build": "tsc && vite build",
    "build:runner": "vite build -c vite.solid.config.ts --outDir dist-runner && vite build -c vite.runner.config.ts",
    "build:element": "vite build -c vite.solid.config.ts && vite build -c vite.element.config.ts && vite build -c vite.editor.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf ./.cache; rm -rf ./build",
    "/////// CORRECTNESS": "",
    "review": "yarn ts && yarn lint:fix && yarn format && yarn test && echo '== REVIEW PASSED\n===========\n'",
    "ts": "echo '>>>>>>>>>>>\n>> RUNNING TSC' && tsc && tsc -p tsconfig.node.json && echo '<< TSC PASSED\n'",
    "lint": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT' && oxlint --report-unused-disable-directives --max-warnings 0 src && echo '<< OXLINT PASSED\n'",
    "lint:fix": "echo '>>>>>>>>>>>\n>> LINTING WITH OXLINT --fix' && oxlint --fix src && echo '<< OXLINT PASSED\n'",
    "format": "echo '>>>>>>>>>>>\n>> FORMATTING WITH OXFMT' && oxfmt . && echo '<< OXFMT PASSED\n'",
    "format:check": "oxfmt --check .",
    "/////// TESTING": "",
    "test": "echo '>>>>>>>>>>>\n>> RUNNING TESTS' && vitest run && echo '<< TESTS PASSED\n'",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@nx-js/observer-util": "^4.2.2",
    "@reach/router": "^1.3.4",
    "@risingstack/react-easy-state": "^6.3.0",
    "@solidjs/web": "2.0.0-rc.13",
    "@spell-app/core": "workspace:*",
    "@spell-app/lsp": "workspace:*",
    "@spell-app/parser": "workspace:*",
    "@spell-app/server": "workspace:*",
    "@spell-app/solid-element": "workspace:*",
    "@spell-app/spell": "workspace:*",
    "@spell-app/ui": "workspace:*",
    "@spell-app/util": "workspace:*",
    "chalk": "^5.6.0",
    "classnames": "^2.2.6",
    "global": "^4.3.2",
    "json5": "^2.1.1",
    "lodash": "^4.17.21",
    "marked": "^14.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^2.1.3",
    "semantic-ui-react": "3.0.0-beta.2",
    "solid-js": "2.0.0-rc.13",
    "vscode-languageserver": "^10.1.2"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@types/lodash": "^4.17.17",
    "@types/node": "^22.20.4",
    "@types/reach__router": "^1.3.15",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.2",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright": "1.63.0",
    "tsx": "4.20.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "yarn@4.18.0"
}
