{
  "name": "spell-app",
  "private": true,
  "description": "Spell:  the parser, the spell language and its tools, and @spell-app/ui",
  "license": "MIT",
  "repository": "https://github.com/spell-app/spell-app",
  "type": "module",
  "workspaces": [
    "packages/cli",
    "packages/docs",
    "packages/lsp",
    "packages/parser",
    "packages/solid-element",
    "packages/spell",
    "packages/app",
    "packages/core",
    "packages/server",
    "packages/ui",
    "packages/util"
  ],
  "scripts": {
    "ts": "yarn workspaces foreach -A --exclude spell-app run ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packages": "yarn workspaces foreach -A --exclude spell-app run test",
    "review": "yarn workspaces foreach -A --exclude spell-app run review",
    "vscode": "yarn vscode:build && yarn vscode:install",
    "vscode:build": "cd packages/vscode && yarn install && yarn build && yarn package",
    "vscode:install": "cd packages/vscode && yarn install-extension",
    "docs:update": "yarn workspace @spell-app/docs docs:update",
    "docs:index": "yarn workspace @spell-app/docs docs:index",
    "docs:new": "yarn workspace @spell-app/docs docs:new",
    "docs:open": "yarn workspace @spell-app/docs docs:open",
    "plan-doc": "yarn workspace @spell-app/docs plan-doc",
    "details": "yarn workspace @spell-app/docs details",
    "docs:link": "yarn workspace @spell-app/docs docs:link",
    "goals": "TSX_TSCONFIG_PATH=packages/docs/tsconfig.json node --import tsx packages/docs/tools/goals/goals.js",
    "goals:test": "TSX_TSCONFIG_PATH=packages/docs/tsconfig.json node --import tsx --test packages/docs/tools/goals/goalsRoutes.test.ts",
    "window": "node scripts/window.mjs",
    "server": "yarn workspace @spell-app/server server",
    "serve": "node scripts/serve.mjs",
    "commands:check": "node packages/cli/bin/spell.mjs dev commands check"
  },
  "pageServer": {
    "routes": [
      "packages/docs/tools/goals/goalsRoutes.ts",
      "packages/docs/tools/detailsRoutes.ts",
      "packages/docs/tools/showRoutes.ts",
      "packages/app/src/server/appRoutes.ts"
    ],
    "watch": [
      "packages/docs/content",
      "packages/docs/tools/_assets"
    ]
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.2",
    "playwright": "1.63.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "solid-js": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13",
    "@solidjs/element": "2.0.0-rc.13"
  }
}
