{
  // spell-app's import-alias table (epic `repo-split` P8:  each repo has its own part of what was spell-app's one table).
  // Every package's `tsconfig.json` here extends it;  it extends the TypeScript settings every repo shares,
  // `spell-kit/toolchain`'s (spell-util's toolchain package).
  // - `$/name` is a package's barrel, `$/name/...` a file in its `src/`:  for INSIDE this repo only.
  // - A package of ANOTHER repo is imported by its npm name (`spell-ui/core`), an entry its `package.json`
  //   `exports` names;  `tsc` reads that repo's built declarations (its `exports`' `types`, epic `repo-split` I12),
  //   Vite, Vitest and `tsx` its source.
  // - MUST stay the only `paths` in the repo:  a package that sets its own `paths` REPLACES this table, never adds to it.
  // - Paths are fixed, never `${configDir}`:  `tsx` can't resolve it.
  // - From another package of this repo, import the barrel only, except these entry points:
  //   `$/spaces/models/projectGroups` (light:  registers spell's project groups, for `<spell-app>`),
  //   `$/spaces/server/node/...` (node-only:  `environment`, projects on disk in `projects/`, and the routes).
  // - The one-way rule inside this repo:  `cli` -> `app` -> `lsp` -> `spaces`;  `page-server` -> spell-server's `server`.
  "extends": "spell-kit/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      // where projects and people live:  `$/spaces` is its models, safe in a browser;  `$/spaces/server/node/...` is
      // node only (its Python web server, `src/server/py/`, is a uv project)
      "$/spaces": ["./spaces/src/index.ts"],
      "$/spaces/*": ["./spaces/src/*"],
      "$/lsp": ["./lsp/src/index.ts"],
      "$/lsp/*": ["./lsp/src/*"],
      "$/app": ["./app/src/index.tsx"],
      "$/app/*": ["./app/src/*"],
      // `<spell-app>` / `<spell-editor>` live in `app/components/`, outside `src/`, as a component pack's families do:
      // `$/app/components/*` is longer than `$/app/*`, so it wins
      "$/app/components/*": ["./app/components/*"],
      "$/cli": ["./cli/src/index.ts"],
      "$/cli/*": ["./cli/src/*"],
      "$/page-server": ["./page-server/src/index.ts"],
      "$/page-server/*": ["./page-server/src/*"]
    }
  }
}
