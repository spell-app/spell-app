import { defineConfig } from "vite-plus"

import { fmtConfig, packageLint } from "spell-kit/toolchain/lint"

/**
 * `__pack__`'s Vite+ config:  only the `lint` / `fmt` blocks (`vp lint`, `vp fmt`), from the toolchain's settings (`spell-kit/toolchain/lint`).
 * - The pack's BUILD is the kit's, the same for every pack:  `spell-pack build` (`yarn pack:build`,
 *   `spell-kit/element/tools/ComponentPack`), on the kit's `elementBaseConfig()`.
 * - Tests:  `vitest.config.ts` beside this.
 * - `components/__pack/` is generated:  not ours to lint (`packageLint()` leaves it out).
 */
export default defineConfig({
  fmt: fmtConfig,
  lint: packageLint({ ignorePatterns: ["dist", ".vitest"] })
})
