      "texts": [],
      "props": [
        {
          "name": "class",
          "type": "JSX.HTMLAttributes<HTMLDivElement>[\"class\"]",
          "required": true,
          "description": "Class names -- any form Solid's `class` takes, e.g. `[\"ScopeTreeNode\", { selected }]`."
        },
        {
          "name": "depth",
          "type": "number",
          "required": true,
          "description": "Nesting depth, for indenting."
        },
        {
          "name": "isOpen",
          "type": "boolean",
          "description": "Is it open?  `undefined` if there's nothing to open."
        },
        {
          "name": "onToggle",
          "type": "() => void",
          "required": true,
          "description": "Indent or arrow clicked."
        },
        {
          "name": "onClick",
          "type": "() => void",
          "required": true,
          "description": "Anywhere right of the arrow clicked."
        },
        {
          "name": "onElement",
          "type": "(element: HTMLDivElement) => void",
          "description": "The row's element is made -- a ref callback, e.g. to scroll it into view. - NOT `rowRef`, as React's was:  the React lint takes a `*Ref` prop for a React ref (`react(refs)`)."
        },
        {
          "name": "children",
          "type": "JSX.Element",
          "required": true,
          "description": "What's in the row."
        }
      ],
