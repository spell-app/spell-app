{
  // - `yarn ts`:  checks the vitest config and parses the scripts (`allowJs`, no `checkJs`).
  // - The experiments are NOT type-checked (they never were):  they're measurement scripts, run through `tsx`, and
  //   `content/precedence/experiments/typescript-check.ts` is MEANT to report errors.  `tsx` still reads `paths` from
  //   here, so they get the root's `$/name` aliases (e.g. `$/spell/test`).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2022",
    // ES2023 (`findLast`, `toSorted` ...):  as `epics`, whose plan-doc tool the forwarders here compile;  Node 24 has them
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    // Solid's JSX and Vite's types:  the plan-doc forwarders reach `$/epics`, whose element vocabularies and types
    // reach Spell UI's element layer (JSX, `?inline` CSS, `import.meta.glob` / `hot`)
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["node", "vite/client"]
  },
  // `../../types/app.d.ts`:  the repo's ambient helper types (`Prettify` ...), which `epics` uses bare
  "include": ["../../types/app.d.ts", "tools", "vitest.config.ts"],
  // the page assets are browser code (`spell-ui.entry.js` pulls in UI source);  the goals tools aren't type-checked;
  // `tools/vendor` is minified third-party code (Claude Design's runtime, for `check-design-bundle.js`)
  "exclude": ["tools/_assets", "tools/goals", "tools/vendor"]
}
