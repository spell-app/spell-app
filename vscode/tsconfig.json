{
  // The TypeScript settings every repo shares;  the extension imports only its own files and its own packages
  // (`vscode`, `vscode-languageclient`), never spell-app's:  it runs a checkout's language server as a process.
  "extends": "spell-kit/toolchain/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vscode"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"]
}
