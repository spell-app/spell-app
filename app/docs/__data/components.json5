      ],
      "aka": [],
      "description": "\"Details\" of scope-tree `node`:  breadcrumbs of where it is in the tree, then `<DetailsBody>`.",
      "noun": "ScopeDetailsPane",
      "attributes": [],
      "slots": [],
      "events": [],
      "parts": [],
      "states": [],
      "texts": [],
      "props": [
        {
          "name": "order",
          "type": "ScopeOrder",
          "required": true,
          "description": "Order to list `members` in."
        },
        {
          "name": "openSections",
          "type": "ReadonlySet<string>",
          "required": true,
          "description": "Names of the sections open, e.g. `Spell` -- for every node.  Kept, and remembered, by `<TypeExplorer>`."
        },
        {
          "name": "onToggleSection",
          "type": "(title: string) => void",
          "required": true,
          "description": "Open / close section `name`."
        },
        {
          "name": "onSelect",
          "type": "(node: ScopeNode) => void",
          "required": true,
          "description": "Select `node` in the tree, e.g. a breadcrumb or member clicked."
        },
        {
          "name": "onOpen",
          "type": "(href: string) => void",
          "required": true,
          "description": "Link clicked, e.g. `file:///…/Card.spell#L12` -- open it in the editor."
        },
        {
          "name": "onSaveDescription",
          "type": "(at: DescriptionAt, text: string) => void",
          "description": "Save `text` as the docstring at `at` -- descriptions are read-only without it."
        },
        {
          "name": "nodeFor",
          "type": "(path: string) => ScopeNode | undefined",
          "required": true,
          "description": "Node at `path` in the tree, if it's there -- e.g. a member's."
        },
        {
          "name": "detailsFor",
          "type": "(path: string) => ScopeDetails | null | \"loading\" | undefined",
          "required": true,
          "description": "Details of `path`:  `undefined` if not asked for yet, `\"loading\"`, or `null` if there are none. - MUST be reactive:  `<DetailsBody>` reads it in JSX and memos, and redraws when it changes."
        },
        {
          "name": "load",
          "type": "(path: string) => void",
          "required": true,
          "description": "Ask for the details of `path` -- see `detailsFor`."
        },
        {
          "name": "node",
          "type": "ScopeNode",
          "required": true,
          "description": "Node to show."
        },
        {
          "name": "trail",
          "type": "ScopeNode[]",
          "required": true,
          "description": "Nodes from the top of the tree down to `node`, for its breadcrumbs -- the root left out."
        }
      ],
