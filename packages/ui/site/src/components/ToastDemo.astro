---
/**
 * Live demo for the toast page's `UI.toast()` examples:  JS calls, so they need a script -- MDX can't bundle one.
 * - One button per call;  `data-call` picks the options below.  The actions demo shows which button was pressed.
 * - SIDE EFFECT:  imports the toast family, which registers the provider behind `UI.toast()`.
 */
---

<div class="ui-stack ui-gap-s" data-toast-demo>
  <div class="ui-cluster">
    <ui-button data-call="plain">Plain</ui-button>
    <ui-button data-call="titled">Titled, with progress</ui-button>
    <ui-button data-call="error">Error, stays until closed</ui-button>
    <ui-button data-call="actions">With actions</ui-button>
    <ui-button data-call="bottom">Bottom center</ui-button>
  </div>
  <p class="ui-caption ui-m-0">Last action:  <output data-output>none yet</output></p>
</div>

<script>
  import { UI } from "$/ui/runtime"
  import "$/ui/components/toast"

  for (const demo of document.querySelectorAll<HTMLElement>("[data-toast-demo]")) {
    const output = demo.querySelector("[data-output]")!
    demo.addEventListener("click", async (event) => {
      const call = (event.target as Element).closest<HTMLElement>("[data-call]")?.dataset.call
      if (!call) return
      await UI.load()
      if (call === "plain") UI.toast({ message: "I am a toast, nice to meet you!" })
      else if (call === "titled") UI.toast({ title: "Saved", message: "All changes are saved.", class: "success", showIcon: true, showProgress: "bottom" })
      else if (call === "error") UI.toast({ title: "Upload failed", message: "The file is too big.", class: "error", displayTime: 0, closeIcon: true })
      else if (call === "bottom") UI.toast({ message: "From the bottom.", position: "bottom center", class: "inverted" })
      else
        UI.toast({
          title: "Delete draft?",
          message: "The draft will be gone for good.",
          displayTime: 0,
          actions: [
            { text: "Delete", icon: "trash", class: "red positive", click: () => void (output.textContent = "Delete") },
            { text: "Keep", class: "deny", click: () => void (output.textContent = "Keep") }
          ]
        })
    })
  }
</script>
