---
/**
 * Live demo for the nag page's "Remembered" example:  a nag that stores its dismissal in `localStorage`, and a
 * button that forgets it -- `clear()` / `show()` are host METHODS, so they need a script, which MDX can't bundle.
 * - SIDE EFFECT:  imports the nag family;  dismissing writes `localStorage` (`site-demo-nag` + its expiry item).
 */
---

<div class="ui-stack ui-gap-s" data-nag-demo>
  <ui-nag key="site-demo-nag" storage="local" expires="7" data-target>Dismiss me, then reload:  I stay dismissed for a week.</ui-nag>
  <div class="ui-cluster">
    <ui-button data-forget>Forget the dismissal</ui-button>
    <span class="ui-caption">Dismissed:  <output data-output></output></span>
  </div>
</div>

<script>
  import "$/ui/components/ui-nag"

  for (const demo of document.querySelectorAll<HTMLElement>("[data-nag-demo]")) {
    const nag = demo.querySelector<HTMLElement & { dismissed: boolean; clear(): void; show(): boolean }>("[data-target]")!
    const output = demo.querySelector("[data-output]")!
    const update = () => void (output.textContent = nag.dismissed ? "yes" : "no")
    nag.addEventListener("ui-hide", update)
    nag.addEventListener("ui-show", update)
    demo.querySelector("[data-forget]")!.addEventListener("click", () => {
      nag.clear()
      nag.show()
      update()
    })
    void customElements.whenDefined("ui-nag").then(() => requestAnimationFrame(update))
  }
</script>
