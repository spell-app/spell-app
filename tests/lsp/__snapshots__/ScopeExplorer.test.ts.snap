exports[`ScopeExplorer > a node lists the rules its statement made 1`] = `
{
  "is a (suit)": [
    {
      "name": "is_a_$suit",
      "syntax": "{operator:is_or_is_not_a} (expression:club|diamond|heart|spade)",
    },
  ],
  "turn it over": [
    {
      "name": "turn_over",
      "syntax": "turn {thisArg:expression} over",
    },
  ],
}
`;

