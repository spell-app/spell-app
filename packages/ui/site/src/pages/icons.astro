---
/**
 * Icon browser:  every icon in the packs `@spell-app/ui` ships, searchable, click to copy the name.
 * - One switch per built-in pack:  FA7 Free (the default), FA7 Brands, Fomantic.  Each pack is loaded into its OWN
 *   `IconPacks` (`use(id, { only })`), never the page's `UI.icons`, so browsing Fomantic names doesn't change
 *   what the page's other icons mean.
 * - Exercises the pipeline for real:  names from the pack's index (`IconPack.icons()`), SVGs fetched as
 *   `<ui-icon>` fetches them, one file per icon shown.
 * - A tile's label is exactly what `name` takes (`bell`, `bell outline`, `setting`);  its other names are listed
 *   under it.  An icon whose name another entry took is labelled by its first alias.
 * - Sorted by Font Awesome file name, so an outline tile follows its solid icon (`bell`, `bell outline`).
 * - Fomantic:  one tile per Fomantic name (its `alias`es), alphabetically -- the names a ported page uses.
 * - Search also matches Font Awesome's search terms (`search.json`, docs-site-only data, keyed by FA file name, so
 *   an outline or Fomantic tile matches its solid icon's terms).
 * - Renders the first 300 matches, then "Show more" in steps of 300:  cheap enough without a virtual list.
 */
import Docs from "../layouts/Docs.astro"
---

<Docs
  title="Icons"
  summary="Every icon in the packs @spell-app/ui ships:  Font Awesome 7 Free by default, brands and Fomantic's names when a page adds them."
  wide
>
  <div class="ui-stack ui-gap-m site-icons" data-icons>
    <div class="ui-split ui-gap-s">
      <div class="site-segmented" role="group" aria-label="Icon pack" data-packs>
        <button type="button" class="site-segment" aria-pressed="true" data-pack="fa7-free">FA7 Free</button>
        <button type="button" class="site-segment" aria-pressed="false" data-pack="fa7-brands">FA7 Brands</button>
        <button type="button" class="site-segment" aria-pressed="false" data-pack="fomantic">Fomantic</button>
      </div>
      <label class="ui-flex ui-align-items-center ui-gap-xs site-icons-search">
        <span class="ui-visually-hidden-force">Search icons</span>
        <input type="search" placeholder="Search icons, e.g. arrow, mail, heart" autocomplete="off" data-search />
      </label>
    </div>
    <p class="ui-caption ui-m-0" data-usage></p>
    <p class="ui-caption ui-m-0" aria-live="polite" data-count>Loading icons...</p>
    <ul class="site-icon-grid ui-grid ui-list-plain ui-gap-xs" role="list" data-grid></ul>
    <div class="ui-flex ui-justify-content-center">
      <button type="button" data-more hidden>Show more</button>
    </div>
    <p class="ui-visually-hidden-force" aria-live="assertive" data-announce></p>
  </div>
  <p class="ui-caption">
    Icons:  <a href="https://fontawesome.com">Font Awesome 7 Free</a> (CC BY 4.0).  Names in the Fomantic pack from{" "}
    <a href="https://github.com/fomantic/Fomantic-UI">Fomantic-UI</a> (MIT).
  </p>
</Docs>

<script>
  import { IconGlyph } from "$/ui/elements/IconGlyph"
  import { IconName, type BuiltInIconPack } from "$/ui/icons"
  import type { IconPack } from "$/ui/runtime"
  import { IconPacks } from "$/ui/runtime/IconPacks"

  /** How many icons each page of results adds. */
  const PAGE_SIZE = 300

  /** What a page adds to use each pack;  the default needs nothing. */
  const USAGE: Record<BuiltInIconPack, string> = {
    "fa7-free": "The default pack:  every page has it.",
    "fa7-brands": 'Add to a page with <code>&lt;ui-root icons="fa7-brands"&gt;</code> or <code>UI.icons.use("fa7-brands")</code>.',
    fomantic:
      'Add to a page with <code>&lt;ui-root icons="fomantic"&gt;</code>;  added after the default, Fomantic\'s ' +
      "meaning wins where the two differ (<code>x</code>, <code>warning</code>)."
  }

  /**
   * State and rendering for the icon browser.
   * - `icons` is the current pack's list, `matches` the filtered one, `shown` how many are rendered.
   * - A render "generation" counter drops stale async results when the pack or query changes mid-load.
   */
  class IconBrowser {
    private pack: BuiltInIconPack = "fa7-free"
    private query = ""
    /** one private `IconPacks` per pack, created on first view */
    private readonly loaded = new Map<BuiltInIconPack, IconPacks>()
    private icons: BrowserIcon[] = []
    private matches: BrowserIcon[] = []
    private shown = 0
    private generation = 0
    /** Font Awesome search terms per solid icon, loaded on first search */
    private terms?: Record<string, string[]>

    constructor(private readonly root: HTMLElement) {}

    /** Wire the controls and render the default pack. */
    async start() {
      for (const button of this.root.querySelectorAll<HTMLButtonElement>("[data-pack]")) {
        button.addEventListener("click", () => void this.setPack(button.dataset.pack as BuiltInIconPack))
      }
      this.el<HTMLInputElement>("[data-search]").addEventListener("input", (event) => {
        this.query = (event.target as HTMLInputElement).value.trim().toLowerCase()
        void this.filter()
      })
      this.el("[data-more]").addEventListener("click", () => void this.renderMore())
      this.el("[data-grid]").addEventListener("click", (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>("[data-name]")
        if (button) void this.copy(button.dataset.name!)
      })
      await this.setPack("fa7-free")
    }

    /** Switch pack:  load its index (once), then re-filter. */
    private async setPack(pack: BuiltInIconPack) {
      this.pack = pack
      for (const button of this.root.querySelectorAll<HTMLButtonElement>("[data-pack]")) {
        button.setAttribute("aria-pressed", String(button.dataset.pack === pack))
      }
      this.el("[data-usage]").innerHTML = USAGE[pack]
      const generation = ++this.generation
      this.el("[data-count]").textContent = "Loading icons..."
      const loaded = await this.packs(pack).use(pack, { only: true })
      if (generation !== this.generation) return
      this.icons = loaded ? IconBrowser.tiles(loaded) : []
      await this.filter()
    }

    /** The private `IconPacks` for `pack`. */
    private packs(pack: BuiltInIconPack): IconPacks {
      let packs = this.loaded.get(pack)
      if (!packs) this.loaded.set(pack, (packs = new IconPacks()))
      return packs
    }

    /** Apply the search query and render the first page. */
    private async filter() {
      const query = this.query
      if (query && !this.terms) {
        this.terms = (await import("$/ui/icons/data/search.json")).default as Record<string, string[]>
      }
      const terms = this.terms
      this.matches = query
        ? this.icons.filter(
            (icon) =>
              icon.names.some((name) => name.includes(query)) ||
              terms?.[icon.file]?.some((term) => term.toLowerCase().includes(query)) === true
          )
        : this.icons
      this.el("[data-grid]").replaceChildren()
      this.shown = 0
      await this.renderMore()
    }

    /** Render the next `PAGE_SIZE` matches, fetching their SVGs first. */
    private async renderMore() {
      const generation = this.generation
      const packs = this.packs(this.pack)
      const batch = this.matches.slice(this.shown, this.shown + PAGE_SIZE)
      const svgs = await Promise.all(batch.map((icon) => packs.get(`${this.pack}:${icon.names[0]}`)))
      if (generation !== this.generation) return
      const items = batch.map((icon, index) => {
        const item = document.createElement("li")
        const button = document.createElement("button")
        const [name, ...aliases] = icon.names
        button.type = "button"
        button.className = "site-icon"
        button.dataset.name = name
        button.title = `Copy "${name}"`
        const svg = svgs[index]
        if (svg) button.append(IconGlyph.draw(svg))
        const label = document.createElement("span")
        label.textContent = name
        button.append(label)
        if (aliases.length) {
          const also = document.createElement("span")
          also.className = "site-icon-aliases"
          also.textContent = aliases.join(", ")
          button.append(also)
        }
        item.append(button)
        return item
      })
      this.el("[data-grid]").append(...items)
      this.shown += batch.length
      const more = this.el<HTMLButtonElement>("[data-more]")
      more.hidden = this.shown >= this.matches.length
      more.textContent = `Show more (${this.matches.length - this.shown} left)`
      this.el("[data-count]").textContent =
        `${this.matches.length} of ${this.icons.length} icons` +
        (this.shown < this.matches.length ? `, showing ${this.shown}` : "")
    }

    /** Copy `name` to the clipboard and announce it. */
    private async copy(name: string) {
      const announce = this.el("[data-announce]")
      try {
        await navigator.clipboard.writeText(name)
        announce.textContent = `Copied ${name}`
      } catch {
        announce.textContent = `Couldn't copy ${name}`
      }
    }

    /** The one element matching `selector` inside the browser;  MUST exist. */
    private el<T extends HTMLElement = HTMLElement>(selector: string): T {
      return this.root.querySelector<T>(selector)!
    }

    /**
     * `pack`'s tiles, sorted.
     * - Fomantic:  one per Fomantic name (an entry's `alias`es it kept), by name.
     * - Others:  one per icon a name reaches, labelled by its file name when it kept it, else its first alias;
     *   by file name, index order breaking ties (so solid `bell` before regular `bell outline`).
     */
    private static tiles(pack: IconPack): BrowserIcon[] {
      const tiles: BrowserIcon[] = []
      for (const icon of pack.icons()) {
        const file = IconName.fromKey(icon.key)
        const slug = file.replaceAll(" ", "-")
        if (pack.id === FOMANTIC) {
          const aliases = IconName.aliases(pack.index.icons[icon.key].alias)
          for (const name of icon.names) if (aliases.includes(name)) tiles.push({ names: [name], file: slug, sort: name })
        } else if (icon.names.length) {
          const names = icon.names.includes(file) ? [file, ...icon.names.filter((name) => name !== file)] : icon.names
          tiles.push({ names, file: slug, sort: file })
        }
      }
      return tiles.sort((a, b) => (a.sort < b.sort ? -1 : a.sort > b.sort ? 1 : 0))
    }
  }

  /** One tile. */
  type BrowserIcon = {
    /** every name that reaches it, the label first */
    names: string[]
    /** Font Awesome file name (`address-book`), the key into `search.json` */
    file: string
    /** sort key */
    sort: string
  }

  /** The pack whose tiles are its aliases. */
  const FOMANTIC: BuiltInIconPack = "fomantic"

  const root = document.querySelector<HTMLElement>("[data-icons]")
  if (root) void new IconBrowser(root).start()
</script>
