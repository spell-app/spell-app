---
/**
 * Live demos for the visibility page:  event logs, and `UI.observeVisibility()` -- JS, so they need a script, which
 * MDX can't bundle.
 * - `mode="element"`:  a `<ui-visibility once="false">` in the page, logging its `ui-*` events as the reader scrolls.
 * - `mode="observe"`:  `UI.observeVisibility()` on a box inside its own scroll container (`context`), logging the
 *   callbacks.  Its target is a plain `<div class="ui segment">`, NOT a `<ui-segment>`:  that host is
 *   `display: contents`, so it has no box to measure and no check ever runs.
 * - SIDE EFFECT:  imports the visibility family.
 */
type Props = {
  /** which demo */
  mode: "element" | "observe"
}

const { mode } = Astro.props
---

<div class="ui-stack ui-gap-s" data-visibility-demo={mode}>
  {
    mode === "element" ? (
      <ui-visibility once="false" data-target>
        <ui-segment>Scroll the page so I leave the screen and come back.</ui-segment>
      </ui-visibility>
    ) : (
      <div style="height: 10em; overflow: auto; border: 1px solid var(--ui-border-color)" tabindex="0" role="region" aria-label="Scroll me" data-context>
        <p style="height: 12em; margin: 0; padding: 1em">Scroll down in this box.</p>
        <div class="ui segment" data-target>The observed box</div>
        <p style="height: 16em; margin: 0" />
      </div>
    )
  }
  <p class="ui-caption ui-m-0">Log:  <output data-output>nothing yet</output></p>
</div>

<script>
  import { UI } from "$/ui/runtime"
  import "$/ui/components/visibility"

  const EVENTS = ["ui-visible", "ui-hidden", "ui-top-visible", "ui-bottom-visible", "ui-top-passed", "ui-bottom-passed", "ui-passing"]

  for (const demo of document.querySelectorAll<HTMLElement>("[data-visibility-demo]")) {
    const target = demo.querySelector<HTMLElement>("[data-target]")!
    const output = demo.querySelector("[data-output]")!
    const log: string[] = []
    const add = (name: string) => {
      log.unshift(name)
      output.textContent = log.slice(0, 5).join(" · ")
    }
    if (demo.dataset.visibilityDemo === "element") {
      for (const name of EVENTS) target.addEventListener(name, () => add(name))
    } else {
      void UI.load().then(() =>
        UI.observeVisibility(target, {
          once: false,
          context: demo.querySelector("[data-context]"),
          onTopVisible: () => add("onTopVisible"),
          onBottomVisible: () => add("onBottomVisible"),
          onTopPassed: () => add("onTopPassed"),
          onBottomPassed: () => add("onBottomPassed"),
          onTopPassedReverse: () => add("onTopPassedReverse"),
          onOffScreen: () => add("onOffScreen")
        })
      )
    }
  }
</script>
